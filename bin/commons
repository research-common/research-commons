"""commons — Research Commons CLI (v0.2a, stdlib only)

Reproducible-analysis platform for research agents: content-addressed artifact
store + manifest registry + FTS5 search + workflow runner + tiered verifier.

Artifact types: dataset skill workflow wiki bibliography report synthesis
Verification tiers: T0 bitwise · T1 tolerance · T2 judged · T3 attested
See README.md. Registry root: env COMMONS_ROOT or repo default.
"""
import argparse, calendar, copy, difflib, hashlib, json, math, os, re, shlex, shutil, sqlite3, subprocess, sys, tempfile, time
from urllib.parse import urlsplit

# ROOT = the registry/data root (relocatable via COMMONS_ROOT, e.g. for tests).
# CODE_ROOT = where this CLI and its helper libs live. These are NOT the same thing:
# lib/ ships with the code, so resolving it under a relocated data root breaks signing.
CODE_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
# Tool/data split (2026-09-25): a HUB is a data-only git repo (registry/ + store/)
# marked by a `.commons-hub` file at its root; the tool repo holds only code. Data root
# precedence: COMMONS_ROOT > nearest ancestor of cwd holding the marker > CODE_ROOT
# (legacy single-repo layout, where code and registry share one checkout).
HUB_MARKER = ".commons-hub"


def _find_hub_root(start):
    d = os.path.abspath(start)
    while True:
        if os.path.isfile(os.path.join(d, HUB_MARKER)):
            return d
        parent = os.path.dirname(d)
        if parent == d:
            return None
        d = parent


def _cwd_hub_root():
    try:
        return _find_hub_root(os.getcwd())
    except OSError:  # cwd deleted out from under us
        return None


if os.environ.get("COMMONS_ROOT"):
    ROOT, ROOT_SOURCE = os.environ["COMMONS_ROOT"], "env"
elif _cwd_hub_root():
    ROOT, ROOT_SOURCE = _cwd_hub_root(), "hub"
else:
    ROOT, ROOT_SOURCE = CODE_ROOT, "code"
REG = os.path.join(ROOT, "registry")
ART = os.path.join(REG, "artifacts")
STORE = os.path.join(ROOT, "store", "sha256")
# Legacy single-writer ledger (v0.1/v0.2): still READ, never appended to after P4.
LEDGER = os.path.join(REG, "ledger.jsonl")
# Per-peer logs: one writer each, so federation never merges concurrent appends.
LEDGER_DIR = os.path.join(REG, "ledger")
DB = os.path.join(REG, "index.sqlite")
QUARANTINE = os.path.join(REG, "quarantine.log")
ANCHOR_DIR = os.path.join(REG, "anchors")

TYPES = {"dataset": "ds", "skill": "sk", "workflow": "wf", "wiki": "wk",
         "bibliography": "bb", "report": "rp", "synthesis": "sy",
         "task": "tk", "collection": "cl", "peer-announce": "pa"}

# Types where an absent --license gets the same advisory warning a dataset already
# gets: original expressive prose/code where a licence has real legal content.
# Deliberately excludes:
#   - collection, task: editorial metadata (a pointer structure + curation prose over
#     other artifacts' hashes), not itself the kind of work the licence-defaults
#     report recommends a default for.
#   - bibliography: same shape as a collection in practice — CSL-ish citation
#     entries pointing at other artifacts/URLs (see the live bb- artifact: a
#     title/description plus `links`), not original narrative prose. No default is
#     recommended for it either; treat it like collection/task until a maintainer
#     names one explicitly.
#   - dataset: already warned above, unchanged.
#   - peer-announce: not user content at all.
LICENSE_ADVISORY_TYPES = frozenset({"report", "synthesis", "wiki", "workflow", "skill"})

# Task lifecycle (P5). Claims carry a TTL; expiry is computed lazily at read time
# rather than by a daemon, so there is no background process to trust or restart.
DEFAULT_CLAIM_TTL = "24h"
TASK_STATES = ("open", "claimed", "submitted", "accepted", "rejected", "expired")
ATTESTATION_LEVELS = ("self-reported", "receipt", "tee")

# ---- tool release version (docs/RELEASING.md; independent of SCHEMA below) ----
# Single source of truth: the VERSION file at the repo root, one line, no JSON. Resolved
# relative to this script's real path (not sys.argv[0]) so a wrapper shim that execs
# tool/bin/commons via a symlink still finds tool/VERSION, not the shim's own directory.
def _read_version():
    here = os.path.dirname(os.path.realpath(__file__))
    vfile = os.path.join(here, "..", "VERSION")
    try:
        with open(vfile) as f:
            v = f.read().strip()
        return v if v else "unknown"
    except OSError:
        return "unknown"
VERSION = _read_version()

# ---- schema (on-disk manifest/ledger format; independent of VERSION) ----
SCHEMA = "rc.v1"
SCHEMA_MAJOR = "rc"

# ---- verification tiers ----
TIERS = ("T0", "T1", "T2", "T3", "unverified")
TIER_RANK = {"T0": 0, "T1": 1, "T2": 2, "T3": 3, "unverified": 4}
TIER_NAME = {"T0": "bitwise", "T1": "tolerance", "T2": "judged",
             "T3": "attested", "unverified": "unverified"}
TIER_GUARANTEE = {
    "T0": "re-run of the recorded workflow reproduces identical bytes",
    "T1": "re-run reproduces an equivalent result under the declared comparator",
    "T2": "independent review against a rubric declared before the work was claimed",
    "T3": "signer attests a one-time observation; raw capture is published as-is",
    "unverified": "no verification guarantee is declared by the publisher",
}
DEFAULT_T3_CRITERIA = "self-attested one-time capture; no machine verification"

# ---- licensing & availability ----
# `license` and `obtainability` are DIFFERENT questions and were conflated in one
# free-text string until 2026-08-09:
#   license       — may I redistribute these bytes?
#   obtainability — can an independent peer acquire the same bytes at all?
# Only the second bears on replicability. Paywalled-but-public data is restrictively
# licensed and genuinely obtainable (a peer with their own subscription reproduces
# byte-identically); internal telemetry is neither. One string could not tell those
# apart, which is exactly the distinction a reader needs.
#
# Neither field ever moves a tier or a chain grade. Availability changes WHO CAN CHECK,
# not WHAT WAS CHECKED — the same category error as methods-carry-no-tier. It is
# disclosure, never grading arithmetic.

# Curated SPDX ids: the licences plausibly attached to code and data here. Deliberately
# not the full 600-entry SPDX list — an allowlist nobody reads is as good as free text.
# Anything genuinely absent goes through the SPDX-standard `LicenseRef-…` escape below,
# which is a documented convention rather than a typo-shaped hole.
SPDX_LICENSES = (
    # code
    "MIT", "Apache-2.0", "BSD-2-Clause", "BSD-3-Clause", "ISC", "0BSD", "Zlib",
    "MPL-2.0", "EPL-2.0", "BSL-1.0", "Unlicense",
    "GPL-2.0-only", "GPL-2.0-or-later", "GPL-3.0-only", "GPL-3.0-or-later",
    "LGPL-2.1-only", "LGPL-2.1-or-later", "LGPL-3.0-only", "LGPL-3.0-or-later",
    "AGPL-3.0-only", "AGPL-3.0-or-later",
    # data & documents
    "CC0-1.0", "CC-BY-3.0", "CC-BY-4.0", "CC-BY-SA-3.0", "CC-BY-SA-4.0",
    "CC-BY-NC-4.0", "CC-BY-ND-4.0", "CC-BY-NC-SA-4.0", "CC-BY-NC-ND-4.0",
    "ODbL-1.0", "ODC-By-1.0", "PDDL-1.0",
    "CDLA-Permissive-2.0", "CDLA-Sharing-1.0",
)
# Honest names for terms that are not an open licence at all. Saying "proprietary" out
# loud is the price of admission; the commons accepts proprietary data, it just refuses
# to let the label be vague.
NON_OPEN_LICENSES = ("proprietary", "proprietary-internal", "terms-unclear")
# SPDX ids match case-insensitively per the spec; canonicalise so `mit` stores as `MIT`
# and two manifests carrying the same licence compare equal.
_LICENSE_CANON = {v.lower(): v for v in SPDX_LICENSES + NON_OPEN_LICENSES}
# SPDX's own escape for a licence not on the list. Forces a NAME rather than prose.
LICENSE_REF_RE = re.compile(r"LicenseRef-[A-Za-z0-9.\-]+")

# Can an independent party get the same bytes? This is the field replicability reads.
OBTAINABILITY = ("open", "licensed-obtainable", "restricted")
OBTAINABILITY_MEANING = {
    "open": "freely retrievable by anyone; the blob may federate",
    "licensed-obtainable": "an independent peer can acquire the same bytes under their "
                           "own licence (requires --source)",
    "restricted": "cannot be independently acquired; replication by anyone else is "
                  "impossible in principle",
}

# link relations that carry evidence (walked by `status`)
EVIDENCE_RELS = {"cites", "derives", "supports", "refutes", "based-on"}
# Methods, not evidence: pinned verbatim by content hash and re-executed as-is,
# so they carry no verification tier of their own and never set a chain grade.
METHOD_TYPES = {"workflow", "skill"}

# Analysis templates (2026-09-21). A *method* is a category-level, instance-agnostic skill
# ("how do people here analyze a bank?"); an *instance* is one analysis that claims
# to have followed it. `applies` is deliberately NOT in EVIDENCE_RELS: a flawless
# application of a bad method is still a bad analysis, and the grade must say so
# from the data, not the procedure. Same stance as `part-of` for collections.
APPLIES_REL = "applies"
METHOD_TAG = "methodology"
CATEGORY_TAG_PREFIX = "category:"
ROLE_METHOD, ROLE_INSTANCE = "method", "instance"
# A skill bundle is an uncompressed tar whose root holds SKILL.md. Its rubric (the
# criteria instances should be judged by) lives INSIDE the tar as rubric.json so
# the `sk-` id pins it: manifest metadata is not content-addressed, and two
# publishes of one tar with different rubrics would otherwise collide on one id.
BUNDLE_RUBRIC_MEMBER = "rubric.json"
BUNDLE_MARKER_MEMBER = "SKILL.md"

# exit codes
EX_OK, EX_FAIL, EX_NOT_MACHINE_VERIFIABLE, EX_UNVERIFIED = 0, 1, 3, 4
# 5 = verification attempted outside the recorded execution environment. NOT a
# reproducibility failure: it is an unanswerable question, not a "no". Kept
# distinct so genuine FAIL (same environment, different bytes) stays loud and rare.
EX_ENV_MISMATCH = 5

# ---- execution policy (P3) ----
EXEC_POLICY = os.path.join(REG, "exec-policy.json")
# The seed ships with the CODE, not with the registry: COMMONS_ROOT can point anywhere
# (every test suite does exactly that), and a registry created outside the source tree
# would otherwise find no example and silently fall back to the hardcoded default.
# Prefer a registry-local example if one exists, so an operator can override the seed.
EXEC_POLICY_EXAMPLE_CANDIDATES = [
    os.path.join(REG, "exec-policy.example.json"),
    os.path.join(CODE_ROOT, "registry", "exec-policy.example.json"),
]
EXEC_MODES = ("native", "sandbox")
DEFAULT_EXEC = os.environ.get("COMMONS_EXEC", "native")

# ---- signing + peer registry (P2) ----
LIB = os.path.join(CODE_ROOT, "lib")
PEERS = os.path.join(REG, "peers.json")
SUBSCRIPTIONS = os.path.join(REG, "subscriptions.json")
SIGN_JS = os.path.join(LIB, "sign-message.mjs")
VERIFY_JS = os.path.join(LIB, "verify-message.mjs")
VERIFY_BATCH_JS = os.path.join(LIB, "verify-batch.mjs")
# Fields covered by a ledger signature. Order is irrelevant (canonical JSON sorts
# keys); the SET is what matters, and it must never silently change meaning.
SIGNED_FIELDS = ("action", "agent", "id", "sha256", "ts")
TRUST_LEVELS = ("full", "datasets-only", "none")


def now(): return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())


# RFC 3339 with an EXPLICIT zone. Requiring the zone is the point: a bare local
# datetime has no instant, and this value is compared against key validity windows.
_RFC3339_RE = re.compile(
    r"^(?P<dt>\d{4}-\d{2}-\d{2}[Tt]\d{2}:\d{2}:\d{2})"
    r"(?P<frac>\.\d+)?"
    r"(?P<zone>[Zz]|[+-]\d{2}:\d{2})$")

# Clock-skew allowance for "observed in the future". A few minutes covers an
# unsynced host; anything larger is policy, not drift.
OBSERVED_FUTURE_SKEW = 300


def parse_rfc3339(s):
    """RFC 3339 timestamp (Z or numeric offset) -> epoch seconds, else None.

    Distinct from parse_ts, which accepts canonical Zulu only and is the right
    strictness for machine-generated fields. This one exists for values a human
    hands in, where '-08:00' is a legitimate way to write an instant.
    """
    if not isinstance(s, str): return None
    m = _RFC3339_RE.match(s.strip())
    if not m: return None
    try:
        secs = calendar.timegm(time.strptime(m.group("dt").upper(), "%Y-%m-%dT%H:%M:%S"))
    except ValueError:
        return None
    z = m.group("zone")
    if z in ("Z", "z"): return secs
    oh, om = int(z[1:3]), int(z[4:6])
    if oh > 23 or om > 59: return None
    # local = UTC + offset, so UTC = local - offset.
    return secs - (1 if z[0] == "+" else -1) * (oh * 3600 + om * 60)


def fmt_ts(epoch):
    """Epoch seconds -> the one canonical rendering used everywhere else."""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(epoch))


def ts_cmp(a, b):
    """Order two timestamps as instants when both parse, lexicographically otherwise.

    Lexicographic order over ISO-8601 is correct only for same-format zero-padded
    Zulu. It is not an order over RFC 3339 at all: '2026-08-09T23:00:00-08:00' sorts
    below '2026-08-10T00:00:00Z' while being seven hours LATER. The fallback keeps
    hand-written legacy peer records behaving exactly as they did.
    """
    ea, eb = parse_rfc3339(a), parse_rfc3339(b)
    if ea is not None and eb is not None:
        return (ea > eb) - (ea < eb)
    return (a > b) - (a < b)


def validate_observed(value):
    """Canonicalise --observed to UTC Zulu, or exit naming the variable.

    This field is signed forever AND gates key validity (key_valid_at), so an
    unvalidated string let a revoked key attest successfully by choosing a timezone
    offset: the same instant verified VALID exit 3 as '…-08:00' and INVALID exit 1
    as Zulu. Normalising means the signed statement holds the *instant* rather than
    its rendering. Same canonicalise-or-exit contract as validate_license/--tier.
    """
    if value is None: return now()
    v = value.strip()
    if not v: return now()
    epoch = parse_rfc3339(v)
    if epoch is None:
        sys.exit("error: --observed %r is not an RFC 3339 timestamp.\n"
                 "       expected 2026-08-10T07:00:00Z, or an offset form like\n"
                 "         2026-08-09T23:00:00-08:00 (normalised to UTC before signing).\n"
                 "       Free text was accepted until 2026-08-25. It is signed\n"
                 "       permanently and decides whether the attesting key was valid,\n"
                 "       so prose here is a silent wrong answer rather than an error."
                 % value)
    if epoch > time.time() + OBSERVED_FUTURE_SKEW:
        sys.exit("error: --observed %s is in the future (now %s, %ds skew allowed).\n"
                 "       an observation cannot have been made tomorrow."
                 % (fmt_ts(epoch), now(), OBSERVED_FUTURE_SKEW))
    return fmt_ts(epoch)


def sha256_file(path):
    h = hashlib.sha256()
    with open(path, "rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            h.update(chunk)
    return h.hexdigest()


def ensure_dirs():
    for d in (ART, STORE): os.makedirs(d, exist_ok=True)


def blob_path(digest): return os.path.join(STORE, digest[:2], digest)


def legacy_blob_path(digest): return os.path.join(STORE, digest)


def blob_read_path_at(store, digest):
    """Resolve a blob in either layout, preferring the canonical shard."""
    path = os.path.join(store, digest[:2], digest)
    return path if os.path.exists(path) else os.path.join(store, digest)


def blob_read_path(digest): return blob_read_path_at(STORE, digest)


def store_blob(src):
    digest = sha256_file(src)
    dst = blob_path(digest)
    if not os.path.exists(dst):
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        tmp = dst + ".tmp.%d" % os.getpid()
        shutil.copyfile(src, tmp)
        os.replace(tmp, dst)
        os.chmod(dst, 0o444)
    return digest


def manifest_path(aid): return os.path.join(ART, aid + ".json")


def write_manifest(aid, m):
    p = manifest_path(aid)
    tmp = p + ".tmp.%d" % os.getpid()
    try:
        with open(tmp, "w") as f:
            json.dump(m, f, indent=2, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, p)
    finally:
        if os.path.exists(tmp): os.unlink(tmp)


def _guard_manifest_collision(aid, m):
    old = load_manifest(aid, missing_ok=True)
    if old is None: return
    old_hash = (old.get("content") or {}).get("sha256")
    new_hash = (m.get("content") or {}).get("sha256")
    if old_hash != new_hash:
        sys.exit("error: id %s already holds content %s, refusing to overwrite with %s "
                 "(hash-prefix collision — report this)" % (aid, old_hash, new_hash))


def publish_manifest(aid, m):
    _guard_manifest_collision(aid, m)
    p = manifest_path(aid)
    if os.path.exists(p):
        # Deliberate republish/merge (cmd_publish carries attestation, exec record,
        # and license forward): the overwrite is the point.
        write_manifest(aid, m)
        return
    # First publish: create-only. Two concurrent publishers of the same id would
    # otherwise both tmp+rename over each other (last-writer-wins on manifests that
    # differ only in timestamps — benign but untidy). os.link is atomic and fails
    # with FileExistsError, so the loser's write never lands and the winner's
    # manifest (the FIRST publisher's record) stands.
    tmp = p + ".tmp.%d" % os.getpid()
    try:
        with open(tmp, "w") as f:
            json.dump(m, f, indent=2, sort_keys=True)
            f.flush()
            os.fsync(f.fileno())
        try:
            os.link(tmp, p)
        except FileExistsError:
            _guard_manifest_collision(aid, m)  # same content => winner stands
    finally:
        if os.path.exists(tmp): os.unlink(tmp)


def check_schema(m):
    """Readers ignore unknown fields but refuse unknown major versions."""
    s = m.get("schema")
    if s is None: return  # v0.1 manifest, grandfathered
    major = str(s).split(".")[0]
    if major != SCHEMA_MAJOR:
        sys.exit("error: artifact %s declares unsupported schema %r (this build speaks %s.*)"
                 % (m.get("id", "?"), s, SCHEMA_MAJOR))


def commit_signed_publish(aid, m, entry, existed):
    """Sign, then write manifest, then ledger, then index — rolling back on failure.

    Ordering contract (TODO 2026-09-21 publish/sign bug): the signature is obtained
    BEFORE anything becomes visible, so a bad/unreadable COMMONS_SIGNING_KEY exits with
    the store untouched (a content blob may remain; it is unreferenced and reported by
    `fsck --orphans`, never by list/get/search). If the ledger write itself fails after
    a FIRST publish wrote the manifest, the manifest is removed again so there is never
    an artifact without its attribution event. The index is rebuilt last because it is
    derived state (`reindex` regenerates it).
    """
    entry = ledger_prepare(entry)
    publish_manifest(aid, m)
    try:
        ledger_commit(entry)
    except BaseException:
        if not existed:
            try:
                os.unlink(manifest_path(aid))
            except OSError:
                pass
        raise
    con = db_conn(); index_manifest(con, m); con.commit(); con.close()


def attributed_ids():
    """Artifact ids that have at least one publish/republish event in any ledger."""
    out = set()
    for e, _path, _idx, _lsha in ledger_lines():
        if e.get("action") in ("publish", "republish") and e.get("id"):
            out.add(e["id"])
    return out


def load_manifest(aid, missing_ok=False):
    p = manifest_path(aid)
    if not os.path.exists(p):
        if missing_ok: return None
        sys.exit("error: no such artifact: %s" % aid)
    with open(p) as f: m = json.load(f)
    check_schema(m)
    return m


# ---------------- signing ----------------
def canonical(obj):
    """Canonical JSON: sorted keys, no incidental whitespace. The signed bytes."""
    return json.dumps(obj, sort_keys=True, separators=(",", ":"))


def signing_payload(entry):
    """The subset of a ledger entry that a signature covers."""
    return {k: entry[k] for k in SIGNED_FIELDS if k in entry}


def signing_key_path():
    return os.environ.get("COMMONS_SIGNING_KEY")


def sign_entry(entry):
    """Sign a ledger entry. Returns (addr, sig) or (None, None) when unconfigured.

    Unsigned entries remain legal locally (single trusted host);
    they are simply marked so, and `log --verify` can tell them from forgeries.
    """
    if not signing_key_path(): return None, None
    msg = canonical(signing_payload(entry))
    env = dict(os.environ)
    try:
        # --stdin: the message goes over a pipe, never into argv (process list).
        r = subprocess.run(["node", SIGN_JS, "--stdin"], input=msg,
                           capture_output=True, text=True, timeout=60, env=env)
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit("error: cannot run the signer (%s). Is node installed?" % e)
    if r.returncode != 0:
        sys.exit("error: signing failed: %s" % (r.stderr.strip() or "unknown error"))
    try:
        out = json.loads(r.stdout)
    except ValueError:
        sys.exit("error: signer produced unparseable output")
    return out["address"], out["signature"]


# Signature verification spawns a Node process, so an uncached O(n) walk of the ledger
# is O(n) processes: a 9-entry ledger took 1.9s and lifecycle folding re-walks it per
# call. Cached by (message, sig, addr) — all immutable, so the result cannot go stale
# within a run.
_VERIFY_CACHE = {}


def verify_entry(entry, sig, addr):
    """Check a signature over a ledger entry. Returns (ok, recovered_addr)."""
    if not sig: return False, None
    msg = canonical(signing_payload(entry))
    ck = (msg, sig, (addr or "").lower())
    if ck in _VERIFY_CACHE: return _VERIFY_CACHE[ck]
    env = dict(os.environ, SIGNATURE=sig)
    if addr: env["ADDRESS"] = addr
    try:
        r = subprocess.run(["node", VERIFY_JS, "--stdin"], input=msg,
                           capture_output=True, text=True, timeout=60, env=env)
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit("error: cannot run the verifier (%s)" % e)
    try:
        out = json.loads(r.stdout or "{}")
    except ValueError:
        _VERIFY_CACHE[ck] = (False, None)
        return _VERIFY_CACHE[ck]
    res = (bool(out.get("valid")), out.get("recovered"))
    _VERIFY_CACHE[ck] = res
    return res


# ---------------- peer registry ----------------
def load_peers():
    if not os.path.exists(PEERS): return {"schema": SCHEMA, "peers": []}
    with open(PEERS) as f: d = json.load(f)
    # Tolerate the signed-comms-auth shape ({"peers": {addr: {...}}}) so one
    # registry can serve both systems.
    if isinstance(d.get("peers"), dict):
        d["peers"] = [dict(v, addr=k) for k, v in d["peers"].items()]
    elif isinstance(d.get("peers"), list) and d["peers"] and isinstance(d["peers"][0], str):
        d["peers"] = [{"addr": a} for a in d["peers"]]
    return d


def save_peers(d):
    d["schema"] = SCHEMA
    os.makedirs(REG, exist_ok=True)
    tmp = PEERS + ".tmp"
    with open(tmp, "w") as f: json.dump(d, f, indent=2, sort_keys=True)
    os.replace(tmp, PEERS)


def find_peer(addr, peers=None):
    if not addr: return None
    d = peers if peers is not None else load_peers()
    for p in d.get("peers", []):
        if (p.get("addr") or "").lower() == addr.lower(): return p
    return None


def key_valid_at(peer, ts):
    """Was this key valid when the entry claims to have been signed?

    Judging history against a key's validity *window* is what lets identities
    rotate without invalidating everything they ever signed.
    """
    if not peer: return False, "signer not in peer registry"
    vf, rv = peer.get("valid_from"), peer.get("revoked_at")
    if vf and ts and ts_cmp(ts, vf) < 0:
        return False, "signed before key valid_from (%s)" % vf
    if rv and ts and ts_cmp(ts, rv) >= 0:
        return False, "signed after key revoked_at (%s)" % rv
    if peer.get("active") is False and not rv:
        return False, "peer marked inactive"
    return True, ""


def my_ledger_path(addr):
    """This writer's own log. One file per identity = no merge contention on push."""
    os.makedirs(LEDGER_DIR, exist_ok=True)
    name = (addr or "local-unsigned").lower()
    return os.path.join(LEDGER_DIR, name + ".jsonl")


def ledger_files():
    """Every log we read: legacy first (grandfathered), then per-peer logs."""
    out = []
    if os.path.exists(LEDGER): out.append(LEDGER)
    if os.path.isdir(LEDGER_DIR):
        out += [os.path.join(LEDGER_DIR, fn) for fn in sorted(os.listdir(LEDGER_DIR))
                if fn.endswith(".jsonl")]
    return out


def ledger_prepare(entry):
    """Stamp + sign a ledger entry WITHOUT writing it. Exits on signing failure.

    Split out of ledger_append so callers that mutate the store can sign FIRST and only
    then commit: a publish whose signature fails must leave nothing visible behind
    (found 2026-09-21 — the old order committed manifest+index, then died in the
    signer, leaving an artifact with zero ledger entries). `prev` is deliberately not a
    signed field, so chaining at commit time does not invalidate the signature.
    """
    entry.setdefault("schema", SCHEMA)
    entry["ts"] = now()
    addr, sig = sign_entry(entry)
    entry["addr"] = addr
    entry["sig"] = sig
    return entry


def ledger_append(entry):
    ledger_commit(ledger_prepare(entry))


def ledger_commit(entry):
    """Chain + append an entry already signed by ledger_prepare()."""
    path = my_ledger_path(entry.get("addr"))
    # Hash-chain per writer: each line commits to the previous one in ITS OWN log,
    # so deletion/reordering is detectable and two peers appending concurrently
    # never invalidate each other's chains.
    entry["prev"] = ledger_head(path)
    with open(path, "a") as f:
        f.write(json.dumps(entry, sort_keys=True) + "\n")


def ledger_head(path=None):
    """sha256 of the last line of a log, or None when empty/absent."""
    path = path or LEDGER
    if not os.path.exists(path): return None
    last = None
    with open(path, "rb") as f:
        for line in f:
            if line.strip(): last = line.rstrip(b"\n")
    if last is None: return None
    return hashlib.sha256(last).hexdigest()


# ---------------- execution policy ----------------
# NOTE: exec-policy.json is LOCAL-ONLY (see LOCAL_ONLY). It decides which images may
# execute code on THIS machine and under what resource caps — it is trust policy in
# exactly the sense peers.json is, and a peer who could supply it would choose what
# runs on your host. It is therefore never replicated, and an incoming tree carrying
# one is refused. `exec-policy.example.json` is the tracked seed, materialized on
# first use so a fresh clone still has a policy.
IMAGE_PIN_RE = re.compile(r"^(.+)@sha256:([0-9a-fA-F]{64})$")


def parse_image_allowlist_entry(entry, source=None, index=None):
    """Return (tag, digest) for a pin, or None for a legacy plain-tag entry."""
    where = source or EXEC_POLICY
    slot = " images[%d]" % index if index is not None else " image entry"
    if not isinstance(entry, str):
        sys.exit("error: %s%s must be a string" % (where, slot))
    match = IMAGE_PIN_RE.fullmatch(entry)
    if match:
        tag, digest = match.groups()
        if not tag.strip():
            sys.exit("error: %s%s has an empty tag in digest pin %r" %
                     (where, slot, entry))
        return tag, "sha256:" + digest.lower()
    if "@sha256:" in entry:
        sys.exit("error: %s%s has malformed digest pin %r; expected "
                 "tag@sha256:<64 hex characters>" % (where, slot, entry))
    return None


def validate_exec_policy(policy, source=None):
    """Reject malformed digest pins when policy is loaded, before execution."""
    where = source or EXEC_POLICY
    if not isinstance(policy, dict):
        sys.exit("error: execution policy %s must be a JSON object" % where)
    allowed = policy.get("images", [])
    if not isinstance(allowed, list):
        sys.exit("error: execution policy %s field 'images' must be a list" % where)
    for index, entry in enumerate(allowed):
        parse_image_allowlist_entry(entry, where, index)
    return policy


def load_exec_policy():
    if not os.path.exists(EXEC_POLICY):
        for cand in EXEC_POLICY_EXAMPLE_CANDIDATES:
            if not os.path.exists(cand):
                continue
            try:
                os.makedirs(REG, exist_ok=True)
                shutil.copyfile(cand, EXEC_POLICY)
            except OSError:
                break
            else:
                with open(EXEC_POLICY) as f:
                    return validate_exec_policy(json.load(f), EXEC_POLICY)
        return validate_exec_policy(
            {"default_image": "research-commons-sandbox:base",
             "images": ["research-commons-sandbox:base"],
             "limits": {}}, "built-in execution policy")
    with open(EXEC_POLICY) as f:
        return validate_exec_policy(json.load(f), EXEC_POLICY)


def resolve_exec_mode(requested=None):
    mode = requested or DEFAULT_EXEC
    if mode not in EXEC_MODES:
        sys.exit("error: COMMONS_EXEC/--exec must be one of: " + " ".join(EXEC_MODES))
    return mode


def container_cmd():
    """Selected container CLI. Empty preserves the historical Docker default."""
    value = os.environ.get("COMMONS_CONTAINER_CMD")
    if value in (None, ""):
        return "docker"
    if value not in ("docker", "podman"):
        sys.exit("error: COMMONS_CONTAINER_CMD has unsupported value %r; "
                 "expected 'docker' or 'podman'" % value)
    return value


def _repository_name(image):
    """Strip tag/digest from an image reference without mistaking a registry port."""
    name = image.split("@", 1)[0]
    slash = name.rfind("/")
    colon = name.rfind(":")
    return name[:colon] if colon > slash else name


def _normalized_repository(name):
    for prefix in ("docker.io/library/", "index.docker.io/library/", "docker.io/"):
        if name.startswith(prefix):
            return name[len(prefix):]
    return name


def image_digest(image, require_repository=False):
    """Resolve a tag to its repository digest, or its local ID when permitted.

    Digest-pinned policy calls set require_repository: a locally built image with only
    an image ID is not evidence for a registry digest and must fail closed.
    """
    try:
        r = subprocess.run([container_cmd(), "image", "inspect", image],
                           capture_output=True, text=True, timeout=60)
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit("error: cannot inspect image %s: %s" % (image, e))
    if r.returncode != 0:
        sys.exit("error: image %s not available locally: %s" % (image, r.stderr.strip()))
    try:
        inspected = json.loads(r.stdout)[0]
    except (ValueError, IndexError, TypeError, KeyError):
        sys.exit("error: docker returned invalid inspection data for image %s" % image)

    wanted = _normalized_repository(_repository_name(image))
    matches = []
    for ref in inspected.get("RepoDigests") or []:
        if not isinstance(ref, str) or "@" not in ref:
            continue
        repo, digest = ref.rsplit("@", 1)
        if (_normalized_repository(repo) == wanted and
                re.fullmatch(r"sha256:[0-9a-fA-F]{64}", digest)):
            matches.append(digest.lower())
    if matches:
        return matches[0]
    if require_repository:
        sys.exit("error: image %s has no repository digest for %s (it may be locally "
                 "built or not pulled); digest-pinned allowlist fails closed" %
                 (image, _repository_name(image)))
    image_id = inspected.get("Id") or ""
    if not re.fullmatch(r"sha256:[0-9a-fA-F]{64}", image_id):
        sys.exit("error: image %s has neither a repository digest nor a valid image ID" % image)
    return image_id.lower()


def check_image_allowed(image, policy):
    allowed = policy.get("images", [])
    if image in allowed and parse_image_allowlist_entry(image) is None:
        return

    pins = []
    for entry in allowed:
        pin = parse_image_allowlist_entry(entry)
        if pin and pin[0] == image:
            pins.append(pin[1])
    if pins:
        try:
            actual = image_digest(image, require_repository=True)
        except SystemExit as e:
            reason = str(e)
            if reason.startswith("error: "):
                reason = reason[7:]
            sys.exit("error: digest-pinned allowlist entry for %r cannot be verified; "
                     "refusing closed.\n       %s" % (image, reason))
        if actual in pins:
            return
        sys.exit("error: image %r repository digest %s does not match its exec-policy "
                 "pin(s): %s" % (image, actual, ", ".join(pins)))

    sys.exit("error: image %r is not on the exec-policy allowlist (%s).\n"
             "       Foreign specs may not choose arbitrary images; edit %s to add one."
             % (image, ", ".join(allowed) or "none", EXEC_POLICY))

def exec_record(mode, image=None, digest=None):
    """The execution parameter that T0/T1 claims are implicitly relative to."""
    rec = {"mode": mode}
    if mode == "sandbox":
        rec["image"] = image
        if digest: rec["image_digest"] = digest
    return rec


def recorded_exec(m):
    """Execution environment recorded at creation. Pre-P3 artifacts recorded none;
    they are treated as native, which is what the host silently was back then."""
    run = ((m.get("provenance") or {}).get("run") or {})
    rec = run.get("exec")
    if not rec: return {"mode": "native", "legacy": True}
    return rec


def exec_equivalent(recorded, attempted):
    """Same execution environment? Digest is authoritative when both sandboxed."""
    if recorded.get("mode") != attempted.get("mode"):
        return False
    if recorded.get("mode") != "sandbox":
        return True
    rd, ad = recorded.get("image_digest"), attempted.get("image_digest")
    if rd and ad: return rd == ad
    return recorded.get("image") == attempted.get("image")


def fmt_exec(rec):
    if rec.get("mode") != "sandbox":
        return "native" + (" (pre-sandbox baseline)" if rec.get("legacy") else "")
    d = rec.get("image_digest") or ""
    return "sandbox %s%s" % (rec.get("image", "?"), (" @%s" % d[:19]) if d else "")


def tier_of(m):
    """Effective declared tier of a manifest (legacy = unverified)."""
    if not m: return "unverified"
    t = (m.get("verification") or {}).get("tier")
    return t if t in TIER_RANK else "unverified"


def is_observation(m):
    """A held T3 artifact: an attested one-time capture, not a derivation or a judgement."""
    return bool(m) and tier_of(m) == "T3"


def is_method(m):
    """Methods are pinned verbatim by content hash; they carry no evidence tier."""
    return bool(m) and m.get("type") in METHOD_TYPES


def tier_display(m):
    """What to show in listings: an explicit tier, else 'method' for methods."""
    if is_method(m) and not (m.get("verification") or {}).get("tier"):
        return "—"
    return tier_of(m)


def tier_label(t):
    name = TIER_NAME.get(t, "?")
    return t if name == t else "%s %s" % (t, name)


def t3_attestation_note(m):
    """Display-only suffix naming whether a T3 artifact is actually attested.

    TIER_NAME says T3 == "attested" unconditionally, which is correct as a tier NAME
    (what T3 claims to be) but overstates any specific T3 artifact that has no
    attester: `verify` already distinguishes this (`attester : NONE`), but `status`
    — the view readers actually look at for the evidence chain — printed the bare
    tier name regardless, implying a signature exists when none does (issue #23).
    Checks only whether an attester is on record, not whether that attestation is
    still valid (stale/invalid): a full crypto verify per chain node would be
    needless cost for a status rollup, and `commons verify` already owns that
    check. This label never implies more than "something is or isn't on file" and
    moves no tier, grade, or exit code.
    """
    att = (m.get("verification") or {}).get("attested_by")
    if att and att.get("addr"):
        return "attested by %s" % att["addr"]
    return "self-reported (no attester)"


# ---------------- index ----------------
def db_conn():
    con = sqlite3.connect(DB)
    con.executescript("""
      CREATE VIRTUAL TABLE IF NOT EXISTS art_fts USING fts5(
        id UNINDEXED, type, title, description, tags, agent);
      CREATE TABLE IF NOT EXISTS links(
        src TEXT, rel TEXT, dst TEXT, UNIQUE(src, rel, dst));
    """)
    return con


def manifest_count():
    """Count manifest files without opening or hashing them."""
    ensure_dirs()
    return sum(1 for entry in os.scandir(ART)
               if entry.is_file() and entry.name.endswith(".json"))


def rebuild_index():
    """Replace the derived index from manifests and return its artifact count."""
    ensure_dirs()
    if os.path.exists(DB): os.remove(DB)
    con = db_conn(); n = 0
    for fn in sorted(os.listdir(ART)):
        if not fn.endswith(".json"): continue
        with open(os.path.join(ART, fn)) as f: m = json.load(f)
        index_manifest(con, m); n += 1
    con.commit(); con.close()
    return n


def ensure_read_index():
    """Repair a missing/stale derived index before answering a read query."""
    expected = manifest_count()
    stale = not os.path.exists(DB)
    if not stale:
        con = None
        try:
            con = sqlite3.connect(DB)
            actual = con.execute("SELECT COUNT(*) FROM art_fts").fetchone()[0]
            stale = actual != expected
        except sqlite3.Error:
            stale = True
        finally:
            if con is not None: con.close()
    if stale:
        print("index missing/stale — rebuilding (%d artifacts)" % expected,
              file=sys.stderr)
        rebuild_index()


def read_index_conn():
    ensure_read_index()
    return db_conn()


def spec_search_text(m):
    """Searchable prose living in a spec blob rather than the manifest.

    Collections and tasks keep their defining text (scope, objective) INSIDE the
    content blob, because it is part of the signed, content-addressed contract. But
    a front door nobody can search is not a front door — `list --type collection`
    only helps someone who already knows collections exist. So the index (derived,
    rebuildable state) pulls that text in. Missing blobs are normal under lazy
    replication and simply contribute nothing.
    """
    if m.get("type") not in ("collection", "task"): return ""
    p = blob_read_path((m.get("content") or {}).get("sha256") or "")
    if not os.path.exists(p): return ""
    try:
        with open(p) as f: spec = json.load(f)
    except (OSError, ValueError):
        return ""
    if not isinstance(spec, dict): return ""
    parts = [spec.get("scope"), spec.get("task_criteria"), spec.get("objective")]
    parts += [q for q in (spec.get("open_questions") or []) if isinstance(q, str)]
    return " ".join(x for x in parts if isinstance(x, str) and x)


def index_manifest(con, m):
    con.execute("DELETE FROM art_fts WHERE id=?", (m["id"],))
    desc = m.get("description", "")
    extra = spec_search_text(m)
    if extra: desc = (desc + "  " if desc else "") + extra
    con.execute("INSERT INTO art_fts(id,type,title,description,tags,agent) VALUES(?,?,?,?,?,?)",
                (m["id"], m["type"], m.get("title", ""), desc,
                 " ".join(m.get("tags", [])), m.get("agent", "")))
    con.execute("DELETE FROM links WHERE src=?", (m["id"],))
    for l in m.get("links", []):
        con.execute("INSERT OR IGNORE INTO links(src,rel,dst) VALUES(?,?,?)",
                    (m["id"], l.get("rel", "related"), l["id"]))


# ---------------- verification helpers ----------------
def parse_params(pairs):
    out = {}
    for kv in pairs or []:
        k, _, v = kv.partition("=")
        if not v and "=" not in kv:
            sys.exit("error: --param must be KEY=VALUE (got %r)" % kv)
        out[k] = v
    return out


def resolve_tier(a, wf_present, atype):
    """Default: T0 with a workflow, T3 for world-acquired datasets, else unverified.

    Methods (workflow/skill) get no tier unless one is declared: they are pinned
    verbatim by content hash and re-executed as-is, so an evidence tier would be
    a category error (and would poison the chain grade of everything using them).
    """
    if getattr(a, "tier", None):
        if a.tier not in TIER_RANK:
            sys.exit("error: --tier must be one of: " + " ".join(TIERS))
        return a.tier
    if wf_present: return "T0"
    if atype in METHOD_TYPES: return None
    if atype == "dataset": return "T3"
    return "unverified"


def validate_license(value):
    """Canonicalise a licence string or exit naming the variable, as --tier does.

    Free text was one typo from meaningless: `propietary-internal` was accepted
    silently, and nothing downstream ever read the field closely enough to notice.
    The escape hatch is SPDX's own `LicenseRef-<name>` rather than arbitrary prose,
    so an unusual licence still arrives as an identifier someone can look up.
    """
    if value is None:
        return None
    v = value.strip()
    if not v:
        sys.exit("error: --license must not be empty")
    canon = _LICENSE_CANON.get(v.lower())
    if canon:
        return canon
    if LICENSE_REF_RE.fullmatch(v):
        return v
    sys.exit("error: --license %r is not a recognised identifier.\n"
             "       SPDX ids: %s\n"
             "       non-open terms: %s\n"
             "       anything else: LicenseRef-<name> (SPDX's own escape, e.g.\n"
             "         LicenseRef-VendorX-Eval-2026) — a name, not a paragraph.\n"
             "       Free text was accepted until 2026-08-09; a misspelt licence read\n"
             "       as a real one, which is a silent wrong answer rather than an error."
             % (v, ", ".join(SPDX_LICENSES), ", ".join(NON_OPEN_LICENSES)))


def validate_obtainability(value, source, atype):
    """Validate --obtainability/--source and return (obtainability, source).

    `licensed-obtainable` REQUIRES a source descriptor: the whole claim of that value
    is that someone else could go and get this, and a claim nobody can act on is not
    a disclosure. `restricted` deliberately does not require one — it promises the
    opposite, and demanding provenance for data you are admitting nobody can fetch
    would just invite fiction.
    """
    if value is None:
        if source:
            sys.exit("error: --source requires --obtainability licensed-obtainable")
        return None, None
    if value not in OBTAINABILITY:
        sys.exit("error: --obtainability must be one of: " + " ".join(OBTAINABILITY))
    if atype != "dataset":
        # Obtainability describes acquiring source DATA. A synthesis is a new work whose
        # bytes ship with it; stamping it would imply the inputs travel too.
        sys.exit("error: --obtainability applies to datasets, not %s artifacts.\n"
                 "       It records whether an independent peer can acquire the same\n"
                 "       source bytes; a derived work carries its own." % atype)
    src = (source or "").strip()
    if value == "licensed-obtainable" and not src:
        sys.exit("error: --obtainability licensed-obtainable requires --source.\n"
                 "       Name the vendor/product/endpoint a peer would buy or request.\n"
                 "       'Independently obtainable' with no way to obtain it is not a\n"
                 "       disclosure — it is the claim that makes replication actionable.")
    if value != "licensed-obtainable" and src:
        sys.exit("error: --source only applies to --obtainability licensed-obtainable")
    return value, (src or None)


def availability_of(m):
    """Declared obtainability of a manifest, or None when not stated."""
    return (m.get("availability") or {}).get("obtainability")


def availability_display(m):
    """Short browse-time marker. '?' means undeclared, which is not the same as open."""
    if m.get("type") != "dataset":
        return ""
    return {"open": "open", "licensed-obtainable": "licensed",
            "restricted": "restricted"}.get(availability_of(m), "?")


def observed_of(m):
    """The observation time declared in the attestation statement, or None.

    `observed` is not a manifest field. It exists only inside a T3 attestation
    statement, so an artifact nobody has run `attest --observed` against has
    nothing but `created` — its publisher's self-declared publish time. Callers
    must therefore label which of the two they are showing: rendering a publish
    time as an observation time would be a new silent wrong answer, and for a
    measurement published months after it was captured the two differ a lot.
    """
    att = (m.get("verification") or {}).get("attested_by") or {}
    return (att.get("statement") or {}).get("observed") or None


def fmt_age(ts):
    """Compact relative age for a browse row: 3h, 2d, 5mo, 1y, or `<1h`. None if unparseable.

    Coarsest unit that fits, one component only. A browse row answers "should I still
    believe this", which never needs minutes on a five-month-old capture.

    Deliberately no minute unit: `5m` and `5mo` differ by one character in the one
    column whose whole job is telling fresh from stale, and a reader who misreads
    minutes as months inverts the answer. Anything under an hour is `<1h`, which is
    all the precision this surface can justify. Clamped at zero — a future `observed`
    is `attest`'s business (it already refuses one beyond the skew allowance), and a
    clock-skewed `created` should read as new rather than as a negative age.
    """
    # New attestations are canonical Zulu, but older signed statements and
    # imported manifests can use RFC 3339 offsets/fractions. Read those instants
    # without rewriting the signed bytes or silently dropping the age marker.
    t = parse_rfc3339(ts)
    if t is None:
        return None
    secs = max(0, calendar.timegm(time.gmtime()) - t)
    for unit, n in (("y", 31536000), ("mo", 2592000), ("d", 86400), ("h", 3600)):
        if secs >= n:
            return "%d%s" % (secs // n, unit)
    return "<1h"


def age_display(m):
    """Browse-time freshness marker: `obs 2d` (signed) or `pub 5mo` (self-declared).

    Freshness rides in the title column beside the availability marker, for the same
    reason that one does: a collection whose subject is a live market accumulates
    stale members that otherwise render identically to fresh ones, and a reader
    deciding whether to build on a member needs age at least as much as tier.
    Advisory only — it never moves a tier, a chain grade, or an exit code.
    The label names the timestamp source, not a signature-verification result;
    browse rendering deliberately does not call check_attestation().
    """
    # An unparseable `observed` must not blank the marker: fall back to the labelled
    # publish age rather than omitting freshness silently.
    age = fmt_age(observed_of(m))
    if age:
        return "obs %s" % age
    age = fmt_age(m.get("created"))
    return "pub %s" % age if age else ""


def dataset_disclosure_survey():
    """Every dataset's licence + obtainability disclosure state, computed in ONE place.

    Read by BOTH the `push` gate and the read-only `fsck --availability` view, and that
    sharing is the entire point of the function existing. A preview that computes
    exposure differently from the gate it previews is worse than no preview at all: it
    teaches the operator an expectation the gate will then contradict, which is a silent
    wrong answer of exactly the kind the licence/obtainability split was drawn to kill.
    Two copies of these three predicates would drift the first time one side changed.

    Buckets are the declared OBTAINABILITY values plus `undeclared`. Undeclared is kept
    as its own bucket rather than folded into `open`, because silence is the thing being
    reported. Returns ids only — callers decide what to print and what (if anything) to
    refuse. This function never exits, never mutates, and never orders a policy.

    (Forward-references `iter_manifests`, defined below with the other registry walkers;
    it lives here because it belongs to the licensing/availability vocabulary.)
    """
    buckets = {k: [] for k in OBTAINABILITY}
    buckets["undeclared"] = []
    unlicensed, sourceless = [], []
    total = 0
    for m in iter_manifests():
        if m.get("type") != "dataset":
            continue
        total += 1
        if not m.get("license"):
            unlicensed.append(m["id"])
        avail = m.get("availability") or {}
        obt = avail.get("obtainability")
        if not obt:
            buckets["undeclared"].append(m["id"])
            continue
        buckets.setdefault(obt, []).append(m["id"])
        # `licensed-obtainable` with no source is a claim nobody can act on. Publish
        # validation already refuses it, so reaching here means a manifest predating
        # that check — worth surfacing rather than trusting the field's presence.
        if obt == "licensed-obtainable" and not (avail.get("source") or "").strip():
            sourceless.append(m["id"])
    return {"total": total,
            "buckets": {k: sorted(v) for k, v in buckets.items()},
            "unlicensed": sorted(unlicensed),
            "sourceless": sorted(sourceless)}


AVAILABILITY_BUCKET_ORDER = ("open", "licensed-obtainable", "restricted", "undeclared")


def report_availability_exposure():
    """Read-only obtainability census + a preview of what `push` would refuse.

    Same posture as `warn_anchor_drift` and every other availability surface: advisory,
    informational, and structurally incapable of changing an exit code (it returns None
    and the caller does not consult it). The operator-facing value is seeing exposure
    BEFORE running `push`, instead of learning it from a refusal mid-publish.
    """
    s = dataset_disclosure_survey()
    print("--- dataset availability ---")
    if not s["total"]:
        print("no datasets")
        return
    print("%d dataset(s)" % s["total"])
    for key in AVAILABILITY_BUCKET_ORDER:
        ids = s["buckets"].get(key) or []
        if not ids:
            continue
        meaning = ("the publisher did not state whether anyone else can acquire these"
                   if key == "undeclared" else OBTAINABILITY_MEANING[key])
        print("  %-20s %d — %s" % (key, len(ids), meaning))
        for aid in ids:
            print("      %s" % aid)
    # Restricted data is WELCOME here; it is not an error and is deliberately not
    # counted as "exposure". What the gate objects to is silence, so only the silent
    # cases are previewed as blocking.
    blocking = []
    if s["buckets"].get("undeclared"):
        blocking.append("%d undeclared obtainability" % len(s["buckets"]["undeclared"]))
    if s["sourceless"]:
        blocking.append("%d licensed-obtainable without --source" % len(s["sourceless"]))
    if s["unlicensed"]:
        blocking.append("%d without a license" % len(s["unlicensed"]))
    if blocking:
        print("  push gate: WOULD REFUSE — %s" % "; ".join(blocking))
        if s["unlicensed"]:
            print("      unlicensed: %s" % ", ".join(s["unlicensed"]))
        if s["sourceless"]:
            print("      sourceless: %s" % ", ".join(s["sourceless"]))
        print("      Re-publish with --license/--obtainability, or push with")
        print("      --allow-unlicensed/--allow-undisclosed to proceed knowingly.")
    else:
        print("  push gate: would pass (every dataset declares licence + obtainability)")
    print("  note: availability is disclosure only — it never moves a tier, a chain")
    print("        grade, or this command's exit code.")


def build_verification(tier, criteria, params):
    """Validate + assemble the manifest verification block (None = untiered method)."""
    if tier is None:
        if criteria:
            sys.exit("error: --criteria requires --tier")
        return None
    v = {"tier": tier}
    if tier == "T1":
        if not criteria:
            sys.exit("error: tier T1 requires --criteria <sk-id> (a published comparator skill)")
        if not criteria.startswith("sk-"):
            sys.exit("error: tier T1 criteria must be a comparator skill id (sk-…), got %r" % criteria)
        cm = load_manifest(criteria, missing_ok=True)
        if cm is None:
            sys.exit("error: comparator %s is not published in this registry" % criteria)
        if cm["type"] != "skill":
            sys.exit("error: comparator %s is a %s, expected skill" % (criteria, cm["type"]))
    elif tier == "T2":
        # rubric-before-claim: judged work must declare its criteria up front
        if not criteria:
            sys.exit("error: tier T2 requires --criteria <rubric text|sk-id> (rubric before claim)")
    elif tier == "T3":
        criteria = criteria or DEFAULT_T3_CRITERIA
        if criteria == DEFAULT_T3_CRITERIA:
            print("warning: T3 artifact published with default attestation criteria; "
                  "pass --criteria to describe the capture", file=sys.stderr)
    if criteria: v["criteria"] = criteria
    if params: v["params"] = params
    return v


def _export_executable(aid, dest_dir):
    """Materialize a skill blob as an executable file (native exec; sandboxed in P3)."""
    m = load_manifest(aid)
    path = os.path.join(dest_dir, m["content"]["filename"] or (aid + ".py"))
    shutil.copyfile(blob_read_path(m["content"]["sha256"]), path)
    os.chmod(path, 0o700)
    return path


def run_comparator(comparator_id, expected, actual, params, exec_mode="native"):
    """Contract: comparator <expected> <actual> → exit 0 equivalent, non-zero not.

    A comparator is fetched code, so it runs under the same execution policy as
    workflows: sandboxed whenever the run that invoked it is sandboxed.
    """
    tmp = tempfile.mkdtemp(prefix="commons-cmp-")
    try:
        exe = _export_executable(comparator_id, tmp)
        shutil.copyfile(expected, os.path.join(tmp, "expected.bin"))
        shutil.copyfile(actual, os.path.join(tmp, "actual.bin"))
        pmap = {k: str(v) for k, v in (params or {}).items()}
        if exec_mode == "sandbox":
            policy = load_exec_policy()
            image = policy.get("default_image")
            check_image_allowed(image, policy)
            lim = policy.get("limits") or {}
            cmd = [container_cmd(), "run", "--rm", "--network=none",
                   "--memory=%s" % lim.get("memory", "2g"),
                   "--cpus=%s" % lim.get("cpus", "2"),
                   "--pids-limit=%d" % int(lim.get("pids", 256)),
                   "--read-only", "--tmpfs", "/tmp:rw,exec,size=64m",
                   "-v", "%s:/work:rw" % tmp, "-w", "/work"]
            for k, v in sorted(pmap.items()): cmd += ["-e", "%s=%s" % (k, v)]
            cmd += [image, "/work/" + os.path.basename(exe), "expected.bin", "actual.bin"]
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=300)
        else:
            env = dict(os.environ); env.update(pmap)
            cmd = [exe, expected, actual]
            try:
                r = subprocess.run(cmd, capture_output=True, text=True,
                                   timeout=300, env=env)
            except PermissionError:
                # Some hermetic runners mount tempfile.gettempdir() no-exec. Honor
                # a script comparator's shebang without weakening binary handling.
                with open(exe, errors="replace") as f: first = f.readline().strip()
                if not first.startswith("#!"): raise
                r = subprocess.run(shlex.split(first[2:]) + cmd,
                                   capture_output=True, text=True, timeout=300, env=env)
        return r.returncode == 0, (r.stdout + r.stderr).strip()
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


# ---------------- commands ----------------
def parse_duration(s):
    """'24h' / '90m' / '7d' -> seconds. Explicit units only; a bare number is ambiguous."""
    m = re.fullmatch(r"(\d+)\s*([smhd])", (s or "").strip().lower())
    if not m:
        sys.exit("error: duration must look like 30m, 24h, or 7d (got %r)" % s)
    n, unit = int(m.group(1)), m.group(2)
    return n * {"s": 1, "m": 60, "h": 3600, "d": 86400}[unit]


def parse_ts(s):
    """ISO-8601 Z timestamp -> epoch seconds (None if unparseable)."""
    try:
        return calendar.timegm(time.strptime(s, "%Y-%m-%dT%H:%M:%SZ"))
    except (ValueError, TypeError):
        return None


# Rubrics judge OUTPUT, never pedigree. A rubric naming the generating model turns a
# model *claim* into an acceptance input, which is precisely what makes masquerading
# pay. Refused at publish time, before anyone can claim against it.
MODEL_REF_PATTERNS = [
    re.compile(r"(?i)\b(?:gpt|claude|gemini|llama|mistral|qwen|deepseek|grok|kimi|glm)\b"),
    re.compile(r"(?i)\b(?:opus|sonnet|haiku)\b"),
    re.compile(r"(?i)\b(?:frontier|state[- ]of[- ]the[- ]art|sota)[- ]?(?:model|llm)\b"),
    re.compile(r"(?i)\bmust be (?:generated|produced|written|authored) by\b"),
    re.compile(r"(?i)\b(?:model|llm)\s*(?:=|:)\s*\S"),
]


# T2 structured judgements (2026-09-15).
# A judged result's comparable unit is its per-criterion verdict vector, never its
# prose bytes: two reviewers agreeing in different words is agreement, and identical
# words with different verdicts is not. The vocabulary is the cell vocabulary that
# docs/DESIGN-notes-divergence-reports.md already fixed.
VERDICTS = ("pass", "fail", "NA")
CRITERION_ID_RX = re.compile(r"^[A-Za-z][A-Za-z0-9_.-]{0,31}$")


def lint_criteria_list(cl, where="verification.criteria_list"):
    """Validate an enumerated rubric: ordered [{id, text}], unique ids, model-free text.

    Returns a list of problems. The prose `criteria` stays required alongside this
    (nothing existing is invalidated); the list is what makes verdicts addressable.
    """
    bad = []
    if not isinstance(cl, list) or not cl:
        return ["%s must be a non-empty list of {id, text}" % where]
    seen = set()
    for i, c in enumerate(cl):
        if not isinstance(c, dict):
            bad.append("%s[%d] must be an object {id, text}" % (where, i)); continue
        cid = c.get("id"); text = (c.get("text") or "").strip()
        if not isinstance(cid, str) or not CRITERION_ID_RX.match(cid):
            bad.append("%s[%d].id must match %s (got %r)"
                       % (where, i, CRITERION_ID_RX.pattern, cid))
        elif cid in seen:
            bad.append("%s: duplicate criterion id %r" % (where, cid))
        else:
            seen.add(cid)
        if not text:
            bad.append("%s[%d].text is required (what is being judged)" % (where, i))
        else:
            for rx in MODEL_REF_PATTERNS:
                hit = rx.search(text)
                if hit:
                    bad.append("%s[%d] references model pedigree (%r) — rubrics judge "
                               "output, never who produced it" % (where, i, hit.group(0)))
                    break
    return bad


# ---------------- analysis templates: method bundles + rubrics ----------------
# Bounds on what `publish skill` will introspect. A bundle is opened read-only with
# the stdlib tarfile module; we never extract it to disk here (run-skill is the only
# execution path and it is sandboxed). The caps exist because a tar header can lie
# about sizes and a 10-member archive can declare 10 TiB.
BUNDLE_MAX_MEMBERS = 4096
BUNDLE_MAX_MEMBER_BYTES = 64 << 20
BUNDLE_MAX_RUBRIC_BYTES = 256 << 10


def _tar_open(path):
    import tarfile
    try:
        return tarfile.open(path, mode="r:*")
    except (tarfile.TarError, OSError, EOFError):
        return None


def _tar_member_is_safe(ti):
    """Reject the shapes that make an archive dangerous to *read*, not just extract."""
    name = ti.name
    if not name or name.startswith("/") or name.startswith("..") or "/../" in name \
            or name.endswith("/.."):
        return False
    if ti.issym() or ti.islnk():
        return False
    if ti.size > BUNDLE_MAX_MEMBER_BYTES:
        return False
    return True


def bundle_members(path):
    """Return the member list of a skill bundle, or None if `path` is not a tar.

    Only regular files and directories count; anything unsafe raises ValueError
    naming the member so publish can refuse with a reason rather than a traceback.
    """
    tf = _tar_open(path)
    if tf is None:
        return None
    try:
        out = []
        for i, ti in enumerate(tf):
            if i >= BUNDLE_MAX_MEMBERS:
                raise ValueError("bundle has more than %d members" % BUNDLE_MAX_MEMBERS)
            if not _tar_member_is_safe(ti):
                raise ValueError("bundle member %r is unsafe (absolute path, traversal, "
                                 "link, or > %d MiB)" % (ti.name, BUNDLE_MAX_MEMBER_BYTES >> 20))
            out.append(ti)
        return out
    finally:
        tf.close()


def _bundle_root_name(name):
    """'x/SKILL.md' -> 'SKILL.md' when the bundle has one top-level dir, else as-is."""
    return name.lstrip("./")


def bundle_layout(members):
    """(root_prefix, names) — tolerate `tar -C dir .` ('./SKILL.md') and
    `tar dir` ('dir/SKILL.md') layouts; refuse if SKILL.md sits at two depths."""
    names = [_bundle_root_name(ti.name) for ti in members if ti.isfile()]
    if BUNDLE_MARKER_MEMBER in names:
        return "", names
    tops = {n.split("/", 1)[0] for n in names if "/" in n}
    hits = [t for t in tops if "%s/%s" % (t, BUNDLE_MARKER_MEMBER) in names]
    if len(hits) == 1:
        p = hits[0] + "/"
        return p, [n[len(p):] for n in names if n.startswith(p)]
    return None, names


def bundle_read_member(path, member):
    """Bytes of one member (root-relative, either layout) or None."""
    tf = _tar_open(path)
    if tf is None:
        return None
    try:
        members = [ti for ti in tf if ti.isfile()]
        prefix, _names = bundle_layout(members)
        if prefix is None:
            return None
        want = {prefix + member, "./" + prefix + member}
        for ti in members:
            if ti.name in want or _bundle_root_name(ti.name) == prefix + member:
                if ti.size > BUNDLE_MAX_RUBRIC_BYTES:
                    raise ValueError("bundle member %s exceeds %d KiB"
                                     % (member, BUNDLE_MAX_RUBRIC_BYTES >> 10))
                f = tf.extractfile(ti)
                return f.read() if f else None
        return None
    finally:
        tf.close()


def bundle_rubric(path):
    """criteria_list from a bundle's rubric.json, or None when absent.

    Raises ValueError on a present-but-invalid rubric so publish refuses: a method
    that ships a rubric nobody can copy into a task verbatim is worse than none.
    """
    raw = bundle_read_member(path, BUNDLE_RUBRIC_MEMBER)
    if raw is None:
        return None
    try:
        spec = json.loads(raw.decode("utf-8"))
    except (ValueError, UnicodeDecodeError) as e:
        raise ValueError("%s is not valid JSON: %s" % (BUNDLE_RUBRIC_MEMBER, e))
    cl = spec.get("criteria_list") if isinstance(spec, dict) else spec
    probs = lint_criteria_list(cl, where=BUNDLE_RUBRIC_MEMBER + ".criteria_list")
    if probs:
        raise ValueError("; ".join(probs))
    return [{"id": c["id"], "text": c["text"].strip()} for c in cl]


def is_method_skill(m):
    """A skill tagged as a category-level method (the analysis-template slot)."""
    return bool(m) and m.get("type") == "skill" and METHOD_TAG in (m.get("tags") or [])


def method_categories(m):
    return sorted(t[len(CATEGORY_TAG_PREFIX):] for t in (m.get("tags") or [])
                  if isinstance(t, str) and t.startswith(CATEGORY_TAG_PREFIX)
                  and len(t) > len(CATEGORY_TAG_PREFIX))


def method_rubric(m):
    """The method's pinned rubric (copied into the manifest at publish), or None."""
    cl = (m or {}).get("rubric")
    return cl if isinstance(cl, list) and cl else None


def applies_targets(m):
    return [l["id"] for l in (m or {}).get("links", [])
            if isinstance(l, dict) and l.get("rel") == APPLIES_REL and l.get("id")]


def applied_by_index():
    """method id -> [instance ids] over locally-held manifests (one scan)."""
    out = {}
    for m in iter_manifests():
        for dst in applies_targets(m):
            out.setdefault(dst, []).append(m["id"])
    return {k: sorted(v) for k, v in out.items()}


def parse_judgement(pairs):
    """--judgement ID=VERDICT… → dict, or exit naming the offending pair."""
    out = {}
    for spec in pairs or []:
        cid, sep, v = spec.partition("=")
        if not sep or not cid or not v:
            sys.exit("error: --judgement must be CRITERION_ID=pass|fail|NA (got %r)" % spec)
        if not CRITERION_ID_RX.match(cid):
            sys.exit("error: --judgement criterion id %r is malformed" % cid)
        if v not in VERDICTS:
            sys.exit("error: --judgement verdict for %r must be one of %s (got %r); "
                     "the vocabulary is closed so vectors stay comparable"
                     % (cid, "|".join(VERDICTS), v))
        if cid in out:
            sys.exit("error: --judgement repeats criterion %r" % cid)
        out[cid] = v
    return out


def judgement_vector_key(judgement, criteria_list=None):
    """Canonical comparison key for a verdict vector.

    Ordered by the task's criteria_list when given (so the key is stable across
    reviewers regardless of the order they typed verdicts), else by criterion id.
    Absent criteria read as NA rather than making two otherwise-identical judgements
    unequal on a missing key.
    """
    if not isinstance(judgement, dict) or not judgement:
        return None
    if criteria_list:
        order = [c.get("id") for c in criteria_list if isinstance(c, dict) and c.get("id")]
    else:
        order = sorted(judgement)
    cells = []
    for cid in order:
        v = judgement.get(cid, "NA")
        cells.append("%s=%s" % (cid, v if v in VERDICTS else "NA"))
    return "verdict:" + ",".join(cells)


def judgement_problems(judgement, criteria_list):
    """Cross-check a result's judgement against the task's enumerated rubric."""
    ids = [c["id"] for c in criteria_list if isinstance(c, dict) and c.get("id")]
    missing = [i for i in ids if i not in judgement]
    extra = [i for i in judgement if i not in ids]
    bad = []
    if missing:
        bad.append("judgement is missing verdicts for criteria: %s" % ", ".join(missing))
    if extra:
        bad.append("judgement names criteria the task rubric does not declare: %s"
                   % ", ".join(extra))
    return bad


def lint_task_spec(spec):
    """Validate a task spec before it becomes an immutable, claimable artifact.

    Every rule here is cheap now and unenforceable later: once a task is published
    and claimed, changing its terms is renegotiation, not editing.
    """
    bad = []
    if not isinstance(spec, dict):
        return ["task content must be a JSON object"]

    if not (spec.get("objective") or "").strip():
        bad.append("objective is required (what is actually being asked)")

    pri = spec.get("priority", 2)
    if not isinstance(pri, int) or not 1 <= pri <= 3:
        bad.append("priority must be an integer 1-3 (1 = highest)")

    # An open-ended task never leaves the queue and is a claim-squatting surface.
    exp = spec.get("expires")
    if not exp:
        bad.append("expires is required (ISO-8601 Z); a task without an end never "
                   "leaves the queue")
    elif parse_ts(exp) is None:
        bad.append("expires must be ISO-8601 UTC like 2026-08-15T00:00:00Z (got %r)" % exp)

    ver = spec.get("verification") or {}
    tier = ver.get("tier")
    if tier not in ("T0", "T1", "T2"):
        bad.append("verification.tier must be T0, T1, or T2 (T3 is an observation, "
                   "not a commissionable task)")
    criteria = (ver.get("criteria") or "").strip()
    if not criteria:
        bad.append("verification.criteria is required BEFORE the task is claimable "
                   "(rubric-before-claim)")

    execution = spec.get("execution") or {}
    has_wf = bool(execution.get("workflow"))
    has_brief = bool((execution.get("brief") or "").strip())
    if not (has_wf or has_brief):
        bad.append("execution needs either a workflow id or a prose brief")
    if tier in ("T0", "T1"):
        if not has_wf:
            bad.append("T0/T1 tasks must reference a runnable workflow — machine-verifiable "
                       "work needs a machine to run")
        else:
            wfm = load_manifest(execution["workflow"], missing_ok=True)
            if wfm is None:
                bad.append("execution.workflow %s is not published here" % execution["workflow"])
            elif wfm["type"] != "workflow":
                bad.append("execution.workflow %s is a %s" % (execution["workflow"], wfm["type"]))
    if tier == "T1" and criteria and not criteria.startswith("sk-"):
        bad.append("T1 tasks must name a comparator skill id as criteria")
    if tier == "T2" and criteria:
        for rx in MODEL_REF_PATTERNS:
            hit = rx.search(criteria)
            if hit:
                bad.append("T2 rubric references model pedigree (%r). Rubrics judge output, "
                           "never who produced it — otherwise a model claim becomes an "
                           "acceptance input and masquerading pays." % hit.group(0))
                break
    cl = ver.get("criteria_list")
    if cl is not None:
        if tier != "T2":
            bad.append("verification.criteria_list is only meaningful on T2 (judged) "
                       "tasks — machine tiers compare bytes, not verdicts")
        bad.extend(lint_criteria_list(cl))
    # Analysis templates, stage 3: `method: sk-…` records where the rubric came from.
    # The task still OWNS its rubric (immutable, before-claim) — the method is only
    # the default's provenance — so a task may narrow or extend it, but it may not
    # claim a method and then judge by criteria that method never declared without
    # at least keeping the method's ids: that is what lets two beneficiaries'
    # instance-tasks replicate on the same verdict-vector shape.
    method = spec.get("method")
    if method is not None:
        if not isinstance(method, str) or not method.startswith("sk-"):
            bad.append("method must be a skill id (sk-…)")
        else:
            mm = load_manifest(method, missing_ok=True)
            if mm is None:
                bad.append("method %s is not published here" % method)
            elif mm.get("type") != "skill":
                bad.append("method %s is a %s, not a skill" % (method, mm.get("type")))
            else:
                mr = method_rubric(mm)
                if tier != "T2":
                    bad.append("method is only meaningful on T2 tasks — applying a method "
                               "is judged work; machine tiers name a workflow instead")
                elif mr and cl:
                    have = {c.get("id") for c in cl if isinstance(c, dict)}
                    missing = [c["id"] for c in mr if c["id"] not in have]
                    if missing:
                        bad.append("method %s declares rubric criteria this task omits: %s — "
                                   "extend the rubric, or drop `method` and own a "
                                   "different one" % (method, ", ".join(missing)))
                elif mr and not cl:
                    bad.append("method %s carries a rubric (%d criteria) but this task has no "
                               "criteria_list — run `commons publish task … --method %s` to "
                               "copy it, or paste `commons rubric %s`"
                               % (method, len(mr), method, method))
    dq0 = spec.get("diversity_quorum")
    if tier == "T2" and isinstance(dq0, dict) and isinstance(dq0.get("k"), int) \
            and dq0["k"] > 1 and cl is None:
        # Measured 2026-08-26: without an enumerated rubric a T2 quorum has no
        # reachable success state (different prose = DIVERGENT; identical prose dedups
        # to one derivation). Refuse the contract rather than let a claimant discover it.
        bad.append("T2 tasks with diversity_quorum.k > 1 must declare "
                   "verification.criteria_list — judged work is replicated on "
                   "per-criterion verdicts, and without an enumerated rubric there is "
                   "nothing two reviewers could ever agree on byte-for-byte")

    for i, inp in enumerate(spec.get("inputs") or []):
        if not isinstance(inp, dict) or not inp.get("id"):
            bad.append("inputs[%d] needs an id" % i); continue
        im = load_manifest(inp["id"], missing_ok=True)
        if im is None:
            bad.append("input %s is not published here" % inp["id"])
        elif inp.get("sha256") and im["content"]["sha256"] != inp["sha256"]:
            bad.append("input %s sha256 does not match the published artifact" % inp["id"])

    if not (spec.get("beneficiary") or {}).get("addr"):
        bad.append("beneficiary.addr is required (only they may accept or reject)")

    mc = spec.get("max_claims", 1)
    if not isinstance(mc, int) or mc < 1:
        bad.append("max_claims must be a positive integer")

    dq = spec.get("diversity_quorum")
    if dq is not None:
        if not isinstance(dq, dict) or not isinstance(dq.get("k"), int) \
                or not isinstance(dq.get("distinct_families"), int):
            bad.append("diversity_quorum needs integer k and distinct_families")
        else:
            if dq["distinct_families"] > dq["k"]:
                bad.append("diversity_quorum.distinct_families cannot exceed k")
            if isinstance(mc, int) and dq["k"] > mc:
                bad.append("diversity_quorum.k (%d) exceeds max_claims (%d): the quorum "
                           "could never be filled" % (dq["k"], mc))

    for cid in (spec.get("collections") or []):
        cm = load_manifest(cid, missing_ok=True)
        if cm is None:
            bad.append("collection %s is not published here" % cid)
        elif cm["type"] != "collection":
            bad.append("%s is a %s, not a collection" % (cid, cm["type"]))
    return bad


def lint_collection_spec(spec):
    bad = []
    if not isinstance(spec, dict):
        return ["collection content must be a JSON object"]
    if not (spec.get("scope") or "").strip():
        bad.append("scope is required (what this collection is about)")
    maint = spec.get("maintainers") or []
    if not maint:
        bad.append("maintainers is required (an unowned collection cannot curate)")
    for i, mm in enumerate(maint):
        if not isinstance(mm, dict) or not mm.get("addr"):
            bad.append("maintainers[%d] needs an addr" % i)
    # Members must be well-formed ids, but are NOT required to be present locally:
    # lazy replication means a curator can legitimately endorse an artifact whose
    # bytes this host has never fetched. Refusing that would make curation depend on
    # replication state, which is exactly the coupling lazy blobs exist to avoid.
    for i, entry in enumerate(spec.get("members") or []):
        if not isinstance(entry, dict) or not entry.get("id"):
            bad.append("members[%d] needs an id" % i); continue
        aid = entry["id"]
        if not re.fullmatch(r"(%s)-[0-9a-f]{8}" % "|".join(sorted(TYPES.values())), aid):
            bad.append("members[%d] id %r is not a well-formed artifact id" % (i, aid))
            continue
        # A `method` role is a claim that this member is the category's procedure.
        # Only a method-typed artifact (skill or workflow — the tierless, pinned-by-
        # hash slot) can be one; refuse when we can see the member and it isn't.
        # (Not-held-locally stays legal, same lazy-replication reasoning as above.)
        # Workflows as `method` predate the analysis-templates convention (the
        # subscription fixture uses one) and stay legal: a workflow IS a procedure.
        # Only skills carry category tags + rubrics, so an untagged skill warns.
        if (entry.get("role") or "") == ROLE_METHOD:
            mm = load_manifest(aid, missing_ok=True)
            if mm is not None and mm.get("type") not in METHOD_TYPES:
                bad.append("members[%d] %s has role %r but is a %s — a method is a skill or "
                           "workflow" % (i, aid, ROLE_METHOD, mm.get("type")))
            elif mm is not None and mm.get("type") == "skill" and not is_method_skill(mm):
                print("warning: members[%d] %s has role %r but is not tagged %r; it will render "
                      "with a marker" % (i, aid, ROLE_METHOD, METHOD_TAG), file=sys.stderr)
    # An `ingest` policy refuses other people's publishes, so a malformed one must be
    # caught here rather than silently enforcing nothing. A policy that looks present and
    # protects nothing is worse than an absent one: the maintainer stops worrying.
    bad += lint_ingest_block(spec.get("ingest"))
    return bad


def lint_ingest_block(ing):
    """Validate a collection spec's `ingest` policy. Returns a list of problems."""
    if ing is None:
        return []
    if not isinstance(ing, dict):
        return ["ingest must be a JSON object"]
    bad = []
    unknown = [k for k in ing if k not in ("forbidden_keys",)]
    if unknown:
        # Refuse rather than ignore: a misspelled key in a *policy* object reads as
        # protection that isn't there.
        bad.append("ingest has unknown key(s) %s — only forbidden_keys is understood"
                   % ", ".join(sorted(repr(k) for k in unknown)))
    if "forbidden_keys" in ing:
        keys = ing["forbidden_keys"]
        if not isinstance(keys, list) or not keys:
            bad.append("ingest.forbidden_keys must be a non-empty list of field names")
        else:
            for i, k in enumerate(keys):
                if not isinstance(k, str) or not k.strip():
                    bad.append("ingest.forbidden_keys[%d] must be a non-empty string" % i)
                elif k != k.strip():
                    bad.append("ingest.forbidden_keys[%d] %r has surrounding whitespace" % (i, k))
    return bad


def lint_announce_spec(spec, signer_addr):
    """Validate a peer reachability hint against its publishing signer."""
    bad = []
    if not isinstance(spec, dict):
        return ["peer-announce content must be a JSON object"]

    announcer = spec.get("announcer")
    if not isinstance(announcer, str) or not re.fullmatch(r"0x[0-9a-fA-F]{40}", announcer):
        bad.append("announcer must be a 0x-prefixed 20-byte address")
    elif not signer_addr or announcer.lower() != signer_addr.lower():
        bad.append("announcer must equal the publishing signer's address")

    remotes = spec.get("remotes")
    if not isinstance(remotes, list) or not remotes:
        bad.append("remotes must be a non-empty list")
    else:
        for i, remote in enumerate(remotes):
            if not isinstance(remote, dict):
                bad.append("remotes[%d] must be an object" % i); continue
            url = remote.get("url")
            if not isinstance(url, str) or not url or re.search(r"\s", url):
                bad.append("remotes[%d].url is required and must not contain whitespace" % i)
                continue
            plausible = False
            if os.path.isabs(url):
                plausible = True
            elif re.fullmatch(r"git@[^/:\s]+:.+", url):
                plausible = True
            elif url.startswith(("ssh://", "https://")):
                parsed = urlsplit(url)
                plausible = bool(parsed.hostname and parsed.path not in ("", "/"))
                if parsed.password is not None:
                    bad.append("remotes[%d].url must not contain credentials" % i)
            credential_problem = "remotes[%d].url must not contain credentials" % i
            if re.search(r"://[^/@\s]*:[^/@\s]*@", url):
                if credential_problem not in bad:
                    bad.append(credential_problem)
            elif not plausible:
                bad.append("remotes[%d].url is not a plausible git URL" % i)
            for optional in ("transport", "note"):
                if optional in remote and not isinstance(remote[optional], str):
                    bad.append("remotes[%d].%s must be a string" % (i, optional))

    hosts = spec.get("hosts", [])
    if not isinstance(hosts, list):
        bad.append("hosts must be a list when present")
    else:
        for i, hosted in enumerate(hosts):
            if not isinstance(hosted, dict):
                bad.append("hosts[%d] must be an object" % i); continue
            if not re.fullmatch(r"cl-[0-9a-f]{8}", hosted.get("collection") or ""):
                bad.append("hosts[%d].collection is not a well-formed collection id" % i)
            if hosted.get("blobs") not in ("manifests-only", "members", "all"):
                bad.append("hosts[%d].blobs must be manifests-only, members, or all" % i)

    refreshed, expires = spec.get("refreshed"), spec.get("expires")
    refreshed_ts, expires_ts = parse_ts(refreshed), parse_ts(expires)
    if not refreshed:
        bad.append("refreshed is required (ISO-8601 UTC)")
    elif refreshed_ts is None:
        bad.append("refreshed must be ISO-8601 UTC like 2026-08-04T00:00:00Z")
    if not expires:
        bad.append("expires is required (ISO-8601 UTC)")
    elif expires_ts is None:
        bad.append("expires must be ISO-8601 UTC like 2026-11-02T00:00:00Z")
    if refreshed_ts is not None and expires_ts is not None:
        tm = time.gmtime(refreshed_ts)
        month0 = tm.tm_mon - 1 + 6
        year, month = tm.tm_year + month0 // 12, month0 % 12 + 1
        day = min(tm.tm_mday, calendar.monthrange(year, month)[1])
        max_expiry = calendar.timegm((year, month, day, tm.tm_hour, tm.tm_min,
                                      tm.tm_sec, 0, 0, 0))
        if expires_ts <= refreshed_ts:
            bad.append("expires must be later than refreshed")
        elif expires_ts > max_expiry:
            bad.append("expires must be no more than 6 months after refreshed")
    return bad


def run_publish_lint(path, allow):
    """Fail-closed secret/PII scan before content enters the immutable store."""
    sys.path.insert(0, LIB)
    try:
        import publish_lint
    except ImportError:
        print("warning: secret lint unavailable (lib/publish_lint.py missing); skipping",
              file=sys.stderr)
        return
    finally:
        sys.path.pop(0)
    findings = publish_lint.scan_file(path)
    blocking = [f for f in findings if f[0] == "block"]
    for sev, label, lineno, excerpt in findings:
        print("%-5s line %s: %s [%s]" % (sev.upper(), lineno or "?", label, excerpt),
              file=sys.stderr)
    if publish_lint.is_partial(findings):
        # Advisory, never an exit-code change (warn-only epoch).
        print("warning: the secret lint only partly scanned %s. Its tail is unchecked:\n"
              "         scan it yourself before publishing, or split it by its natural range\n"
              "         (block range, date) into files under 100 MiB, which is also GitHub's\n"
              "         per-file limit." % os.path.basename(path), file=sys.stderr)
    if blocking and not allow:
        sys.exit("error: refusing to publish — %d blocking secret/PII finding(s).\n"
                 "       Blobs are immutable and replicate; retraction is best-effort "
                 "recall, not erasure.\n"
                 "       Remove the secret, or pass --allow-secrets if this is a "
                 "deliberate false positive." % len(blocking))
    if blocking:
        print("warning: publishing despite %d blocking finding(s) (--allow-secrets)"
              % len(blocking), file=sys.stderr)


def _apply_task_method(a):
    """`publish task spec.json --method sk-…`: copy the method's rubric into the spec.

    Writes a sibling `<spec>.with-method.json` and publishes THAT, so the bytes
    that become the immutable task are visible on disk before and after. The
    task's own criteria_list, if present, wins per-id; method criteria it lacks
    are appended (the lint then confirms no method id is missing).
    """
    method = getattr(a, "method", None)
    if not method:
        return
    if a.type != "task":
        sys.exit("error: --method applies to `publish task` only")
    mm = load_manifest(method)
    if mm.get("type") != "skill":
        sys.exit("error: --method %s is a %s, not a skill" % (method, mm.get("type")))
    mr = method_rubric(mm)
    if not mr:
        sys.exit("error: --method %s carries no rubric to copy (no %s in its bundle). "
                 "Set `method` in the spec by hand if you only want the link."
                 % (method, BUNDLE_RUBRIC_MEMBER))
    try:
        with open(a.file) as f: spec = json.load(f)
    except ValueError as e:
        sys.exit("error: task content must be valid JSON: %s" % e)
    if not isinstance(spec, dict):
        sys.exit("error: task content must be a JSON object")
    if spec.get("method") not in (None, method):
        sys.exit("error: spec already names method %s; --method %s disagrees"
                 % (spec.get("method"), method))
    ver = spec.setdefault("verification", {})
    own = [c for c in (ver.get("criteria_list") or []) if isinstance(c, dict)]
    have = {c.get("id") for c in own}
    merged = own + [dict(c) for c in mr if c["id"] not in have]
    ver["criteria_list"] = merged
    if not (ver.get("criteria") or "").strip():
        ver["criteria"] = "Judged against the rubric of method %s (%d criteria); see " \
                          "criteria_list." % (method, len(merged))
    spec["method"] = method
    out = re.sub(r"\.json$", "", a.file) + ".with-method.json"
    with open(out, "w") as f:
        json.dump(spec, f, indent=2, sort_keys=True); f.write("\n")
    print("note: rubric from %s copied (%d criteria, %d added) -> %s"
          % (method, len(merged), len(merged) - len(own), out), file=sys.stderr)
    a.file = out


def cmd_publish(a):
    ensure_dirs()
    if a.type not in TYPES: sys.exit("error: type must be one of: " + " ".join(TYPES))
    if not os.path.isfile(a.file): sys.exit("error: no such file: " + a.file)
    _apply_task_method(a)
    # Argument validation before anything that warns, so a rejected flag is the first
    # thing on stderr rather than the last line under an unrelated tier warning.
    license_id = validate_license(a.license)
    obtainability, obt_source = validate_obtainability(
        getattr(a, "obtainability", None), getattr(a, "source", None), a.type)
    # A --force republish of bytes already held starts from the existing manifest
    # (#18): look it up now, read-only (hash only; the blob is still stored after every
    # gate below), so the tier/verification decision can see what is already recorded.
    prior = None
    if a.force:
        prior = load_manifest("%s-%s" % (TYPES[a.type], sha256_file(a.file)[:8]),
                              missing_ok=True)
    inherit_verification = bool(
        prior is not None and prior.get("verification")
        and a.tier is None and not a.workflow and a.criteria is None and not a.param)
    if inherit_verification:
        # Same bytes, same id: the recorded verification (tier, criteria, params,
        # attestation) is still a true statement about them. Re-deriving it from type
        # defaults is what turned a verified T0 derivation into an unattested T3.
        verification = copy.deepcopy(prior["verification"])
        tier = verification.get("tier")
    else:
        tier = resolve_tier(a, bool(a.workflow), a.type)
        if (prior is not None and a.tier is None and a.type not in METHOD_TYPES
                and (prior.get("verification") or {}).get("tier") in TIER_RANK
                and TIER_RANK.get(tier, 99) > TIER_RANK[tier_of(prior)]):
            # Only a silent DOWNGRADE is refused; restating --workflow on a T3 dataset
            # is an explicit upgrade and goes through.
            sys.exit("error: this --force would downgrade %s from tier %s to %s without "
                     "--tier.\n"
                     "       Pass --tier %s to keep it, or --tier %s to change it "
                     "deliberately." % (prior["id"], tier_of(prior), tier,
                                        tier_of(prior), tier))
        verification = build_verification(tier, a.criteria, parse_params(a.param))
    judgement = parse_judgement(getattr(a, "judgement", None))
    if judgement and tier != "T2":
        sys.exit("error: --judgement is a T2 (judged) verdict vector; this artifact is tier %s"
                 % tier)
    run_publish_lint(a.file, a.allow_secrets)
    # After the credential scan and before anything is pinned: the collections this
    # artifact claims membership in may declare field names they refuse to accept.
    ingest_unchecked = run_ingest_policy_gate(a)
    declares_ingest_policy = False
    if a.type in ("task", "collection", "peer-announce"):
        try:
            with open(a.file) as f: spec = json.load(f)
        except ValueError as e:
            sys.exit("error: %s content must be valid JSON: %s" % (a.type, e))
        if a.type == "task":
            problems = lint_task_spec(spec)
        elif a.type == "collection":
            problems = lint_collection_spec(spec)
            declares_ingest_policy = spec_has_ingest_policy(spec)
        else:
            if not signing_key_path():
                sys.exit("error: peer-announce must be signed — set COMMONS_SIGNING_KEY")
            signer_addr, _sig = sign_entry({"action": "whoami", "agent": a.agent,
                                            "id": "-", "sha256": "-", "ts": now()})
            problems = lint_announce_spec(spec, signer_addr)
            if a.input or a.workflow:
                problems.append("peer-announce artifacts cannot carry provenance evidence")
            for link in a.link or []:
                rel, _sep, _dst = link.partition(":")
                if rel in EVIDENCE_RELS:
                    problems.append("peer-announce artifacts cannot carry evidence links")
        if problems:
            for pb in problems: print("  - %s" % pb, file=sys.stderr)
            sys.exit("error: refusing to publish %s — %d problem(s) above.\n"
                     "       Artifact content is immutable; correct the spec and retry."
                     % (a.type, len(problems)))
    # Analysis templates: skills may be SKILL.md bundles (tar) carrying a rubric, and
    # any artifact may declare `applies:sk-…`. Method conventions are advisory
    # (warnings) — the note's stage 1 is convention, not schema — but a bundle that
    # cannot be read safely, or a rubric that cannot be copied into a task verbatim,
    # is refused here because nothing can fix it after the bytes are pinned.
    rubric = None
    if a.type == "skill":
        rubric = _lint_skill_bundle(a)
    _lint_applies_links(a)
    digest = store_blob(a.file)
    aid = "%s-%s" % (TYPES[a.type], digest[:8])
    existed = os.path.exists(manifest_path(aid))
    m = {
        "schema": SCHEMA,
        "id": aid, "type": a.type, "title": a.title,
        "description": a.description or "", "tags": a.tag or [],
        "agent": a.agent, "created": now(),
        "content": {"sha256": digest, "filename": os.path.basename(a.file),
                    "bytes": os.path.getsize(a.file)},
        "links": [],
    }
    if verification: m["verification"] = verification
    if judgement: m["judgement"] = judgement
    if rubric:
        # Derived from the content blob (rubric.json inside the tar), so it is as
        # pinned as the id itself; kept on the manifest so `collection show`,
        # `rubric` and the task lint can read it without opening the archive.
        m["rubric"] = rubric
    if license_id: m["license"] = license_id
    if declares_ingest_policy:
        # Derived from the spec, never a CLI flag: it must be impossible for the manifest
        # to advertise a policy the bytes do not contain, or to omit one they do.
        m[INGEST_POLICY_FLAG] = True
    if obtainability:
        m["availability"] = {"obtainability": obtainability}
        if obt_source: m["availability"]["source"] = obt_source
    if a.link:
        for spec in a.link:
            rel, _, dst = spec.partition(":")
            if not dst: sys.exit("error: --link must be rel:artifact-id")
            m["links"].append({"rel": rel, "id": dst})
    prov = {}
    if a.input:
        ins = []
        for iid in a.input:
            im = load_manifest(iid)
            ins.append({"id": iid, "sha256": im["content"]["sha256"]})
        prov["inputs"] = ins
    if a.workflow:
        wm = load_manifest(a.workflow)
        prov["workflow"] = {"id": a.workflow, "sha256": wm["content"]["sha256"]}
    if prov: m["provenance"] = prov
    _guard_manifest_collision(aid, m)
    if existed and not a.force:
        old = load_manifest(aid)
        if aid not in attributed_ids() and not old.get("ingest"):
            # An artifact in the store with NO publish/republish event anywhere is the
            # residue of the pre-2026-09-21 publish-before-sign bug (or a hand-copied
            # manifest). Reporting "already published" with exit 0 here was a success
            # message over an unattributed artifact; backfill the missing event instead.
            # The manifest is left untouched (first-writer-wins); the entry's ts is
            # honestly "now", not the manifest's self-declared `created`.
            ledger_append({"agent": a.agent, "action": "publish", "id": aid,
                           "sha256": digest,
                           "tier": (old.get("verification") or {}).get("tier") or "method",
                           "backfill": True})
            print("note: %s existed with no ledger publish event; backfilled attribution"
                  % aid, file=sys.stderr)
            print(aid)
            return
        print("already published as %s (%s); manifest unchanged (use --force to overwrite metadata)"
              % (aid, old.get("created")))
        return
    if existed and a.force:
        # Metadata overwrite must not silently destroy signed statements about this
        # content. An attestation is someone's signature over {id, sha256, criteria};
        # since the content is identical (same id), it remains valid and must survive.
        old = load_manifest(aid)
        old_att = (old.get("verification") or {}).get("attested_by")
        if old_att and not (verification or {}).get("attested_by"):
            old_criteria = (old.get("verification") or {}).get("criteria")
            if not a.criteria and old_criteria:
                # No new criteria given: keep the attested text rather than silently
                # replacing it with a tier default and orphaning the signature.
                m.setdefault("verification", verification or {"tier": tier})[
                    "criteria"] = old_criteria
            if a.criteria and a.criteria != old_criteria:
                # The attestation covers the OLD criteria text, so changing it would
                # leave a signature over a statement no longer on the manifest.
                sys.exit("error: %s carries an attestation by %s over its current "
                         "criteria.\n"
                         "       Changing --criteria would orphan that signature. "
                         "Re-attest instead:\n"
                         "         commons attest %s --criteria '…' --force"
                         % (aid, old_att.get("addr"), aid))
            m.setdefault("verification", verification or {"tier": tier})["attested_by"] = old_att
            print("note: preserved existing attestation by %s" % old_att.get("addr"),
                  file=sys.stderr)
        # Same reasoning for provenance, field by field (#18): what this invocation did
        # not restate is carried forward. `run` (env, exec, finished) has no publish
        # flag at all, so it can only ever be carried; `inputs`/`workflow` are replaced
        # only when --input/--workflow are given.
        old_prov = old.get("provenance") or {}
        for key, supplied in (("inputs", a.input), ("workflow", a.workflow)):
            if not supplied and old_prov.get(key):
                m.setdefault("provenance", {})[key] = copy.deepcopy(old_prov[key])
        old_run = old_prov.get("run") or {}
        new_run = m.setdefault("provenance", {}).setdefault("run", {})
        for key, val in old_run.items():
            new_run.setdefault(key, copy.deepcopy(val))
        if not new_run: del m["provenance"]["run"]
        if not m["provenance"]: del m["provenance"]
        # Editorial metadata: an omitted flag means "unchanged", not "empty".
        if a.description is None: m["description"] = old.get("description", "")
        if a.tag is None: m["tags"] = list(old.get("tags") or [])
        if a.link is None: m["links"] = copy.deepcopy(old.get("links") or [])
        # The id's first publish time; the republish itself is the ledger entry's ts.
        if old.get("created"): m["created"] = old["created"]
        if old.get("license") and not m.get("license"):
            m["license"] = old["license"]
        # Same carry-forward reasoning: a metadata overwrite that omits --obtainability
        # must not silently downgrade a stated disclosure back to undeclared.
        if old.get("availability") and not m.get("availability"):
            m["availability"] = old["availability"]
    # Dataset disclosure warnings check the FINAL manifest, after the --force
    # carry-forward and after the no-op early returns, for the same reason as the
    # advisory below: a republish that keeps a stated licence must not claim it lacks one.
    if a.type == "dataset" and not m.get("license"):
        print("warning: dataset published without --license. Required before pushing to "
              "a shared remote (SPDX id or proprietary-internal).", file=sys.stderr)
    if a.type == "dataset" and not availability_of(m):
        # Deliberately a warning at publish and a refusal at push, mirroring --license:
        # local experimentation stays frictionless, and the gate lands where
        # "destined for someone else" actually becomes true. Silence must not read as
        # `open` — an unstated default is the silent-wrong-answer shape this whole
        # change exists to remove.
        print("warning: dataset published without --obtainability. Undeclared is NOT "
              "assumed open;\n"
              "         state open|licensed-obtainable|restricted (required before "
              "pushing to a shared remote).", file=sys.stderr)
    if a.type in LICENSE_ADVISORY_TYPES and not m.get("license"):
        # Advisory only, never a push refusal (that gate stays dataset-only, §1.3 of
        # the licence-defaults report): the default rule of copyright everywhere is
        # "all rights reserved" the moment a work is fixed. Silence here is the exact
        # silent-wrong-answer shape the dataset warning above already exists to name;
        # this just says the same true thing for the other types that can carry a
        # licence. Deliberately placed here, after the --force carry-forward above and
        # after both no-op early returns (dedup and backfill) — so it fires exactly
        # once per artifact that is actually about to be published or republished
        # unlicensed, checking the FINAL manifest license (which may have been carried
        # forward from an old republish) rather than the raw --license flag. Never
        # fires for collection/task — those are editorial metadata, not a work whose
        # absence-of-licence needs flagging the same way.
        print("warning: %s published without --license. With no licence, others have "
              "no stated right to reuse it (all rights reserved by default). "
              "Suggested: CC-BY-4.0 for reports/syntheses/wiki, Apache-2.0 for "
              "workflows/skills; see docs/LICENSING-artifacts.md." % a.type,
              file=sys.stderr)
    entry = {"agent": a.agent, "action": "republish" if existed else "publish",
             "id": aid, "sha256": digest, "tier": tier or "method"}
    if ingest_unchecked:
        # An audit trail for a deliberate skip. Recorded but NOT signed: SIGNED_FIELDS is
        # ("action", "agent", "id", "sha256", "ts") and widening it would change the
        # signing contract for every event type, which deserves its own change. Good
        # enough for the honest-mistake case this exists to make visible.
        entry["ingest_unchecked"] = ",".join(ingest_unchecked)
    commit_signed_publish(aid, m, entry, existed)
    print(aid)


def _lint_skill_bundle(a):
    """Bundle + method-convention checks for `publish skill`. Returns the rubric."""
    tags = a.tag or []
    is_bundle = False
    rubric = None
    try:
        members = bundle_members(a.file)
    except ValueError as e:
        sys.exit("error: refusing to publish skill bundle — %s" % e)
    if members is not None:
        prefix, names = bundle_layout(members)
        if prefix is None:
            sys.exit("error: %s is a tar archive but has no %s at its root (or at exactly "
                     "one top-level directory).\n"
                     "       A skill bundle must be a SKILL.md bundle; a plain data tar is a "
                     "dataset, not a skill." % (os.path.basename(a.file), BUNDLE_MARKER_MEMBER))
        is_bundle = True
        try:
            rubric = bundle_rubric(a.file)
        except ValueError as e:
            sys.exit("error: refusing to publish skill bundle — %s.\n"
                     "       A method rubric must be copyable verbatim into a T2 task's "
                     "verification.criteria_list." % e)
        # The lint scans the tar bytes; text members are only scanned as far as the
        # binary-path block patterns reach. Say so, once, so the publisher knows what
        # was and was not checked: archive members are not decompressed and re-scanned.
        print("note: %s is a SKILL.md bundle (%d file member(s)%s). Secret lint ran over "
              "the archive bytes with the binary pattern set only; warn-level/entropy "
              "checks did not run per member."
              % (os.path.basename(a.file), len(names),
                 ", rubric.json with %d criteria" % len(rubric) if rubric else ""),
              file=sys.stderr)
    if METHOD_TAG in tags:
        cats = [t for t in tags if t.startswith(CATEGORY_TAG_PREFIX)]
        if not cats:
            print("warning: tagged %r but no %s<slug> tag — a method nobody can find by "
                  "category is a method nobody converges on." % (METHOD_TAG, CATEGORY_TAG_PREFIX),
                  file=sys.stderr)
        for t in cats:
            slug = t[len(CATEGORY_TAG_PREFIX):]
            if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", slug):
                sys.exit("error: category tag %r must be a kebab-case slug "
                         "(e.g. category:crypto-protocol)" % t)
        if not (a.title or "").startswith("Method:"):
            print("warning: method skills conventionally take the title prefix `Method:` "
                  "(mirrors `Skill:` / `Comparator:`) so listings separate procedure from "
                  "tooling.", file=sys.stderr)
        if not is_bundle and rubric is None:
            print("warning: a method published as a bare script carries no rubric; ship a "
                  "SKILL.md bundle with rubric.json if instances should be judged against "
                  "shared criteria.", file=sys.stderr)
    elif rubric is not None:
        print("warning: bundle carries a rubric.json but is not tagged %r — the rubric is "
              "recorded, but `list --category`/`collection show` will not treat it as a "
              "method." % METHOD_TAG, file=sys.stderr)
    return rubric


def _lint_applies_links(a):
    """`applies:` must point at a skill. Absent targets are allowed (lazy replication)
    but named, so a typo does not silently become an unresolvable claim."""
    for spec in a.link or []:
        rel, _, dst = spec.partition(":")
        if rel != APPLIES_REL or not dst:
            continue
        tm = load_manifest(dst, missing_ok=True)
        if tm is None:
            print("warning: applies:%s — target is not held locally; the claim is recorded "
                  "but cannot be checked here." % dst, file=sys.stderr)
            continue
        if tm.get("type") != "skill":
            sys.exit("error: applies:%s names a %s; `applies` says \"I followed this method\" "
                     "and a method is a skill. For evidence use cites/supports; for "
                     "membership use part-of." % (dst, tm.get("type")))
        if not is_method_skill(tm):
            print("warning: applies:%s — target skill is not tagged %r; recorded, but it will "
                  "not appear as a method in category views." % (dst, METHOD_TAG),
                  file=sys.stderr)


def _latest_announce_for(signer_addr):
    """Return this signer's last locally recorded announce in ledger order."""
    latest = None
    for event, _path in read_ledger_entries():
        event_id = event.get("id") or ""
        if (event.get("addr") or "").lower() != signer_addr.lower():
            continue
        if event.get("action") not in ("publish", "republish") or not event_id.startswith("pa-"):
            continue
        if not event.get("sig"):
            continue
        valid, _recovered = verify_entry(event, event["sig"], signer_addr)
        if not valid:
            continue
        manifest = load_manifest(event_id, missing_ok=True)
        if not manifest or manifest.get("type") != "peer-announce":
            continue
        try:
            with open(blob_read_path_at(STORE, manifest["content"]["sha256"])) as f:
                spec = json.load(f)
        except (OSError, ValueError, KeyError):
            continue
        if (spec.get("announcer") or "").lower() == signer_addr.lower():
            latest = manifest
    return latest


def cmd_announce(a):
    if not signing_key_path():
        sys.exit("error: commons announce requires COMMONS_SIGNING_KEY")
    signer_addr, _sig = sign_entry({"action": "whoami", "agent": a.agent,
                                    "id": "-", "sha256": "-", "ts": now()})
    previous = _latest_announce_for(signer_addr)

    refreshed_ts = int(time.time())
    if previous:
        try:
            with open(blob_read_path(previous["content"]["sha256"])) as f:
                old_refreshed = parse_ts(json.load(f).get("refreshed"))
            if old_refreshed is not None:
                refreshed_ts = max(refreshed_ts, old_refreshed + 1)
        except (OSError, ValueError, KeyError):
            pass
    refreshed = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(refreshed_ts))
    expires = time.strftime("%Y-%m-%dT%H:%M:%SZ",
                            time.gmtime(refreshed_ts + parse_duration(a.expires_in)))

    remotes = []
    for url in a.remote_url or []:
        remote = {"url": url}
        if a.note:
            remote["note"] = a.note
        remotes.append(remote)

    hosts = {}
    for value in a.hosts or []:
        collection, sep, policy = value.partition(":")
        hosts[collection] = policy if sep else "all"
    if a.hosts_from_local:
        for event, _path in read_ledger_entries():
            if (event.get("addr") or "").lower() != signer_addr.lower():
                continue
            aid = event.get("id") or ""
            if event.get("action") in ("publish", "republish") and aid.startswith("cl-"):
                manifest = load_manifest(aid, missing_ok=True)
                if manifest and manifest.get("type") == "collection":
                    hosts.setdefault(aid, "all")

    announce = {
        "announcer": signer_addr,
        "remotes": remotes,
        "hosts": [{"collection": collection, "blobs": policy}
                  for collection, policy in sorted(hosts.items())],
        "refreshed": refreshed,
        "expires": expires,
    }
    ensure_dirs()
    fd, path = tempfile.mkstemp(prefix="announce-", suffix=".json", dir=ROOT)
    try:
        with os.fdopen(fd, "w") as f:
            json.dump(announce, f, indent=2, sort_keys=True)
            f.write("\n")
        publish_args = argparse.Namespace(
            type="peer-announce", file=path, title="Peer reachability announcement",
            description="Signed reachability and collection-hosting hints", tag=[],
            input=[], workflow=None, link=(["supersedes:" + previous["id"]]
                                          if previous else []),
            tier=None, criteria=None, param=[], license=None, allow_secrets=False,
            force=False, agent=a.agent)
        cmd_publish(publish_args)
    finally:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass


def cmd_get(a):
    print(json.dumps(load_manifest(a.id), indent=2, sort_keys=True))


def cmd_cat(a):
    m = load_manifest(a.id)
    with open(blob_read_path(m["content"]["sha256"]), "rb") as f:
        sys.stdout.buffer.write(f.read())


def cmd_export(a):
    m = load_manifest(a.id)
    dst = a.out or m["content"]["filename"]
    shutil.copyfile(blob_read_path(m["content"]["sha256"]), dst)
    print(dst)


def _fmt_row(m):
    # Availability rides in the title column rather than as a fifth fixed column: it is
    # meaningful for exactly one type, so a permanent mostly-blank column would cost
    # every row's width to serve datasets. `?` = undeclared, which is not `open`.
    avail = availability_display(m)
    title = m.get("title", "")
    # Freshness rides in the same column for the same reason, and to the right of
    # availability so the existing dataset marker stays in the position readers and
    # greps already know. `obs` is the signed observation time, `pub` the publisher's
    # self-declared one — never conflated, never omitted silently.
    age = age_display(m)
    if age:
        title = "[%s] %s" % (age, title)
    if avail:
        title = "[%s] %s" % (avail, title)
    return "%-14s %-12s %-8s %-10s %s" % (m["id"], m["type"], m.get("agent", "?"),
                                          tier_display(m), title)


def superseders_map():
    """dst artifact id -> sorted ids of locally-held manifests that supersede it.

    Front-door disambiguation (2026-08-22 namespace-admission note, Option B): a
    retired artifact (e.g. a collection replaced during a key rotation) still
    browses with equal standing to its replacement unless something says otherwise.
    Built once per invocation rather than per-row — `_peer_suggestion_report`
    (L5502-ish) already does the analogous set-build for announce tips; this is
    the same idea applied to the general browse path, at the same read-only cost
    (one manifest scan) regardless of how many rows call it.
    """
    out = {}
    for m2 in iter_manifests():
        for link in m2.get("links") or []:
            if isinstance(link, dict) and link.get("rel") == "supersedes" and link.get("id"):
                out.setdefault(link["id"], []).append(m2["id"])
    return {k: sorted(v) for k, v in out.items()}


def verified_agent_of(m):
    """The peer-registry agent name behind the artifact's first signed publish, or None.

    `m.get("agent")` is a self-asserted manifest field the publisher can set to
    anything (including leaving it at the literal default "unknown"). This is the
    same signed-publisher resolution `collection show` already does for its
    "curated by" line, exposed here so the cheap list/search browse surfaces can
    flag when the two disagree instead of silently repeating the unsigned string.
    """
    fp = first_publisher(m["id"])
    if not fp:
        return None
    peer = find_peer(fp[0])
    return (peer or {}).get("agent")


def _json_row(m, smap=None):
    row = {"id": m["id"], "type": m["type"], "tier": tier_display(m),
           "agent": m.get("agent", "?"), "created": m.get("created", ""),
           "title": m.get("title", "")}
    if m.get("type") == "dataset":
        # Explicit null rather than an absent key: a consumer must be able to tell
        # "undeclared" from "this build predates the field" without guessing.
        row["obtainability"] = availability_of(m)
        row["license"] = m.get("license")
    # Absolute, never the rendered age: `--json` output must not change just because
    # time passed. `created` is already here, so this is the signed counterpart —
    # explicit null when nobody has attested, for the same reason as `obtainability`.
    row["observed"] = observed_of(m)
    # Additive fields only (2026-08-28, collection front-door disambiguation,
    # Option B conservative form): existing keys and the default TABLE output are
    # both untouched, so a consumer keying off known fields sees no change.
    smap = smap if smap is not None else superseders_map()
    row["superseded_by"] = smap.get(m["id"], [])
    verified_agent = verified_agent_of(m)
    row["verified_agent"] = verified_agent
    row["agent_mismatch"] = bool(verified_agent) and verified_agent != m.get("agent")
    return row


# FTS5 treats `-`, `:`, `.`, `/` and friends as syntax, so a perfectly ordinary query
# like `claim-efficiency` parses as a column filter and raises "no such column".
# The registry is FULL of hyphenated terms (claim-efficiency, re-derivation, artifact
# ids), so the naive path is a traceback on the most natural query anyone would type.
_FTS_OPERATORS = {"AND", "OR", "NOT", "NEAR"}


def fts_query(q, exact=False):
    """Make a human query safe for FTS5 without taking away real query syntax.

    Bare terms get quoted (so `claim-efficiency` is a phrase, which is what a person
    means). Explicit operators, quoted phrases, and prefix `*` are passed through, so
    someone who knows FTS5 keeps it.
    """
    if exact:
        return '"%s"' % q.replace('"', '""')
    if '"' in q:
        return q  # the caller is writing phrase syntax deliberately
    out = []
    for tok in q.split():
        if tok in _FTS_OPERATORS or tok.endswith("*"):
            out.append(tok); continue
        if re.fullmatch(r"[A-Za-z0-9_]+", tok):
            out.append(tok); continue
        out.append('"%s"' % tok.replace('"', '""'))
    return " ".join(out) or '""'


def cmd_search(a):
    con = read_index_conn()
    q = " ".join(a.query)
    sql = "SELECT id FROM art_fts WHERE art_fts MATCH ?"
    args = [fts_query(q, a.exact)]
    try:
        rows = list(con.execute(sql + " ORDER BY rank", args))
    except sqlite3.OperationalError as e:
        # Still possible if the user hand-wrote broken FTS syntax. Report it as a query
        # problem rather than a stack trace, which reads like a corrupt index.
        con.close()
        sys.exit("error: could not parse the search query %r (%s).\n"
                 "       Try --exact to search it as a literal phrase." % (q, e))
    con.close()
    # --tips-only is opt-in (2026-08-28 front-door disambiguation, conservative form):
    # default stdout stays byte-identical unless a human asks for it.
    smap = superseders_map() if getattr(a, "tips_only", False) else None
    n = 0
    for (aid,) in rows:
        m = load_manifest(aid)
        if a.type and m["type"] != a.type: continue
        if a.by and m.get("agent") != a.by: continue
        if a.tier and tier_display(m) != a.tier: continue
        if smap is not None and smap.get(aid): continue
        print(_fmt_row(m)); n += 1
    if n == 0: print("(no matches)", file=sys.stderr); sys.exit(1)


def cmd_list(a):
    ensure_read_index()
    rows = []
    category = getattr(a, "category", None)
    if category is not None:
        # Sugar over tag filtering (analysis templates, stage 2): `--category X` means
        # "methods for category X", i.e. skills tagged methodology + category:X.
        # `--category ''` lists every method regardless of category.
        if a.type and a.type != "skill":
            sys.exit("error: --category lists method skills; it cannot combine with "
                     "--type %s" % a.type)
    for fn in sorted(os.listdir(ART)):
        if not fn.endswith(".json"): continue
        with open(os.path.join(ART, fn)) as f: m = json.load(f)
        if a.type and m["type"] != a.type: continue
        if a.by and m.get("agent") != a.by: continue
        if a.tier and tier_display(m) != a.tier: continue
        if category is not None:
            if not is_method_skill(m): continue
            if category and category not in method_categories(m): continue
        rows.append(m)
    rows.sort(key=lambda m: (m.get("created", ""), m["id"]))
    # --tips-only: opt-in exclusion of rows a locally-held manifest supersedes
    # (2026-08-28 front-door disambiguation). Filtered BEFORE --after/--limit so
    # pagination cursors stay meaningful over the filtered set, same as --type/--by.
    if getattr(a, "tips_only", False):
        smap = superseders_map()
        rows = [m for m in rows if not smap.get(m["id"])]
    if a.after:
        try:
            pos = next(i for i, m in enumerate(rows) if m["id"] == a.after)
        except StopIteration:
            sys.exit("error: --after cursor is not in this listing: %s" % a.after)
        rows = rows[pos + 1:]
    if a.limit is not None:
        if a.limit < 1: sys.exit("error: --limit must be at least 1")
        rows = rows[:a.limit]
    if a.json:
        smap = superseders_map()
        out = [_json_row(m, smap) for m in rows]
        if category is not None:
            ab = applied_by_index()
            for row, m in zip(out, rows):
                row["categories"] = method_categories(m)
                row["applied_by"] = ab.get(m["id"], [])
                row["rubric_criteria"] = len(method_rubric(m) or [])
        print(json.dumps(out, indent=2, sort_keys=True))
    else:
        if category is not None:
            ab = applied_by_index()
            for m in rows:
                print("%s  applied by %d  category:%s%s"
                      % (_fmt_row(m), len(ab.get(m["id"], [])),
                         ",".join(method_categories(m)) or "-",
                         "  rubric:%d" % len(method_rubric(m)) if method_rubric(m) else ""))
        else:
            for m in rows: print(_fmt_row(m))
        print("total: %d" % len(rows), file=sys.stderr)


def cmd_rubric(a):
    """Print a method's pinned rubric as task-ready JSON.

    The output is exactly what a beneficiary pastes into
    `verification.criteria_list` (or lets `publish task --method` copy), so two
    categories' instance-tasks replicate on the same verdict-vector shape.
    """
    m = load_manifest(a.id)
    if m.get("type") == "task":
        spec = task_spec(m)
        src = spec.get("method")
        cl = (spec.get("verification") or {}).get("criteria_list")
        if not cl:
            sys.exit("error: %s declares no enumerated rubric" % a.id)
        print(json.dumps({"method": src, "criteria_list": cl}, indent=2, sort_keys=True))
        return
    if m.get("type") != "skill":
        sys.exit("error: %s is a %s; rubrics live on method skills (and the tasks that "
                 "copied them)" % (a.id, m.get("type")))
    cl = method_rubric(m)
    if not cl:
        sys.exit("error: %s carries no rubric. A method's rubric ships as %s inside its "
                 "SKILL.md bundle (see README.md §Analysis templates)."
                 % (a.id, BUNDLE_RUBRIC_MEMBER))
    ab = applied_by_index().get(a.id, [])
    print(json.dumps({"method": a.id, "sha256": m["content"]["sha256"],
                      "categories": method_categories(m), "applied_by": ab,
                      "criteria_list": cl}, indent=2, sort_keys=True))


def cmd_links(a):
    # Resolve first: without this, a typo'd id prints "outbound:/inbound:" with nothing
    # under either and exits 0 — indistinguishable from an artifact that genuinely has
    # no links, which is the answer a newcomer is most likely to be wrong about.
    # `graph` already reports MISSING; this makes the two agree.
    load_manifest(a.id)
    con = read_index_conn()
    print("outbound:")
    for src, rel, dst in con.execute("SELECT src,rel,dst FROM links WHERE src=?", (a.id,)):
        print("  %s -> %s [%s]" % (src, dst, rel))
    print("inbound:")
    for src, rel, dst in con.execute("SELECT src,rel,dst FROM links WHERE dst=?", (a.id,)):
        print("  %s <- %s [%s]" % (dst, src, rel))
    con.close()


def _dir_bytes(path):
    total = 0
    for root, _dirs, files in os.walk(path):
        for fn in files:
            try: total += os.path.getsize(os.path.join(root, fn))
            except OSError: pass
    return total


# Host variables a native run may see. Everything else is scrubbed, because an
# undeclared host variable is an undeclared input: it can change the output bytes
# while leaving provenance identical, so the publisher gets PASS and every stranger
# gets FAIL. Sandbox mode has always passed only the spec's env; native mode used to
# inherit os.environ wholesale, which made the two modes disagree about what the
# result was relative to. PATH/HOME are the irreducible minimum for finding an
# interpreter on an unpinned host; they are recorded in the exec record, not trusted.
NATIVE_ENV_PASSTHROUGH = ("PATH", "HOME")


def native_env(spec):
    """The exact environment a native run gets: passthrough minimum + declared env."""
    env = {k: os.environ[k] for k in NATIVE_ENV_PASSTHROUGH if k in os.environ}
    env.update(spec.get("env", {}))
    return env


def _run_native(scratch, spec, env, timeout):
    interp = spec.get("interpreter", "bash")
    script = "\n".join(["set -euo pipefail"] + spec.get("steps", []))
    return subprocess.run([interp, "-c", script], cwd=scratch, env=env,
                          capture_output=True, text=True, timeout=timeout)


def _run_sandboxed(scratch, spec, timeout, image, policy):
    """Isolated execution: no network, read-only rootfs, capped memory/cpu/pids.

    The container sees the scratch dir as /work and writes outputs to /work/out,
    so behaviour is identical to native modulo isolation and userland.
    """
    lim = policy.get("limits") or {}
    interp = spec.get("interpreter", "bash")
    script = "\n".join(["set -euo pipefail"] + spec.get("steps", []))
    cmd = [container_cmd(), "run", "--rm",
           "--network=none",
           "--memory=%s" % lim.get("memory", "2g"),
           "--cpus=%s" % lim.get("cpus", "2"),
           "--pids-limit=%d" % int(lim.get("pids", 256)),
           "--read-only",
           "--tmpfs", "/tmp:rw,exec,size=%s" % lim.get("tmpfs_size", "256m"),
           "-v", "%s:/work:rw" % scratch,
           "-w", "/work"]
    # Only the spec's declared env crosses the boundary — never the host environment.
    sandbox_env = dict(spec.get("env", {}))
    sandbox_env["OUT_DIR"] = "/work/out"
    for name, aid in (spec.get("inputs") or {}).items():
        sandbox_env["IN_" + name] = "/work/" + os.path.basename(aid)
    for k, v in sorted(sandbox_env.items()):
        cmd += ["-e", "%s=%s" % (k, v)]
    cmd += [image, interp, "-c", script]
    return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)


def _run_workflow(wf_id, override_inputs=None, exec_mode=None, force_sandbox=False):
    """Execute workflow.

    Returns (outputs: name->tmp path, spec, scratch dir, wf manifest, exec record).
    The exec record is the environment parameter the result is relative to.
    """
    wm = load_manifest(wf_id)
    if wm["type"] != "workflow": sys.exit("error: %s is not a workflow" % wf_id)
    with open(blob_read_path(wm["content"]["sha256"])) as f: spec = json.load(f)

    mode = "sandbox" if force_sandbox else resolve_exec_mode(exec_mode)
    policy = load_exec_policy()
    image = digest = None
    if mode == "sandbox":
        image = spec.get("image") or policy.get("default_image")
        check_image_allowed(image, policy)
        digest = image_digest(image)
    elif spec.get("image"):
        # A spec naming an image is asking for a pinned userland; honouring it
        # natively would silently give it a different one.
        sys.exit("error: workflow %s declares image %r but exec mode is native.\n"
                 "       Re-run with --exec sandbox (or COMMONS_EXEC=sandbox)."
                 % (wf_id, spec["image"]))

    scratch = tempfile.mkdtemp(prefix="commons-run-")
    out_dir = os.path.join(scratch, "out"); os.makedirs(out_dir)
    # Native runs get a scrubbed environment (see native_env): an undeclared host
    # variable is an undeclared input, and only the publisher would have it.
    env = native_env(spec)
    env["OUT_DIR"] = out_dir
    # materialize inputs
    for name, aid in (spec.get("inputs") or {}).items():
        if override_inputs and name in override_inputs:
            digest_in = override_inputs[name]
        else:
            digest_in = load_manifest(aid)["content"]["sha256"]
        src = blob_read_path(digest_in)
        if not os.path.exists(src):
            sys.exit("error: missing blob for input %s (%s)" % (name, digest_in[:12]))
        im = load_manifest(aid)
        # In sandbox mode the container path is derived from the artifact id, so the
        # in-container filename can't depend on host-side manifest metadata.
        fname = os.path.basename(aid) if mode == "sandbox" else im["content"]["filename"]
        dst = os.path.join(scratch, fname)
        shutil.copyfile(src, dst)
        env["IN_" + name] = dst
    # materialize attachments
    for fname, body in (spec.get("attachments") or {}).items():
        with open(os.path.join(scratch, fname), "w") as f: f.write(body)

    timeout = int(spec.get("timeout", 600))
    try:
        if mode == "sandbox":
            r = _run_sandboxed(scratch, spec, timeout, image, policy)
        else:
            r = _run_native(scratch, spec, env, timeout)
    except subprocess.TimeoutExpired:
        shutil.rmtree(scratch, ignore_errors=True)
        sys.exit("error: workflow %s exceeded its %ds timeout (%s mode)" % (wf_id, timeout, mode))
    if r.returncode != 0:
        sys.stderr.write(r.stdout + r.stderr)
        shutil.rmtree(scratch, ignore_errors=True)
        sys.exit("error: workflow %s failed (exit %d, %s mode)" % (wf_id, r.returncode, mode))

    cap = int((load_exec_policy().get("limits") or {}).get("max_output_bytes", 1 << 30))
    written = _dir_bytes(scratch)
    if written > cap:
        shutil.rmtree(scratch, ignore_errors=True)
        sys.exit("error: workflow %s wrote %d bytes, exceeding the %d-byte cap"
                 % (wf_id, written, cap))

    outputs = {}
    for name, rel in (spec.get("outputs") or {}).items():
        p = os.path.join(out_dir, rel)
        if not os.path.exists(p): sys.exit("error: declared output missing: %s" % rel)
        outputs[name] = p
    return outputs, spec, scratch, wm, exec_record(mode, image, digest)


def _spec_verification(spec):
    """Workflow specs may declare their own tier: {"tier":"T1","comparator":"sk-…"}."""
    tier = spec.get("tier", "T0")
    if tier not in TIER_RANK:
        sys.exit("error: workflow spec declares unknown tier %r" % tier)
    if tier == "T0":
        return {"tier": "T0"}
    if tier == "T1":
        comp = spec.get("comparator")
        if not comp:
            sys.exit("error: workflow spec declares tier T1 but no \"comparator\": sk-…")
        v = {"tier": "T1", "criteria": comp}
        if spec.get("comparator_params"): v["params"] = spec["comparator_params"]
        return v
    sys.exit("error: workflow specs may only declare tier T0 or T1 (got %s); "
             "judged/attested artifacts are published with `commons publish --tier`" % tier)


def cmd_run(a):
    outputs, spec, scratch, wm, execrec = _run_workflow(a.id, exec_mode=getattr(a, "exec", None))
    verification = _spec_verification(spec)
    if a.publish:
        for name, path in outputs.items():
            digest = store_blob(path)
            aid = "%s-%s" % (TYPES[a.publish_type], digest[:8])
            m = {"schema": SCHEMA,
                 "id": aid, "type": a.publish_type,
                 "title": a.title or "%s output: %s" % (wm["title"], name),
                 "description": "Generated by workflow %s" % a.id,
                 "tags": wm.get("tags", []), "agent": a.agent, "created": now(),
                 "content": {"sha256": digest, "filename": os.path.basename(path),
                             "bytes": os.path.getsize(path)},
                 "verification": verification,
                 "provenance": {
                     "inputs": [{"id": iid, "sha256": load_manifest(iid)["content"]["sha256"]}
                                for iid in (spec.get("inputs") or {}).values()],
                     "workflow": {"id": a.id, "sha256": wm["content"]["sha256"]},
                     "run": {"finished": now(), "env": spec.get("env", {}),
                             "exec": execrec}},
                 "links": [{"rel": "derives", "id": a.id}]}
            ev_exec = {"exec_mode": execrec["mode"],
                       **({"image_digest": execrec["image_digest"]}
                          if execrec.get("image_digest") else {})}
            prior = load_manifest(aid, missing_ok=True)
            _guard_manifest_collision(aid, m)
            if prior is not None:
                # Content-addressed: identical bytes, so this is the same artifact. Keep
                # the original manifest (first-writer-wins) instead of clobbering its
                # exec record — and if the environment differed, that is a *stronger*
                # claim (reproduced across userlands), so record it in the ledger.
                prior_exec = recorded_exec(prior)
                if not exec_equivalent(prior_exec, execrec):
                    ledger_append({"agent": a.agent, "action": "reproduced-cross-env",
                                   "id": aid, "sha256": digest,
                                   "tier": verification["tier"],
                                   "recorded_exec": prior_exec.get("mode"), **ev_exec})
                    print("%s  %s  (already published; also reproduced under %s)"
                          % (aid, name, fmt_exec(execrec)))
                else:
                    print("%s  %s  (already published; unchanged)" % (aid, name))
                continue
            commit_signed_publish(aid, m, {"agent": a.agent, "action": "publish",
                                           "id": aid, "sha256": digest,
                                           "tier": verification["tier"], **ev_exec},
                                  False)
            print("%s  %s" % (aid, name))
    else:
        for name, path in outputs.items():
            dst = os.path.join(a.out or ".", os.path.basename(path))
            shutil.copyfile(path, dst)
            print("%s  %s" % (name, dst))
    shutil.rmtree(scratch, ignore_errors=True)


def unobtainable_inputs(m):
    """Provenance inputs an independent party could not acquire, worst case first.

    Only datasets can be unobtainable — a derived artifact's bytes travel with it.
    Undeclared counts as unknown, NOT as open: silence is precisely what this reports.
    """
    out = []
    for i in ((m.get("provenance") or {}).get("inputs") or []):
        im = load_manifest(i.get("id", ""), missing_ok=True)
        if im is None or im.get("type") != "dataset":
            continue
        obt = availability_of(im)
        if obt == "restricted":
            out.append((im["id"], "restricted"))
        elif obt is None:
            out.append((im["id"], "undeclared"))
    return sorted(out, key=lambda p: (p[1] != "restricted", p[0]))


def task_input_availability(spec):
    """A task's own declared dataset inputs, split by obtainability.

    Mirrors _chain_availability's restricted/undeclared split, but reads a task's
    `inputs` field directly rather than walking a result's provenance chain — a task
    has not run yet, so there is nothing to walk. Same posture as everywhere else
    availability is surfaced: advisory only, never a gate, never an exit code.
    """
    restricted, undeclared = [], []
    for i in (spec.get("inputs") or []):
        if not isinstance(i, dict) or not i.get("id"):
            continue
        im = load_manifest(i["id"], missing_ok=True)
        if im is None or im.get("type") != "dataset":
            continue
        obt = availability_of(im)
        if obt == "restricted":
            restricted.append(i["id"])
        elif obt is None:
            undeclared.append(i["id"])
    return sorted(set(restricted)), sorted(set(undeclared))


def task_availability_marker(spec):
    """One-token browse-time marker for queue/task rows — same bracket convention as
    `_fmt_row`'s dataset marker, so a newcomer scanning either surface reads the same
    shorthand. Restricted outranks undeclared; open/no-dataset-inputs prints nothing.
    """
    restricted, undeclared = task_input_availability(spec)
    if restricted: return "  [restricted input]"
    if undeclared: return "  [undeclared input]"
    return ""


def print_availability(m, indent="  "):
    """Availability disclosure for a dataset. Advisory: never touches an exit code.

    Same posture as warn_anchor_drift — availability changes who can check a result,
    not what was checked, so it must never move a tier, a grade, or a status code.
    """
    if m.get("type") != "dataset":
        return
    avail = m.get("availability") or {}
    obt = avail.get("obtainability")
    if not obt:
        print("%savailability: UNDECLARED — the publisher did not state whether an"
              % indent)
        print("%s              independent peer can acquire these bytes." % indent)
        return
    print("%savailability: %s — %s" % (indent, obt, OBTAINABILITY_MEANING[obt]))
    if avail.get("source"):
        print("%s  source    : %s" % (indent, avail["source"]))


def print_ingest_unchecked(aid, indent="  "):
    """Say when a collection's ingest policy was skipped for this artifact.

    Disclosure, never grading: it moves no tier, no chain grade and no exit code. A
    reader deciding whether to trust these bytes should know that a policy the collection
    declared was not applied to them, and the publisher chose to say so.
    """
    skipped = ingest_unchecked_for(aid)
    if not skipped:
        return
    print("%singest    : policy NOT applied for %s (published with "
          "--allow-unchecked-ingest)" % (indent, ", ".join(skipped)))


def cmd_verify(a):
    m = load_manifest(a.id)
    tier = tier_of(m)
    v = m.get("verification") or {}
    criteria = v.get("criteria")

    # --- T2/T3: not machine-verifiable; print the guarantee and say so ---
    if tier in ("T2", "T3"):
        print("NOT-MACHINE-VERIFIABLE: %s is tier %s" % (a.id, tier_label(tier)))
        print("  guarantee: %s" % TIER_GUARANTEE[tier])
        print("  criteria : %s" % (criteria or "(none declared)"))
        print_availability(m)
        print_ingest_unchecked(a.id)
        if tier == "T2":
            print("  verify by: independent review against the criteria above (rubric declared pre-claim)")
        else:
            state, detail = check_attestation(m)
            print("  attester : %s — %s" % (state.upper(), detail))
            print("  verify by: checking the signer's attestation and the raw capture format")
            if state in ("invalid", "stale"):
                # The one machine-checkable part of T3 failed, so this is a real FAIL.
                ledger_append({"agent": a.agent, "action": "verify-fail", "id": a.id,
                               "sha256": m["content"]["sha256"], "tier": tier,
                               "reason": "attestation-" + state})
                sys.exit("FAIL: %s attestation is %s" % (a.id, state))
        sys.exit(EX_NOT_MACHINE_VERIFIABLE)

    prov = m.get("provenance") or {}
    wf = prov.get("workflow")
    if not wf:
        print("UNVERIFIED: %s has no provenance.workflow (tier %s)" % (a.id, tier_label(tier)))
        print("  guarantee: %s" % TIER_GUARANTEE[tier])
        sys.exit(EX_UNVERIFIED)

    wm = load_manifest(wf["id"])
    if wm["content"]["sha256"] != wf["sha256"]:
        sys.exit("FAIL: workflow %s content hash changed vs provenance record" % wf["id"])

    # Local store integrity: a PASS must mean "the bytes you can `cat` are the
    # bytes that re-derive" — otherwise a tampered blob hides behind a clean re-run.
    target = m["content"]["sha256"]
    stored = blob_read_path(target)
    if not os.path.exists(stored):
        sys.exit("FAIL: stored blob for %s is missing (%s)" % (a.id, target[:12]))
    if sha256_file(stored) != target:
        ledger_append({"agent": a.agent, "action": "verify-fail", "id": a.id,
                       "sha256": target, "tier": tier})
        sys.exit("FAIL: stored blob for %s does not match its manifest hash "
                 "(local tampering/corruption — run fsck)" % a.id)

    with open(blob_read_path(wm["content"]["sha256"])) as f: spec = json.load(f)
    recorded = {i["id"]: i["sha256"] for i in prov.get("inputs", [])}
    overrides = {}
    for name, aid in (spec.get("inputs") or {}).items():
        if aid in recorded: overrides[name] = recorded[aid]
    rec_exec = recorded_exec(m)
    outputs, spec, scratch, _, att_exec = _run_workflow(
        wf["id"], override_inputs=overrides, exec_mode=getattr(a, "exec", None))
    same_env = exec_equivalent(rec_exec, att_exec)
    try:
        # --- T0: byte-identical re-derivation ---
        if tier != "T1":
            ok = any(sha256_file(p) == target for p in outputs.values())
            detail = ""
        # --- T1: equivalence under the declared comparator ---
        else:
            if not criteria or not criteria.startswith("sk-"):
                sys.exit("FAIL: %s is tier T1 but declares no comparator skill id" % a.id)
            ok, detail = False, ""
            for p in outputs.values():
                if sha256_file(p) == target:
                    ok, detail = True, "byte-identical (comparator not needed)"
                    break
                good, out = run_comparator(criteria, stored, p, v.get("params"),
                                           exec_mode=att_exec["mode"])
                if good:
                    ok, detail = True, "equivalent under %s%s" % (criteria, (": " + out) if out else "")
                    break
                detail = out
    finally:
        shutil.rmtree(scratch, ignore_errors=True)

    ev = {"agent": a.agent, "id": a.id, "sha256": target, "tier": tier,
          "exec_mode": att_exec["mode"]}
    if att_exec.get("image_digest"): ev["image_digest"] = att_exec["image_digest"]

    if ok:
        ledger_append(dict(ev, action="verify-pass"))
        if tier == "T1":
            print("PASS: %s re-derived from %s — %s" % (a.id, wf["id"], detail))
        else:
            print("PASS: %s reproduced byte-identically from %s" % (a.id, wf["id"]))
        print("  environment: %s" % fmt_exec(att_exec))
        if not same_env:
            # Reproduced despite a different userland: strictly stronger evidence.
            print("  note: recorded environment was %s — result is environment-independent"
                  % fmt_exec(rec_exec))
        # A PASS over data nobody else can obtain is a true statement that reads as a
        # stronger one. Say the quiet part: it reproduced HERE, and no independent party
        # can run this check. Advisory only — the exit code stays 0, because the
        # computation genuinely did reproduce.
        blocked = unobtainable_inputs(m)
        if blocked:
            print("  caution: this result reproduced, AND no independent party can re-run it:")
            for iid, why in blocked:
                print("    %s  input availability %s" % (iid, why))
            print("    Reproducibility only one party can exercise is not independent")
            print("    replication. The PASS is about the computation, not the evidence base.")
        return

    # Byte mismatch. Distinguish "wrong answer" from "question asked in the wrong place".
    if not same_env:
        ledger_append(dict(ev, action="verify-env-mismatch",
                           recorded_exec=rec_exec.get("mode"),
                           attempted_exec=att_exec["mode"]))
        print("ENV-MISMATCH: %s did not reproduce, but was verified outside its "
              "recorded environment." % a.id)
        print("  recorded : %s" % fmt_exec(rec_exec))
        print("  attempted: %s" % fmt_exec(att_exec))
        print("  This is not a reproducibility failure — the question was asked in a")
        print("  different userland than the one the artifact's T0 claim refers to.")
        print("  Resolve with: commons rebaseline %s" % a.id)
        sys.exit(EX_ENV_MISMATCH)

    ledger_append(dict(ev, action="verify-fail"))
    if tier == "T1" and detail:
        print("comparator: %s" % detail, file=sys.stderr)
    print("  environment: %s (matches recorded)" % fmt_exec(att_exec), file=sys.stderr)
    sys.exit("FAIL: re-run of %s did not reproduce %s (tier %s)" % (wf["id"], a.id, tier))


def cmd_rebaseline(a):
    """Converge a pre-sandbox artifact onto a pinned userland.

    Three honest outcomes, no reversal:
      * bytes match under sandbox  -> stamp the exec record (metadata repair,
        content unchanged, so the id still holds)
      * bytes differ but sandbox is internally deterministic -> publish the
        sandbox-derived output as a superseding artifact; the native one stays
        as a legacy baseline
      * nondeterministic even within the sandbox -> a genuine workflow defect,
        surfaced rather than papered over
    """
    m = load_manifest(a.id)
    tier = tier_of(m)
    if tier not in ("T0", "T1"):
        sys.exit("error: rebaseline applies to machine-verified tiers (T0/T1); %s is %s"
                 % (a.id, tier))
    prov = m.get("provenance") or {}
    wf = prov.get("workflow")
    if not wf: sys.exit("error: %s has no provenance.workflow to re-run" % a.id)
    rec = recorded_exec(m)
    if rec.get("mode") == "sandbox" and not a.force:
        print("%s is already sandbox-baselined (%s); nothing to do" % (a.id, fmt_exec(rec)))
        return

    recorded_inputs = {i["id"]: i["sha256"] for i in prov.get("inputs", [])}
    with open(blob_read_path(load_manifest(wf["id"])["content"]["sha256"])) as f: spec = json.load(f)
    overrides = {name: recorded_inputs[aid]
                 for name, aid in (spec.get("inputs") or {}).items() if aid in recorded_inputs}

    target = m["content"]["sha256"]
    print("rebaselining %s" % a.id)
    print("  recorded : %s" % fmt_exec(rec))
    outputs, spec, scratch, wm, execrec = _run_workflow(
        wf["id"], override_inputs=overrides, force_sandbox=True)
    print("  attempted: %s" % fmt_exec(execrec))
    try:
        match = next((p for p in outputs.values() if sha256_file(p) == target), None)
        if match:
            m.setdefault("provenance", {}).setdefault("run", {})["exec"] = execrec
            m["provenance"]["run"]["rebaselined"] = now()
            write_manifest(a.id, m)
            ledger_append({"agent": a.agent, "action": "rebaseline", "id": a.id,
                           "sha256": target, "tier": tier, "result": "match",
                           "exec_mode": execrec["mode"],
                           **({"image_digest": execrec["image_digest"]}
                              if execrec.get("image_digest") else {})})
            print("MATCH: bytes identical under the pinned userland.")
            print("  stamped exec record; content unchanged, id still %s" % a.id)
            return

        # Differs. Is the sandbox itself deterministic? Run again and compare.
        first = {name: sha256_file(p) for name, p in outputs.items()}
        outputs2, _, scratch2, _, _ = _run_workflow(
            wf["id"], override_inputs=overrides, force_sandbox=True)
        try:
            second = {name: sha256_file(p) for name, p in outputs2.items()}
        finally:
            shutil.rmtree(scratch2, ignore_errors=True)
        if first != second:
            ledger_append({"agent": a.agent, "action": "rebaseline", "id": a.id,
                           "sha256": target, "tier": tier, "result": "nondeterministic",
                           "exec_mode": execrec["mode"]})
            print("NONDETERMINISTIC: two sandbox runs disagreed with each other.")
            print("  This is a genuine workflow defect, not a userland artifact.")
            print("  Fix %s (see the determinism checklist) or move the output to T1"
                  % wf["id"])
            sys.exit(EX_FAIL)

        print("DIVERGED: sandbox is internally deterministic but differs from the "
              "native baseline.")
        if not a.publish_superseding:
            print("  Nothing written. Re-run with --publish-superseding to publish the")
            print("  sandbox-derived output as a superseding artifact (the native one")
            print("  stays as a legacy baseline).")
            sys.exit(EX_ENV_MISMATCH)
        name, path = sorted(outputs.items())[0]
        newdigest = store_blob(path)
        newid = "%s-%s" % (TYPES[m["type"]], newdigest[:8])
        # Build fresh rather than copying: inheriting the old manifest would carry
        # over its links (e.g. derives) and, worse, its native exec record.
        new = {
            "schema": SCHEMA, "id": newid, "type": m["type"],
            "title": m.get("title", ""), "tags": m.get("tags", []),
            "created": now(), "agent": a.agent,
            "content": {"sha256": newdigest, "filename": os.path.basename(path),
                        "bytes": os.path.getsize(path)},
            "description": "Sandbox re-baseline of %s%s"
                           % (a.id, ": " + m["description"] if m.get("description") else ""),
            "verification": m.get("verification") or {"tier": tier},
            "provenance": {
                "inputs": prov.get("inputs", []),
                "workflow": wf,
                "run": {"finished": now(), "env": spec.get("env", {}), "exec": execrec,
                        "rebaseline_of": a.id}},
            "links": [{"rel": "supersedes", "id": a.id},
                      {"rel": "derives", "id": wf["id"]}],
        }
        # Sign BOTH events before the new manifest becomes visible (publish/sign
        # ordering fix, 2026-09-21): a signer failure must not strand `newid`.
        rb_entry = ledger_prepare({"agent": a.agent, "action": "rebaseline", "id": a.id,
                       "sha256": target, "tier": tier, "result": "superseded",
                       "superseded_by": newid, "exec_mode": execrec["mode"],
                       **({"image_digest": execrec["image_digest"]}
                          if execrec.get("image_digest") else {})})
        pub_entry = ledger_prepare({"agent": a.agent, "action": "publish", "id": newid,
                       "sha256": newdigest, "tier": tier, "exec_mode": execrec["mode"]})
        new_existed = os.path.exists(manifest_path(newid))
        publish_manifest(newid, new)
        try:
            ledger_commit(rb_entry)
            ledger_commit(pub_entry)
        except BaseException:
            if not new_existed:
                try: os.unlink(manifest_path(newid))
                except OSError: pass
            raise
        con = db_conn(); index_manifest(con, new); con.commit(); con.close()
        print("  published %s [supersedes %s]" % (newid, a.id))
        print("  %s remains as the pre-sandbox baseline" % a.id)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def cmd_attest(a):
    """Attach a signed attester identity to a T3 artifact.

    T3 says "a signer attests this one-time observation" — which is vacuous until the
    signer is named and the attestation is verifiable. This binds {id, sha256, criteria}
    to an address, so "attested" answers *attested by whom*.
    """
    m = load_manifest(a.id)
    tier = tier_of(m)
    if tier != "T3":
        sys.exit("error: attestation applies to tier T3 artifacts; %s is %s" % (a.id, tier))
    if not signing_key_path():
        sys.exit("error: COMMONS_SIGNING_KEY is not set — an unsigned attestation is "
                 "just prose, which the criteria field already holds")
    v = m.setdefault("verification", {"tier": "T3"})
    if a.criteria: v["criteria"] = a.criteria
    criteria = v.get("criteria") or DEFAULT_T3_CRITERIA
    if v.get("attested_by") and not a.force:
        sys.exit("error: %s is already attested by %s (use --force to re-attest)"
                 % (a.id, v["attested_by"]["addr"]))

    # The attestation statement is the claim being signed, in canonical form.
    stmt = {"attests": a.id, "sha256": m["content"]["sha256"],
            "criteria": criteria, "observed": validate_observed(a.observed)}
    msg = canonical(stmt)
    env = dict(os.environ)
    try:
        r = subprocess.run(["node", SIGN_JS, "--stdin"], input=msg,
                           capture_output=True, text=True, timeout=60, env=env)
    except (OSError, subprocess.SubprocessError) as e:
        sys.exit("error: cannot run the signer (%s)" % e)
    if r.returncode != 0:
        sys.exit("error: attestation signing failed: %s" % r.stderr.strip())
    out = json.loads(r.stdout)
    v["attested_by"] = {"addr": out["address"], "sig": out["signature"],
                        "statement": stmt}
    write_manifest(a.id, m)
    ledger_append({"agent": a.agent, "action": "attest", "id": a.id,
                   "sha256": m["content"]["sha256"], "tier": "T3"})
    print("%s attested by %s" % (a.id, out["address"]))
    peer = find_peer(out["address"])
    print("  registered as agent=%s trust=%s" % (peer.get("agent"), peer.get("trust"))
          if peer else "  (attester not in the local peer registry)")
    print("  observed: %s" % stmt["observed"])
    print("  criteria: %s" % criteria)


def check_attestation(m):
    """Verify a T3 attestation. Returns (state, detail).

    states: none | valid | invalid | unknown-signer | stale
    """
    v = m.get("verification") or {}
    att = v.get("attested_by")
    if not att: return "none", "no attester recorded"
    stmt = att.get("statement") or {}
    if stmt.get("sha256") != m["content"]["sha256"]:
        return "stale", "attestation covers different content than the manifest"
    # The attester signed a specific criteria string. If the manifest now says something
    # else, the signature is orphaned: it vouches for a claim no longer on display.
    current = v.get("criteria") or DEFAULT_T3_CRITERIA
    if stmt.get("criteria") != current:
        return "stale", ("attestation covers different criteria than the manifest "
                         "(signed: %r)" % (stmt.get("criteria") or "")[:60])
    msg = canonical(stmt)
    env = dict(os.environ, SIGNATURE=att.get("sig", ""), ADDRESS=att.get("addr", ""))
    try:
        r = subprocess.run(["node", VERIFY_JS, "--stdin"], input=msg,
                           capture_output=True, text=True, timeout=60, env=env)
        res = json.loads(r.stdout or "{}")
    except (OSError, subprocess.SubprocessError, ValueError):
        return "invalid", "could not run the verifier"
    if not res.get("valid"):
        return "invalid", "signature does not recover %s" % att.get("addr")
    peer = find_peer(att["addr"])
    if peer is None:
        return "unknown-signer", "valid signature from unregistered %s" % att["addr"]
    okw, why = key_valid_at(peer, stmt.get("observed"))
    if not okw:
        return "invalid", "key not valid at observation time: %s" % why
    return "valid", "attested by %s (agent=%s, observed %s)" % (
        att["addr"], peer.get("agent"), stmt.get("observed"))


def cmd_run_skill(a):
    """Blessed entry point for executing a fetched skill: always sandboxed.

    Consuming an artifact is code execution too. The convenient path must be the
    safe one, so this never runs natively regardless of COMMONS_EXEC.
    """
    m = load_manifest(a.id)
    if m["type"] != "skill":
        sys.exit("error: %s is a %s, not a skill" % (a.id, m["type"]))
    blob = blob_read_path(m["content"]["sha256"])
    if os.path.exists(blob) and bundle_members(blob) is not None:
        # A SKILL.md bundle is a procedure for an agent to read and follow, plus
        # helper scripts; there is no single entry point to exec. Executing the tar
        # bytes would just fail inside the sandbox with a confusing error.
        sys.exit("error: %s is a SKILL.md bundle (tar), not an executable script.\n"
                 "       export %s -o bundle.tar && tar -tf bundle.tar   # inspect\n"
                 "       commons rubric %s                              # its rubric\n"
                 "       Extract it, read SKILL.md, and run any helper scripts yourself "
                 "— sandboxed, as with any foreign code." % (a.id, a.id, a.id))
    policy = load_exec_policy()
    image = a.image or policy.get("default_image")
    check_image_allowed(image, policy)
    digest = image_digest(image)
    lim = policy.get("limits") or {}

    scratch = tempfile.mkdtemp(prefix="commons-skill-")
    try:
        fname = m["content"]["filename"] or (a.id + ".sh")
        dst = os.path.join(scratch, fname)
        shutil.copyfile(blob_read_path(m["content"]["sha256"]), dst)
        os.chmod(dst, 0o755)
        for extra in (a.file or []):
            if not os.path.isfile(extra): sys.exit("error: no such file: %s" % extra)
            shutil.copyfile(extra, os.path.join(scratch, os.path.basename(extra)))
        cmd = [container_cmd(), "run", "--rm",
               "--network=none",
               "--memory=%s" % lim.get("memory", "2g"),
               "--cpus=%s" % lim.get("cpus", "2"),
               "--pids-limit=%d" % int(lim.get("pids", 256)),
               "--read-only",
               "--tmpfs", "/tmp:rw,exec,size=%s" % lim.get("tmpfs_size", "256m"),
               "-v", "%s:/work:rw" % scratch, "-w", "/work",
               image, "/work/" + fname] + list(a.args or [])
        r = subprocess.run(cmd, timeout=int(a.timeout))
        ledger_append({"agent": a.agent, "action": "run-skill", "id": a.id,
                       "sha256": m["content"]["sha256"], "exec_mode": "sandbox",
                       "image_digest": digest, "exit": r.returncode})
        sys.exit(r.returncode)
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


# ---------------- capacity exchange ----------------
def task_spec(m):
    with open(blob_read_path(m["content"]["sha256"])) as f: return json.load(f)


def task_events(tid):
    """Signed lifecycle events for one task, oldest first, signature-checked.

    An event with a bad or unverifiable signature is dropped, not merely flagged:
    lifecycle state decides who may do what next, so an unauthenticated event must
    never be able to move it.
    """
    out = []
    for e, _path in read_ledger_entries():
        if e.get("task") != tid: continue
        if e.get("sig"):
            ok, _ = verify_entry(e, e["sig"], e.get("addr"))
            if not ok: continue
        out.append(e)
    return out


def task_state(m, at=None):
    """Fold the event log into current lifecycle state. No daemon, no stored status.

    Expiry is computed at read time, so a stalled claim reopens on its own without
    anything having to run on schedule.
    """
    tid = m["id"]
    spec = task_spec(m)
    nowt = at or time.time()
    events = task_events(tid)
    max_claims = spec.get("max_claims", 1)

    claims = {}        # addr -> claim record
    submissions = []   # {addr, result, ts}
    settled = None     # ("accepted"|"rejected", event)
    ben = ((spec.get("beneficiary") or {}).get("addr") or "").lower()

    for e in events:
        act, addr = e.get("action"), (e.get("addr") or "").lower()
        ts = parse_ts(e.get("ts")) or 0
        if act == "claim":
            ttl = e.get("claim_ttl") or DEFAULT_CLAIM_TTL
            try: secs = parse_duration(ttl)
            except SystemExit: secs = parse_duration(DEFAULT_CLAIM_TTL)
            claims[addr] = {"addr": e.get("addr"), "at": ts, "expires": ts + secs,
                            "ttl": ttl, "heartbeat": ts}
        elif act == "heartbeat" and addr in claims:
            claims[addr]["heartbeat"] = ts
        elif act == "release" and addr in claims:
            del claims[addr]
        elif act == "submit":
            submissions.append({"addr": e.get("addr"), "result": e.get("result"),
                                "ts": ts, "event": e})
        elif act in ("accept", "reject"):
            # Only the beneficiary settles. A non-beneficiary "accept" is not an error
            # to report here — it simply has no authority, so it changes nothing.
            if ben and addr == ben:
                settled = (act, e)

    active = {a: c for a, c in claims.items() if c["expires"] > nowt}
    expired = {a: c for a, c in claims.items() if c["expires"] <= nowt}

    task_expired = False
    exp_ts = parse_ts(spec.get("expires"))
    if exp_ts is not None and exp_ts <= nowt:
        task_expired = True

    if settled: state = settled[0] + "ed" if settled[0] == "accept" else "rejected"
    elif submissions: state = "submitted"
    elif active: state = "claimed"
    elif task_expired: state = "expired"
    else: state = "open"

    return {"id": tid, "spec": spec, "state": state, "claims": claims,
            "active": active, "expired_claims": expired, "submissions": submissions,
            "settled": settled, "max_claims": max_claims,
            "slots_free": max(0, max_claims - len(active)),
            "task_expired": task_expired, "beneficiary": ben, "events": events}


def result_family(rm):
    """Model family claimed by a T2 result, and whether it is attested.

    Self-reported family is ADVISORY ONLY. Diversity quorums re-monetize family
    claims (masquerade to fill a slot), so a family only counts toward a quorum when
    backed by attestation level receipt|tee.
    """
    gen = (rm or {}).get("generation") or {}
    fam = gen.get("model_family")
    level = gen.get("attestation", "self-reported")
    if level not in ATTESTATION_LEVELS: level = "self-reported"
    return fam, level, level in ("receipt", "tee")


_FIRSTPUB_CACHE = {"key": None, "map": None, "flags": None}
_LINES_CACHE = {"key": None, "rows": None}
_ANCHOR_CACHE = {"key": None, "map": None}

# An unanchored event has no provable upper bound on when it came into existence, so
# for ORDERING purposes it sorts after everything anchored. Not a penalty: an
# unanchored claim is simply unprovable, and "I had it first but never anchored it"
# must never outrank "here is a proof it existed by then".
UNANCHORED = float("inf")


def ledger_lines():
    """(entry, path, index, line_sha) for every ledger line, oldest-first per log.

    Anchors commit to a log HEAD (sha256 of its last line), so relating an event to an
    anchor needs the line hashes in order — which read_ledger_entries() throws away.
    """
    paths = ledger_files()
    key = tuple((p, os.path.getmtime(p), os.path.getsize(p))
                for p in paths if os.path.exists(p))
    if _LINES_CACHE["key"] == key:
        return _LINES_CACHE["rows"]
    rows = []
    for path in paths:
        with open(path, "rb") as f:
            idx = 0
            for raw in f:
                line = raw.rstrip(b"\n")
                if not line.strip(): continue
                try:
                    e = json.loads(line.decode())
                except (ValueError, UnicodeDecodeError):
                    idx += 1; continue
                rows.append((e, path, idx, hashlib.sha256(line).hexdigest()))
                idx += 1
    _LINES_CACHE["key"] = key
    _LINES_CACHE["rows"] = rows
    return rows


def anchor_bounds():
    """line_sha -> (bound_ts, quality): the earliest anchor proving a line existed.

    An anchor records each log's head hash, so it transitively covers every line up to
    and including that head. The earliest anchor covering a line is an authoritative
    UPPER bound on when that line was written — the one direction time anchoring can
    actually establish: a proof shows a line existed by then, never that it did not
    exist earlier.

    Quality matters as much as the number:
      bitcoin  — OTS proof confirmed into a block; third-party verifiable, and the
                 only quality that binds an ADVERSARIAL peer, since it cannot be
                 backdated by whoever wrote the log.
      local    — a checkpoint whose own timestamp is self-declared by the same peer.
                 Bounds an honest-but-sloppy peer; an adversary could backdate it too.
    """
    lines = ledger_lines()
    anchor_key = None
    if os.path.isdir(ANCHOR_DIR):
        anchor_key = tuple(sorted(
            (fn, os.path.getmtime(os.path.join(ANCHOR_DIR, fn)))
            for fn in os.listdir(ANCHOR_DIR) if fn.endswith(".json")))
    key = (id(lines), anchor_key)
    if _ANCHOR_CACHE["key"] == key:
        return _ANCHOR_CACHE["map"]

    # Per log: ordered line hashes, so a head hash locates a position.
    per_log = {}
    for _e, path, idx, lsha in lines:
        per_log.setdefault(os.path.basename(path), []).append(lsha)

    bounds = {}
    if os.path.isdir(ANCHOR_DIR):
        for fn in sorted(os.listdir(ANCHOR_DIR)):
            if not fn.endswith(".json"): continue
            try:
                with open(os.path.join(ANCHOR_DIR, fn)) as f: rec = json.load(f)
            except (OSError, ValueError):
                continue
            ats = parse_ts(rec.get("created"))
            if ats is None: continue
            confirmed = (rec.get("anchored") == "confirmed"
                         and rec.get("bitcoin_blocks"))
            quality = "bitcoin" if confirmed else "local"
            for logname, head in (rec.get("heads") or {}).items():
                hashes = per_log.get(logname)
                if not hashes or head not in hashes: continue
                for lsha in hashes[:hashes.index(head) + 1]:
                    prev = bounds.get(lsha)
                    # Prefer a third-party-verifiable bound even if a self-declared one
                    # claims to be earlier: an adversary can backdate their own
                    # checkpoint, but not a Bitcoin block.
                    if prev is None:
                        bounds[lsha] = (ats, quality)
                    else:
                        p_ts, p_q = prev
                        better = ((quality == "bitcoin" and p_q != "bitcoin")
                                  or (quality == p_q and ats < p_ts))
                        if better: bounds[lsha] = (ats, quality)
    _ANCHOR_CACHE["key"] = key
    _ANCHOR_CACHE["map"] = bounds
    return bounds


ANCHOR_DRIFT_WARN_SECS = 24 * 3600


def own_ledger_logs():
    """Log files this host wrote, i.e. every log NOT belonging to a registered peer.

    `peers.json` lists remote signers and is local-only/never replicated, so "not a
    known peer" is exactly "ours" on a correctly configured node. Deriving it this way
    avoids invoking the signer just to learn our own address.

    Fails SAFE in the direction that matters: an unregistered peer's log would be
    treated as ours and could only ever produce an extra anchor warning, never suppress
    a real one.
    """
    peer_addrs = {(p.get("addr") or "").lower()
                  for p in (load_peers().get("peers") or [])}
    out = []
    for path in ledger_files():
        base = os.path.basename(path)
        if base == os.path.basename(LEDGER): continue   # legacy log: not append-target
        addr = base[:-len(".jsonl")].lower() if base.endswith(".jsonl") else base
        if addr in peer_addrs: continue
        out.append(path)
    return out


def anchor_drift_secs(now_ts=None):
    """Seconds between the oldest UNANCHORED local ledger line and now, or None.

    Anchoring stopped being a nice-to-have audit trail: first-publisher priority is
    adjudicated by anchored upper bound, so an honest peer who never runs `commons
    anchor` has *unprovable* priority and loses to any anchored rival. Nothing
    enforced the cadence, and nothing told you it had lapsed — the
    failure was silent right up until you lost a priority dispute.

    Measures from the OLDEST unanchored line, not the newest: the exposure window is
    how long your earliest unprotected claim has been sitting there, not how recently
    you happened to append.

    Only lines WE wrote count. A peer's unanchored lines are their problem, and
    warning about them would make this fire constantly on a well-behaved node. Our
    logs are the ones we could actually append to — identified by filename, since
    `ledger_append` writes to `<our-addr>.jsonl` and pulled peer logs arrive under
    THEIR address. That is a filesystem fact already on disk, so it costs nothing;
    asking the signer for an address would shell out to Node on every `status`.
    """
    try:
        own_logs = own_ledger_logs()
        mine = {os.path.basename(p) for p in own_logs}
        # An empty append-target can exist before this host has ever published.
        # Do not parse anchors or peer ledgers until at least one local entry exists.
        has_own_entries = False
        for path in own_logs:
            with open(path) as f:
                if any(line.strip() for line in f):
                    has_own_entries = True
                    break
        if not has_own_entries: return None
        bounds = anchor_bounds()
        lines = ledger_lines()
    except Exception:
        return None
    oldest = None
    for e, path, _idx, lsha in lines:
        if os.path.basename(path) not in mine: continue
        if lsha in bounds: continue
        ts = parse_ts(e.get("ts"))
        if ts is None: continue
        if oldest is None or ts < oldest: oldest = ts
    if oldest is None: return None
    return max(0, (now_ts or time.time()) - oldest)


def warn_anchor_drift(now_ts=None):
    """Print the staleness warning to STDERR when drift exceeds the threshold.

    stderr, so it can never corrupt stdout that another tool is parsing; advisory only,
    so it never changes an exit code. A warning that broke scripts would just get
    silenced, and a silenced warning protects nobody.
    """
    drift = anchor_drift_secs(now_ts)
    if drift is None or drift < ANCHOR_DRIFT_WARN_SECS: return False
    print("warning: local chain drifted %dh past last anchor; derivation priority "
          "unprotected — run `commons anchor`" % int(drift // 3600), file=sys.stderr)
    return True


def first_publisher_index():
    """artifact id -> (addr, ts) of its first publish, adjudicated by anchored time.

    Asserted timestamps are self-declared, so an adversary can claim to have published
    someone else's artifact before they did — which would convert a copy into an
    `origin` derivation and hand it quorum weight. Ordering therefore keys on the
    ANCHORED upper bound first and the asserted timestamp only as a tiebreak among
    equally-anchored claims. "I derived it first but published late" stays claimable
    and never provable: anchoring can only bound time from above.

    Built in ONE ledger pass: doing it per-submission meant a full walk plus signature
    checks for every submission, which is how `status` on a 9-entry ledger reached 1.9s.
    """
    lines = ledger_lines()
    bounds = anchor_bounds()
    key = (id(lines), id(bounds))
    if _FIRSTPUB_CACHE["key"] == key:
        return _FIRSTPUB_CACHE["map"]

    cands = {}
    for e, _path, _idx, lsha in lines:
        if e.get("action") not in ("publish", "republish"): continue
        if not e.get("sig"): continue
        aid = e.get("id")
        if not aid: continue
        ok, _rec = verify_entry(e, e["sig"], e.get("addr"))
        if not ok: continue
        b_ts, b_q = bounds.get(lsha, (UNANCHORED, "none"))
        cands.setdefault(aid, []).append({
            "addr": (e.get("addr") or "").lower(),
            "asserted": parse_ts(e.get("ts")) or 0,
            "bound": b_ts, "quality": b_q})

    idx, flags = {}, {}
    for aid, cs in cands.items():
        # Provable order: anchored bound first, asserted time only as a tiebreak.
        by_anchor = sorted(cs, key=lambda c: (c["bound"], c["asserted"]))
        by_asserted = sorted(cs, key=lambda c: c["asserted"])
        win = by_anchor[0]
        idx[aid] = (win["addr"], win["asserted"])
        # The reputational tell: someone asserts priority that their anchor chain
        # cannot cover. Recorded per artifact so `status` and `peer stats` can show it
        # rather than silently applying it.
        claimant = by_asserted[0]
        if claimant["addr"] != win["addr"]:
            flags[aid] = {
                "asserted_by": claimant["addr"],
                "asserted_ts": claimant["asserted"],
                "asserted_bound": claimant["bound"],
                "asserted_quality": claimant["quality"],
                "anchored_winner": win["addr"],
                "winner_ts": win["asserted"],
                "winner_bound": win["bound"],
                "winner_quality": win["quality"],
            }
    _FIRSTPUB_CACHE["key"] = key
    _FIRSTPUB_CACHE["map"] = idx
    _FIRSTPUB_CACHE["flags"] = flags
    return idx


def backdating_flags():
    """artifact id -> discrepancy record where asserted priority beats anchored proof."""
    first_publisher_index()
    return _FIRSTPUB_CACHE.get("flags") or {}


def fmt_bound(ts, quality):
    if ts == UNANCHORED or ts is None:
        return "unanchored"
    return "%s (%s)" % (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(ts)), quality)


def first_publisher(result_id):
    """(addr, ts) of the first publisher of an artifact, per anchored adjudication.

    Content-addressing means the id is shared, so "who published it first" is the only
    thing that distinguishes a derivation from a citation. Ordering leans on anchored
    time as an upper bound, never on a publisher's self-declared timestamp.
    """
    return first_publisher_index().get(result_id)


def publish_ordering_evidence(result_id):
    """How well a commit can be ordered against an artifact's publication.

    Returns (state, bound) where state is:
      "none"     — no publish/republish event in any ledger;
      "unsigned" — at least one publish event carries no signature;
      "signed"   — every publish event is signed and verifies;
    and bound is the earliest (bound_ts, quality) anchor over the verified events
    (None when there are none).

    Commit-reveal is only evidence of independence if the commit provably precedes
    the result becoming public. An unsigned publish event proves the bytes were public
    at SOME point, but its timestamp is nobody's signed word, and unsigned lines can
    arrive from a peer, so it can't order anything. A signed publish that post-dates an
    unsigned one would otherwise hand the commit a later "first publication" to beat.
    Events with a failing signature are forgeries and are skipped (`log --verify`
    reports them).
    """
    bounds = anchor_bounds()
    state, best = None, None
    for e, _p, _i, lsha in ledger_lines():
        if e.get("action") not in ("publish", "republish"): continue
        if e.get("id") != result_id: continue
        if not e.get("sig"):
            state = "unsigned"; continue
        ok, _r = verify_entry(e, e["sig"], e.get("addr"))
        if not ok: continue
        if state is None: state = "signed"
        b = bounds.get(lsha, (UNANCHORED, "none"))
        if best is None or b[0] < best[0]: best = b
    return (state or "none"), best


def derivation_commits(tid):
    """Verified commit events for a task: addr -> [(commitment, ts, bound, quality)].

    A commit is sha256(result_sha256 || salt) posted BEFORE the result id exists
    publicly. Revealing the salt at submit time proves the submitter knew the bytes
    while they were still unguessable — i.e. derived rather than copied.

    The commit's anchor bound travels with it: a commit's own `ts` is self-declared,
    so without an anchor its claimed timing is just an assertion.
    """
    bounds = anchor_bounds()
    line_of = {}
    for e, _p, _i, lsha in ledger_lines():
        if e.get("action") == "derivation-commit":
            line_of[id(e)] = lsha
    out = {}
    for e in task_events(tid):
        if e.get("action") != "derivation-commit": continue
        addr = (e.get("addr") or "").lower()
        c = e.get("commitment")
        if not c: continue
        # Match the folded event back to its physical line to find its anchor bound.
        lsha = None
        for e2, _p, _i, s2 in ledger_lines():
            if (e2.get("action") == "derivation-commit"
                    and e2.get("commitment") == c
                    and (e2.get("addr") or "").lower() == addr
                    and e2.get("ts") == e.get("ts")):
                lsha = s2; break
        b_ts, b_q = bounds.get(lsha, (UNANCHORED, "none")) if lsha else (UNANCHORED, "none")
        out.setdefault(addr, []).append((c, parse_ts(e.get("ts")) or 0, b_ts, b_q))
    return out


def derivation_evidence(tid, result_id, submitter, submit_event, commits, fp):
    """Classify a submission: 'origin' | 'commit-reveal' | 'reference'.

    Only the first two carry quorum weight. A reference is legitimate — citing an
    existing result can fulfill a task — it just is not a second derivation.
    """
    sub = (submitter or "").lower()
    fl = backdating_flags().get(result_id)
    if fl and fl["asserted_by"] == sub and fl["anchored_winner"] != sub:
        # This peer asserts it published first, but no anchor covers the claim while a
        # rival's is covered. Downgrade to reference: an unprovable priority claim must
        # not convert a copy into a quorum-bearing derivation.
        return "reference", ("asserted first-publish of %s at %s is not covered by an "
                            "anchor (%s); %s holds the anchored claim"
                            % (result_id,
                               time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                             time.gmtime(fl["asserted_ts"])),
                               fmt_bound(fl["asserted_bound"], fl["asserted_quality"]),
                               fl["anchored_winner"]))
    if fp and fp[0] == sub:
        return "origin", "first publisher of %s" % result_id
    salt = submit_event.get("salt")
    if salt:
        rm = load_manifest(result_id, missing_ok=True)
        if rm:
            expect = hashlib.sha256(
                (rm["content"]["sha256"] + salt).encode()).hexdigest()
            # Fail closed: the commit must provably predate publication, so it needs
            # signed publish events to be ordered against. Before 0.2.0-alpha.1 these
            # checks ran only when a verified signed first publisher existed, and an
            # artifact published unsigned skipped them all.
            pstate, pbound = publish_ordering_evidence(result_id)
            for c, cts, cbound, cqual in commits.get(sub, []):
                if c != expect: continue
                if pstate == "none":
                    return "reference", ("no publish event for %s in any ledger, so the "
                                         "commit cannot be ordered before publication"
                                         % result_id)
                if pstate == "unsigned" or not fp:
                    return "reference", ("%s has an unsigned publish event, so its "
                                         "publication time is unprovable and the commit "
                                         "cannot be ordered before it" % result_id)
                # The commit must predate the result becoming public, or it proves
                # nothing: committing to bytes you can already see is free.
                if cts >= fp[1]:
                    return "reference", ("commit posted after %s was already published "
                                         "— proves nothing" % result_id)
                # And the commit's own timestamp is self-declared, so a backdated commit
                # event would fake independence just as well as a backdated publish.
                # Require an anchor to cover the commit whenever the artifact it beats
                # is itself anchored; otherwise the "proof" is the peer's own word.
                if cbound == UNANCHORED and pbound is not None and pbound[0] != UNANCHORED:
                    return "reference", (
                        "commit for %s is unanchored, so its claimed "
                        "pre-publication timing is unprovable against an anchored "
                        "publish (%s)" % (result_id, fmt_bound(*pbound)))
                return "commit-reveal", "committed before publication, salt revealed"
            return "reference", "revealed salt matches no prior commitment"
    return "reference", "no derivation evidence (submitted an existing artifact id)"


def settle_analysis(st):
    """Group submissions by result content and evaluate settlement readiness.

    T0/T1: k independent submissions agreeing on the same bytes is replication by
    distinct signers, which is a far stronger signal than the publisher's own PASS.
    Divergence is never silently dropped — it is the most interesting outcome, since
    it locates exactly where a supposedly deterministic pipeline is not.
    """
    spec = st["spec"]
    ver = spec.get("verification") or {}
    tier = ver.get("tier")
    criteria_list = ver.get("criteria_list") if tier == "T2" else None
    tid = st["id"]
    commits = derivation_commits(tid)
    groups = {}   # T0/T1: content sha256 -> group; T2 w/ rubric: verdict vector -> group
    # Structured judgement: on a judged tier the claim is the verdict vector, so that
    # is the grouping key. The prose still decides independence (below) — a copied
    # review with a retyped vector must not read as a second derivation.
    structured = bool(criteria_list)
    prose_only = []   # T2 submissions with no judgement on a structured task
    for s in st["submissions"]:
        rid = s.get("result")
        rm = load_manifest(rid, missing_ok=True) if rid else None
        if rm is None:
            groups.setdefault("<missing:%s>" % rid, {"ids": set(), "signers": set(),
                                                     "derivers": set(), "refs": set(),
                                                     "families": {}, "evidence": {},
                                                     "missing": True})
            groups["<missing:%s>" % rid]["signers"].add((s.get("addr") or "").lower())
            continue
        if structured:
            key = judgement_vector_key(rm.get("judgement"), criteria_list)
            if key is None:
                prose_only.append(rid)
                key = "<no-judgement:%s>" % rm["content"]["sha256"]
        else:
            key = rm["content"]["sha256"]
        g = groups.setdefault(key, {"ids": set(), "signers": set(), "derivers": set(),
                                    "refs": set(), "families": {}, "evidence": {},
                                    "missing": False, "judgements": {}})
        g["ids"].add(rid)
        if structured and rm.get("judgement"):
            g.setdefault("judgements", {})[rid] = rm["judgement"]
        addr = (s.get("addr") or "").lower()
        g["signers"].add(addr)

        # Submitting an id is not evidence of producing it. Only an original publisher
        # or a pre-publication commit-reveal counts as an independent derivation; a bare
        # copy is a legitimate concurring reference with zero quorum weight.
        fp = first_publisher(rid)
        kind, why = derivation_evidence(tid, rid, addr, s.get("event") or {}, commits, fp)
        g["evidence"][addr] = (kind, why)
        if kind in ("origin", "commit-reveal"):
            g["derivers"].add(addr)
        else:
            g["refs"].add(addr)

        fam, level, attested = result_family(rm)
        if fam:
            # Attested families count toward a quorum; self-reported are advisory. And a
            # family only counts at all when the submission is an independent derivation,
            # otherwise a copy under a different family label fakes cross-family
            # replication — the highest-value signal in the system.
            g["families"].setdefault(fam, {"attested": 0, "self_reported": 0,
                                           "derived_attested": 0})
            g["families"][fam]["attested" if attested else "self_reported"] += 1
            if attested and kind in ("origin", "commit-reveal"):
                g["families"][fam]["derived_attested"] += 1

    dq = spec.get("diversity_quorum")
    ranked = sorted(groups.items(),
                    key=lambda kv: (-len(kv[1].get("derivers", ())),
                                    -len(kv[1]["signers"])))
    quorum_k = (dq or {}).get("k", 1)
    need_families = (dq or {}).get("distinct_families", 0)

    ready = None
    for key, g in ranked:
        if g.get("missing"): continue
        # Independence is what makes agreement meaningful, and independence means
        # DERIVED, not merely signed: k copies of one derivation is one derivation.
        derivers = len(g["derivers"])
        attested_families = sum(1 for f, c in g["families"].items()
                                if c.get("derived_attested", 0) > 0)
        if tier in ("T0", "T1"):
            if derivers >= quorum_k and (not dq or attested_families >= need_families):
                ready = (key, g, derivers, attested_families)
                break
        else:
            if dq and derivers >= quorum_k and attested_families >= need_families:
                ready = (key, g, derivers, attested_families)
                break

    # On a structured T2 task a prose-only submission is not a rival verdict — it is
    # unassessable, and must neither count toward nor block the vector groups.
    divergent = [k for k, g in groups.items()
                 if not g.get("missing") and not k.startswith("<no-judgement:")]
    return {"tier": tier, "groups": groups, "ranked": ranked, "ready": ready,
            "divergent": len(divergent) > 1, "quorum_k": quorum_k,
            "need_families": need_families, "dq": dq,
            "structured": structured, "criteria_list": criteria_list or [],
            "prose_only": prose_only}


def criterion_table(an):
    """Per-criterion agreement over every judged submission of a structured T2 task.

    Returns [(criterion_id, {verdict: count}, split_bool)]. Computed from the same
    groups settle uses, so the table and the settlement decision cannot disagree.
    """
    if not an.get("structured"): return []
    rows = []
    all_j = {}
    for k, g in an["groups"].items():
        if g.get("missing"): continue
        for rid, j in (g.get("judgements") or {}).items():
            all_j[rid] = j
    if not all_j: return []
    for c in an["criteria_list"]:
        cid = c.get("id")
        if not cid: continue
        counts = {}
        for j in all_j.values():
            v = j.get(cid, "NA")
            counts[v if v in VERDICTS else "NA"] = counts.get(v if v in VERDICTS else "NA", 0) + 1
        rows.append((cid, counts, len(counts) > 1))
    return rows


def print_criterion_table(an, indent="    "):
    rows = criterion_table(an)
    if not rows: return
    print("%scriteria   :" % indent[:2])
    for cid, counts, split in rows:
        cells = "  ".join("%s×%d" % (v, counts[v]) for v in VERDICTS if v in counts)
        print("%s%-24s %s%s" % (indent, cid, cells, "   ← SPLIT" if split else ""))


MACHINE_TIERS = ("T0", "T1")


def divergence_advice(tier):
    """Tier-appropriate reading of two distinct results for the same task.

    The same detector fires at every tier, but it does NOT mean the same thing.
    On a machine tier (T0/T1) the pipeline claimed determinism and did not deliver,
    so the disagreement is a defect and localising it is the work. On a judged tier
    (T2+) nothing ever promised identical bytes: two reviewers reaching different
    judgements is the expected shape of review, and often its most valuable output.
    Telling a T2 operator to go debug determinism is not merely off-key, it is wrong
    advice — it sends them after a property their task never asserted. The advisory
    wording branches; the exit code does not (see docs/DESIGN-notes-divergence-reports.md).
    """
    if tier in MACHINE_TIERS:
        return ["A machine-verifiable tier producing different answers is a finding,",
                "not a tie to break. Investigate where the pipeline is not deterministic."]
    return ["On a judged tier the reviewers reached different judgements. That is not",
            "a pipeline defect and not a tie to break — nothing here claimed identical",
            "bytes. The disagreement is the finding: locate what the reviewers read",
            "differently, not where a computation went nondeterministic."]


def cmd_settle(a):
    """Auto-accept T0/T1 work whose result has been independently replicated.

    This does not bypass the beneficiary — it is the beneficiary running the rule they
    published in the task spec. Divergence refuses to auto-settle and says so, because
    a machine tier producing two different answers is a finding, not a tie to break.
    """
    m = load_task(a.id)
    require_signing("settlements")
    st = task_state(m)
    an = settle_analysis(st)
    me = my_addr().lower()
    if st["beneficiary"] and me != st["beneficiary"]:
        sys.exit("error: only the beneficiary (%s) may settle %s" % (st["beneficiary"], a.id))
    if st["settled"] and not a.force:
        sys.exit("error: %s is already %s" % (a.id, st["state"]))
    if not st["submissions"]:
        sys.exit("error: nothing submitted for %s yet" % a.id)

    if an["tier"] not in ("T0", "T1") and not an["dq"]:
        sys.exit("error: %s is tier %s with no diversity_quorum — judged work is "
                 "accepted by review, not by counting.\n"
                 "       Use: commons accept %s <result>" % (a.id, an["tier"], a.id))

    if an["divergent"]:
        real = [(k, g) for k, g in an["ranked"]
                if not g.get("missing") and not k.startswith("<no-judgement:")]
        if an.get("structured"):
            print("DIVERGENT: %d distinct verdict vectors submitted for %s (structured T2)."
                  % (len(real), a.id))
            for key, g in real:
                print("  %s  %d signer(s): %s"
                      % (key, len(g["signers"]), ", ".join(sorted(g["ids"])) or "?"))
            split = [cid for cid, _c, s in criterion_table(an) if s]
            print("  reviewers split on criteria: %s" % (", ".join(split) or "(none?)"))
            print("  Agreement is per-criterion, and the prose remains the evidence for WHY.")
            print("  Read the split criteria in each review; that is the finding.")
        else:
            print("DIVERGENT: %d distinct results submitted for a %s task."
                  % (len(an["ranked"]), an["tier"]))
            for key, g in an["ranked"]:
                print("  %s  %d signer(s): %s"
                      % (key[:16] if not key.startswith("<") else key,
                         len(g["signers"]), ", ".join(sorted(g["ids"])) or "?"))
            for line in divergence_advice(an["tier"]):
                print("  " + line)
        print("  Settle by hand:")
        print("    commons accept %s <result>   /   commons reject %s --reason ..."
              % (a.id, a.id))
        print("  Then preserve the finding: a located disagreement is the next task.")
        print("  See docs/DESIGN-notes-divergence-reports.md to publish the comparison")
        print("  as a durable type=report artifact instead of losing it to this stdout.")
        sys.exit(EX_FAIL)

    if not an["ready"]:
        top = an["ranked"][0] if an["ranked"] else None
        have = len(top[1].get("derivers", ())) if top else 0
        fams = sum(1 for f, c in (top[1]["families"] if top else {}).items()
                   if c.get("derived_attested", 0) > 0)
        print("not yet settleable: %d/%d independent derivation(s)%s"
              % (have, an["quorum_k"],
                 ", %d/%d attested families" % (fams, an["need_families"])
                 if an["dq"] else ""))
        refs = len(top[1].get("refs", ())) if top else 0
        if refs:
            print("  note: %d submission(s) were concurring references — copies of an"
                  % refs)
            print("  existing artifact id carry no quorum weight. See `status` for which.")
        if an["dq"]:
            selfrep = sum(c["self_reported"] for f, c in (top[1]["families"] if top else {}).items())
            if selfrep:
                print("  note: %d self-reported family claim(s) present but NOT counted —"
                      % selfrep)
                print("  a diversity quorum needs attestation receipt|tee, or the quorum")
                print("  just re-monetizes the model claim it was meant to test.")
        sys.exit(EX_NOT_MACHINE_VERIFIABLE)

    key, g, signers, fams = an["ready"]
    result = sorted(g["ids"])[0]
    if an.get("structured"):
        print("settleable: verdict vector %s reached independently by %d signer(s)%s"
              % (key[len("verdict:"):], signers,
                 ", %d attested famil%s" % (fams, "y" if fams == 1 else "ies") if an["dq"] else ""))
        print("  reviews: %s  (agreement is on verdicts; the prose is the evidence)"
              % ", ".join(sorted(g["ids"])))
        if an.get("prose_only"):
            print("  note: %d prose-only submission(s) carried no judgement vector and were "
                  "not assessed: %s" % (len(an["prose_only"]), ", ".join(an["prose_only"])))
    else:
        print("settleable: %s independently derived by %d signer(s)%s"
              % (result, signers,
                 ", %d attested famil%s" % (fams, "y" if fams == 1 else "ies") if an["dq"] else ""))
    if a.dry_run:
        print("(dry run — not accepting)")
        return
    ev = {"agent": a.agent, "action": "accept", "id": a.id, "task": a.id,
          "sha256": m["content"]["sha256"], "result": result,
          "settlement": "quorum", "signers": signers, "derivations": signers}
    if an["dq"]: ev["attested_families"] = fams
    if an.get("structured"):
        # Record WHAT was agreed, not just that something was: the vector is the claim.
        ev["settlement"] = "verdict-quorum"
        ev["verdict_vector"] = key[len("verdict:"):]
        ev["reviews"] = sorted(g["ids"])
    ledger_append(ev)
    tm = load_manifest(a.id)
    if not any(l.get("rel") == "accepted" and l.get("id") == result
               for l in tm.get("links", [])):
        tm.setdefault("links", []).append({"rel": "accepted", "id": result})
        write_manifest(a.id, tm)
        con = db_conn(); index_manifest(con, tm); con.commit(); con.close()
    print("accepted %s by quorum" % result)


def require_signing(what):
    if not signing_key_path():
        sys.exit("error: %s must be signed — set COMMONS_SIGNING_KEY.\n"
                 "       Unsigned lifecycle events cannot be attributed, and an\n"
                 "       unattributable claim is indistinguishable from squatting." % what)


def my_addr():
    addr, _ = sign_entry({"action": "whoami", "agent": "-", "id": "-",
                          "sha256": "-", "ts": now()})
    return addr


def load_task(tid):
    m = load_manifest(tid)
    if m["type"] != "task":
        sys.exit("error: %s is a %s, not a task" % (tid, m["type"]))
    return m


def claim_freshness_warnings(m, st):
    """Federation-lag advisories for `claim`.

    Within one registry the queue folds from the ledger and cannot disagree with it —
    but replication across peers is asynchronous, and that reopens exactly the race
    the ledger fold closes locally. Two cheap, purely-local checks catch the two
    concrete ways staleness shows up before a claim is signed:

    (a) a task's declared dataset input has already been superseded (a newer
        artifact links `supersedes` back at it) — the beneficiary may not have meant
        to hand out the old version, or a remote pull just hasn't landed here yet.
    (b) a result already exists locally that links `fulfills` this task, but the
        ledger fold has not recorded it as a submission — its manifest replicated
        ahead of (or instead of) the `submit` ledger event that names it, so the work
        may already be done even though `task_state()` still reports it unclaimed.

    Advisory only, same posture as `warn_anchor_drift`: printed to stderr, never
    raises, never changes an exit code. A federation race is a reason to look twice,
    not a reason the exchange can refuse — only the claimant has enough information
    to decide whether to proceed.
    """
    warnings = []
    spec = st["spec"]
    tid = m["id"]

    input_ids = [i.get("id") for i in (spec.get("inputs") or [])
                 if isinstance(i, dict) and i.get("id")]
    if input_ids:
        superseded_by = {}
        for cand in iter_manifests():
            for link in cand.get("links") or []:
                if (isinstance(link, dict) and link.get("rel") == "supersedes"
                        and link.get("id") in input_ids):
                    superseded_by.setdefault(link["id"], []).append(cand["id"])
        for iid in sorted(superseded_by):
            warnings.append(
                "input %s has a newer artifact (%s) — a superseded input may not be "
                "what the beneficiary intended; verify before claiming"
                % (iid, ", ".join(sorted(superseded_by[iid]))))

    known_results = {s["result"] for s in st["submissions"]}
    matching = sorted(
        cand["id"] for cand in iter_manifests()
        if any(isinstance(l, dict) and l.get("rel") == "fulfills" and l.get("id") == tid
               for l in cand.get("links") or [])
        and cand["id"] not in known_results)
    if matching:
        warnings.append(
            "a result matching %s already exists locally (%s) with no recorded submit "
            "event yet — possible federation lag; check before duplicating the work"
            % (tid, ", ".join(matching)))
    return warnings


def cmd_claim(a):
    m = load_task(a.id)
    require_signing("claims")
    st = task_state(m)
    me = my_addr()
    if st["task_expired"]:
        sys.exit("error: %s expired at %s" % (a.id, st["spec"].get("expires")))
    if st["settled"]:
        sys.exit("error: %s is already %s" % (a.id, st["state"]))
    if me.lower() in st["active"]:
        sys.exit("error: you already hold an active claim on %s (expires %s)"
                 % (a.id, time.strftime("%Y-%m-%dT%H:%M:%SZ",
                                        time.gmtime(st["active"][me.lower()]["expires"]))))
    if st["slots_free"] < 1:
        holders = ", ".join(c["addr"] for c in st["active"].values())
        sys.exit("error: %s has no free claim slots (%d/%d active: %s)\n"
                 "       Claims expire on their own; try again later."
                 % (a.id, len(st["active"]), st["max_claims"], holders))

    for w in claim_freshness_warnings(m, st):
        print("warning: %s" % w, file=sys.stderr)

    ttl = a.ttl or DEFAULT_CLAIM_TTL
    parse_duration(ttl)  # validate before writing
    ledger_append({"agent": a.agent, "action": "claim", "id": a.id, "task": a.id,
                   "sha256": m["content"]["sha256"], "claim_ttl": ttl})
    print("claimed %s (ttl %s, slot %d/%d)"
          % (a.id, ttl, len(st["active"]) + 1, st["max_claims"]))

    spec = st["spec"]
    foreign = st["beneficiary"] and st["beneficiary"] != me.lower()
    if foreign:
        print("  this is a FOREIGN task — its workflow will run sandboxed, "
              "regardless of COMMONS_EXEC")
    if (spec.get("verification") or {}).get("tier") == "T2":
        print("  T2: claim expires %s after claim regardless of heartbeats; "
              "`commons heartbeat %s` records liveness evidence for the "
              "beneficiary but does not renew the lease" % (ttl, a.id))
    wf = (spec.get("execution") or {}).get("workflow")
    if wf:
        print("  run it: commons run-task %s" % a.id)


def cmd_heartbeat(a):
    m = load_task(a.id)
    require_signing("heartbeats")
    st = task_state(m)
    me = my_addr().lower()
    if me not in st["active"]:
        sys.exit("error: you do not hold an active claim on %s" % a.id)
    ledger_append({"agent": a.agent, "action": "heartbeat", "id": a.id, "task": a.id,
                   "sha256": m["content"]["sha256"]})
    print("heartbeat recorded for %s" % a.id)


def cmd_release(a):
    m = load_task(a.id)
    require_signing("releases")
    st = task_state(m)
    me = my_addr().lower()
    if me not in st["active"]:
        sys.exit("error: you do not hold an active claim on %s" % a.id)
    ledger_append({"agent": a.agent, "action": "release", "id": a.id, "task": a.id,
                   "sha256": m["content"]["sha256"],
                   **({"reason": a.reason} if a.reason else {})})
    print("released claim on %s (slot freed immediately)" % a.id)


def cmd_run_task(a):
    """Execute a claimed task's workflow.

    THE non-negotiable rule of the exchange: if the beneficiary is not us, the work
    runs sandboxed — in code, not by convention. COMMONS_EXEC is deliberately ignored
    here, because a foreign task spec is untrusted code and an env var is not a
    security boundary.
    """
    m = load_task(a.id)
    st = task_state(m)
    spec = st["spec"]
    wf = (spec.get("execution") or {}).get("workflow")
    if not wf:
        sys.exit("error: %s has no workflow (prose brief — do the work, then "
                 "`commons submit`)" % a.id)
    me = (my_addr() if signing_key_path() else "").lower()
    foreign = bool(st["beneficiary"]) and st["beneficiary"] != me
    if foreign and me and me not in st["active"]:
        print("warning: you do not hold an active claim on this task", file=sys.stderr)

    if foreign:
        env_pref = os.environ.get("COMMONS_EXEC")
        if env_pref and env_pref != "sandbox":
            print("note: COMMONS_EXEC=%s ignored — foreign task specs always run "
                  "sandboxed" % env_pref, file=sys.stderr)
        outputs, spec_ran, scratch, wm, execrec = _run_workflow(wf, force_sandbox=True)
    else:
        outputs, spec_ran, scratch, wm, execrec = _run_workflow(
            wf, exec_mode=getattr(a, "exec", None))
    try:
        published = []
        for name, path in sorted(outputs.items()):
            digest = store_blob(path)
            aid = "%s-%s" % (TYPES[a.publish_type], digest[:8])
            prior = load_manifest(aid, missing_ok=True)
            if prior is not None:
                _guard_manifest_collision(aid, {"content": {"sha256": digest}})
            if prior is None:
                out_m = {
                    "schema": SCHEMA, "id": aid, "type": a.publish_type,
                    "title": a.title or "Result for %s: %s" % (a.id, name),
                    "description": "Produced for task %s" % a.id,
                    "tags": [], "agent": a.agent, "created": now(),
                    "content": {"sha256": digest, "filename": os.path.basename(path),
                                "bytes": os.path.getsize(path)},
                    "verification": _spec_verification(spec_ran),
                    "provenance": {
                        "inputs": [{"id": iid,
                                    "sha256": load_manifest(iid)["content"]["sha256"]}
                                   for iid in (spec_ran.get("inputs") or {}).values()],
                        "workflow": {"id": wf, "sha256": wm["content"]["sha256"]},
                        "run": {"finished": now(), "env": spec_ran.get("env", {}),
                                "exec": execrec}},
                    "links": [{"rel": "derives", "id": wf},
                              {"rel": "fulfills", "id": a.id}]}
                commit_signed_publish(aid, out_m, {
                    "agent": a.agent, "action": "publish", "id": aid,
                    "sha256": digest, "tier": out_m["verification"]["tier"],
                    "exec_mode": execrec["mode"]},
                    os.path.exists(manifest_path(aid)))
            published.append(aid)
            print("%s  %s  (%s)" % (aid, name, fmt_exec(execrec)))
        if published:
            print("submit it: commons submit %s %s" % (a.id, published[0]))
    finally:
        shutil.rmtree(scratch, ignore_errors=True)


def cmd_commit_derivation(a):
    """Commit to a result you have derived but not yet published.

    Posts sha256(result_sha256 || salt) as a signed ledger event. Revealing the salt at
    submit time proves you knew the bytes while they were still unguessable — which is
    what separates an independent derivation from a copy of someone else's artifact.
    Same mechanism as golden-task answer commitment: one convention, two uses.
    """
    m = load_task(a.id)
    require_signing("derivation commits")
    if a.result_hash:
        digest = a.result_hash
        if not re.fullmatch(r"[0-9a-f]{64}", digest):
            sys.exit("error: --result-hash must be a 64-char lowercase sha256")
    elif a.file:
        if not os.path.isfile(a.file): sys.exit("error: no such file: " + a.file)
        digest = sha256_file(a.file)
    else:
        sys.exit("error: give --file <path> or --result-hash <sha256>")
    salt = a.salt or hashlib.sha256(os.urandom(32)).hexdigest()[:32]
    commitment = hashlib.sha256((digest + salt).encode()).hexdigest()
    ledger_append({"agent": a.agent, "action": "derivation-commit", "id": a.id,
                   "task": a.id, "sha256": m["content"]["sha256"],
                   "commitment": commitment})
    print("committed to a derivation for %s" % a.id)
    print("  commitment: %s" % commitment)
    print("  SALT (keep it; you must reveal it at submit time):")
    print("    %s" % salt)
    print("  submit with: commons submit %s <result-id> --salt %s" % (a.id, salt))


def cmd_submit(a):
    m = load_task(a.id)
    rm = load_manifest(a.result, missing_ok=True)
    if rm is None:
        sys.exit("error: result %s is not published — publish it first so the "
                 "submission points at immutable, inspectable content" % a.result)
    require_signing("submissions")
    st = task_state(m)
    me = my_addr()
    if st["settled"]:
        sys.exit("error: %s is already %s" % (a.id, st["state"]))
    if st["task_expired"] and not a.force:
        sys.exit("error: %s expired at %s (use --force to submit anyway; the "
                 "beneficiary may still accept)" % (a.id, st["spec"].get("expires")))
    if me.lower() not in st["active"] and not a.force:
        sys.exit("error: you hold no active claim on %s. Claim it first — unclaimed "
                 "submissions bypass the concurrency limit the beneficiary set." % a.id)

    # A T2 result should carry its generation provenance; advisory, never an
    # acceptance input, but without it the work cannot be meaningfully reviewed.
    tier = (st["spec"].get("verification") or {}).get("tier")
    if tier == "T2" and is_observation(rm):
        # A T3 capture submitted to a judged task (the interim observation-task
        # pattern: a T2 task with a protocol-conformance rubric): `generation` describes
        # model-produced work and is meaningless here, so don't warn about its absence.
        print("note: result is a T3 observation. Review judges whether it followed the "
              "task's protocol, not whether the observation is true.", file=sys.stderr)
    elif tier == "T2" and not (rm.get("generation") or {}):
        print("warning: T2 result has no `generation` block (model, params, prompts). "
              "It is advisory only, but reviewers rely on it.", file=sys.stderr)
    # Structured judgement vs the task's enumerated rubric. A verdict vector that does
    # not address the declared criteria can never agree with one that does, so refuse
    # it here where the contributor can still fix it, not at settlement.
    cl = (st["spec"].get("verification") or {}).get("criteria_list")
    jd = rm.get("judgement")
    if tier == "T2" and cl:
        if not jd and not a.force:
            sys.exit("error: %s declares an enumerated rubric (%d criteria) but result %s "
                     "carries no `judgement` vector.\n"
                     "       Republish with --judgement ID=pass|fail|NA for each criterion "
                     "(ids: %s), or --force to submit as prose-only (no quorum weight)."
                     % (a.id, len(cl), a.result,
                        ", ".join(c.get("id", "?") for c in cl if isinstance(c, dict))))
        if jd:
            probs = judgement_problems(jd, cl)
            if probs and not a.force:
                for pb in probs: print("  - %s" % pb, file=sys.stderr)
                sys.exit("error: result %s's judgement does not match %s's rubric "
                         "(%d problem(s) above)" % (a.result, a.id, len(probs)))

    # Link result -> task so the graph records what it was for.
    if not any(l.get("rel") == "fulfills" and l.get("id") == a.id
               for l in rm.get("links", [])):
        rm.setdefault("links", []).append({"rel": "fulfills", "id": a.id})
        write_manifest(a.result, rm)
        con = db_conn(); index_manifest(con, rm); con.commit(); con.close()

    ev = {"agent": a.agent, "action": "submit", "id": a.id, "task": a.id,
          "result": a.result, "sha256": rm["content"]["sha256"]}
    if a.salt: ev["salt"] = a.salt
    ledger_append(ev)
    print("submitted %s for %s" % (a.result, a.id))

    # Say plainly what this submission will count as, so a contributor is never
    # surprised at settlement time.
    fp = first_publisher(a.result)
    kind, why = derivation_evidence(a.id, a.result, me, ev,
                                    derivation_commits(a.id), fp)
    if kind == "origin":
        print("  counts as: independent derivation (you first published this result)")
    elif kind == "commit-reveal":
        print("  counts as: independent derivation (%s)" % why)
    else:
        print("  counts as: CONCURRING REFERENCE — %s" % why)
        print("    It can fulfill the task, but carries no quorum weight and no")
        print("    derivation credit. To count as independent next time, post")
        print("    `commons commit-derivation` before the result is published.")
    print("  beneficiary %s decides; `commons status %s` shows the rollup"
          % (st["beneficiary"] or "?", a.id))


def _settle(a, action):
    m = load_task(a.id)
    if a.result:
        load_manifest(a.result)
    require_signing("%ss" % action)
    st = task_state(m)
    me = my_addr().lower()
    if st["beneficiary"] and me != st["beneficiary"]:
        sys.exit("error: only the beneficiary (%s) may %s %s — you are %s.\n"
                 "       Settlement authority is the whole point of naming a "
                 "beneficiary." % (st["beneficiary"], action, a.id, me))
    if not st["submissions"] and not a.force:
        sys.exit("error: nothing has been submitted for %s yet" % a.id)
    if action == "reject" and not a.reason:
        sys.exit("error: reject requires --reason. A rejection without a stated "
                 "reason is unappealable and unauditable.")
    if st["settled"] and not a.force:
        sys.exit("error: %s is already %s" % (a.id, st["state"]))

    result = a.result
    if not result and st["submissions"]:
        result = st["submissions"][-1]["result"]
    ev = {"agent": a.agent, "action": action, "id": a.id, "task": a.id,
          "sha256": m["content"]["sha256"]}
    if result: ev["result"] = result
    if a.reason: ev["reason"] = a.reason
    ledger_append(ev)

    if action == "accept" and result:
        # Record acceptance in the graph, not just the ledger.
        tm = load_manifest(a.id)
        if not any(l.get("rel") == "accepted" and l.get("id") == result
                   for l in tm.get("links", [])):
            tm.setdefault("links", []).append({"rel": "accepted", "id": result})
            write_manifest(a.id, tm)
            con = db_conn(); index_manifest(con, tm); con.commit(); con.close()
    print("%sed %s%s" % (action, a.id, (" (%s)" % result) if result else ""))
    if a.reason: print("  reason: %s" % a.reason)


def cmd_accept(a): _settle(a, "accept")
def cmd_reject(a): _settle(a, "reject")


def cmd_queue(a):
    """The queue is a VIEW over task artifacts + ledger state, not a structure.

    Nothing to corrupt, nothing to migrate, and it cannot disagree with the ledger.
    """
    peer_known = True
    if a.peer:
        needle = a.peer.lower()
        peer_known = any(needle in ((p.get("agent") or "").lower(),
                                    (p.get("addr") or "").lower())
                         for p in load_peers().get("peers", []))
    if a.collection:
        cm = load_manifest(a.collection)
        if cm.get("type") != "collection":
            sys.exit("error: %s is a %s, not a collection"
                     % (a.collection, cm.get("type", "unknown")))
    ensure_dirs()
    smap = superseders_map() if getattr(a, "tips_only", False) else None
    hidden = 0
    rows = []
    for fn in sorted(os.listdir(ART)):
        if not fn.endswith(".json"): continue
        with open(os.path.join(ART, fn)) as f: m = json.load(f)
        if m.get("type") != "task": continue
        if smap is not None and m["id"] in smap:
            hidden += 1; continue
        st = task_state(m)
        spec = st["spec"]
        if a.peer:
            ben = (spec.get("beneficiary") or {})
            peer_match = a.peer.lower() in ((ben.get("agent") or "").lower(),
                                             (ben.get("addr") or "").lower())
            peer_known = peer_known or peer_match
            if not peer_match:
                continue
        if a.collection and a.collection not in (spec.get("collections") or []):
            continue
        want = ("open" if a.open else "claimed" if a.claimed else None)
        if not a.all and want and st["state"] != want: continue
        if not a.all and not want and st["state"] in ("accepted", "rejected", "expired"):
            continue
        rows.append((spec.get("priority", 2), spec.get("expires", ""), m, st))
    if a.peer and not peer_known:
        sys.exit("error: no such peer: %s" % a.peer)
    rows.sort(key=lambda r: (r[0], r[1]))
    if getattr(a, "json", False):
        # Consumers (e.g. the burn-down bridge) must never scrape the human table:
        # a column shift would silently mis-dispatch work. Emit the fields instead.
        out = []
        for pri, exp, m, st in rows:
            spec = st["spec"]
            ver = spec.get("verification") or {}
            wf = (spec.get("execution") or {}).get("workflow")
            restricted, undeclared = task_input_availability(spec)
            out.append({
                "id": m["id"], "state": st["state"], "priority": pri,
                "expires": exp, "tier": ver.get("tier"),
                "criteria": ver.get("criteria"),
                "criteria_list": ver.get("criteria_list"),
                "objective": spec.get("objective"),
                "workflow": wf,
                "brief": (spec.get("execution") or {}).get("brief"),
                "beneficiary": spec.get("beneficiary") or {},
                "collections": spec.get("collections") or [],
                "max_claims": st["max_claims"], "slots_free": st["slots_free"],
                "inputs": [i.get("id") for i in (spec.get("inputs") or [])
                           if isinstance(i, dict)],
                "diversity_quorum": spec.get("diversity_quorum"),
                # Advisory only, same posture as verify/status: says who could check
                # this task's inputs, never whether the task itself may be claimed.
                "restricted_inputs": restricted,
                "undeclared_inputs": undeclared,
            })
        print(json.dumps(out, indent=2, sort_keys=True))
        return
    if not rows:
        print("(no matching tasks)"); return
    print("%-14s %-4s %-10s %-5s %-20s %s"
          % ("id", "pri", "state", "tier", "expires", "objective"))
    for pri, exp, m, st in rows:
        spec = st["spec"]
        slots = ""
        if st["state"] == "claimed":
            slots = " %d/%d" % (len(st["active"]), st["max_claims"])
        print(("%-14s %-4s %-10s %-5s %-20s %s" + task_availability_marker(spec))
              % (m["id"], pri, st["state"] + slots,
                 (spec.get("verification") or {}).get("tier", "?"),
                 (exp or "")[:19], (spec.get("objective") or "")[:52]))
    print("%d task(s)%s" % (len(rows),
                            " (%d superseded hidden)" % hidden if hidden else ""),
          file=sys.stderr)


def task_status(m):
    """Lifecycle rollup for a task, joined with the result's chain grade."""
    st = task_state(m)
    spec = st["spec"]
    ver = spec.get("verification") or {}
    print("%s  %s" % (m["id"], (spec.get("objective") or "")[:70]))
    print("  state      : %s" % st["state"])
    print("  tier       : %s   priority %s   expires %s%s"
          % (ver.get("tier", "?"), spec.get("priority", "?"), spec.get("expires", "?"),
             "  (EXPIRED)" if st["task_expired"] else ""))
    print("  criteria   : %s" % (ver.get("criteria") or "(none)")[:100])
    if spec.get("method"):
        print("  rubric from: %s (method; task owns the copy)" % spec["method"])
    for c in ver.get("criteria_list") or []:
        if isinstance(c, dict):
            print("    %-24s %s" % (c.get("id", "?"), (c.get("text") or "")[:72]))
    print("  beneficiary: %s" % (st["beneficiary"] or "?"))
    restricted, undeclared = task_input_availability(spec)
    if restricted:
        print("  availability: %d input(s) restricted, not independently obtainable: %s"
              % (len(restricted), ", ".join(restricted)))
    if undeclared:
        print("  availability: %d input(s) declare no obtainability: %s"
              % (len(undeclared), ", ".join(undeclared)))
    if st["active"]:
        print("  claims     : %d/%d active" % (len(st["active"]), st["max_claims"]))
        for c in st["active"].values():
            left = int(c["expires"] - time.time())
            print("    %s  ttl %s, %s"
                  % (c["addr"], c["ttl"],
                     ("%dh%dm left" % (left // 3600, (left % 3600) // 60))
                     if left > 0 else "expired"))
    else:
        print("  claims     : none active (%d/%d slots free%s)"
              % (st["slots_free"], st["max_claims"],
                 ", %d expired" % len(st["expired_claims"]) if st["expired_claims"] else ""))
    if st["submissions"]:
        print("  submissions: %d" % len(st["submissions"]))
        for s in st["submissions"]:
            rm = load_manifest(s["result"], missing_ok=True) if s.get("result") else None
            grade = ""
            if rm:
                t = tier_of(rm)
                grade = "  [%s]" % t
                fam, level, attested = result_family(rm)
                if fam:
                    grade += "  %s (%s%s)" % (fam, level,
                                              "" if attested else ", advisory")
            an0 = None
            print("    %s by %s%s" % (s.get("result", "?"), s.get("addr", "?"), grade))

        # Congruence profile: agreement is only meaningful between independent
        # DERIVATIONS, so copies are reported separately rather than counted.
        an = settle_analysis(st)
        for key, g in an["ranked"]:
            for addr, (kind, why) in sorted(g.get("evidence", {}).items()):
                if kind != "reference": continue
                print("    ↳ %s: concurring reference (no quorum weight) — %s"
                      % (addr, why))

        # Backdating tell: an asserted-priority claim its anchor chain cannot cover.
        # Reported, never silently applied — the discrepancy IS the reputational
        # signal.
        flags = backdating_flags()
        seen_flags = set()
        for s in st["submissions"]:
            rid = s.get("result")
            fl = flags.get(rid)
            if not fl or rid in seen_flags: continue
            seen_flags.add(rid)
            print("  ⚠ TIME DISCREPANCY on %s" % rid)
            print("    %s asserts ts %s but its anchor bound is %s"
                  % (fl["asserted_by"],
                     time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(fl["asserted_ts"])),
                     fmt_bound(fl["asserted_bound"], fl["asserted_quality"])))
            print("    %s is treated as first publisher (asserted %s, anchor bound %s)"
                  % (fl["anchored_winner"],
                     time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(fl["winner_ts"])),
                     fmt_bound(fl["winner_bound"], fl["winner_quality"])))
            print("    An anchored upper bound beats an asserted timestamp: backdating")
            print("    is not prevented, it is made visible. Discount the asserting peer.")
        real = [(k, g) for k, g in an["ranked"]
                if not g.get("missing") and not k.startswith("<no-judgement:")]
        if an.get("structured"):
            print("  rubric     : %d enumerated criteria; agreement is per-criterion verdict"
                  % len(an["criteria_list"]))
            if an.get("prose_only"):
                print("    %d prose-only submission(s) carry no judgement vector (unassessed): %s"
                      % (len(an["prose_only"]), ", ".join(an["prose_only"])))
        # Observations are expected to differ: honest captures of a live system never
        # share bytes, so agreement/divergence is a category error for them. Only when
        # EVERY submission is a held T3
        # capture; mixed or missing results keep the congruence profile. Display only:
        # exit codes and settle are untouched.
        sub_ms = [load_manifest(s["result"], missing_ok=True) if s.get("result") else None
                  for s in st["submissions"]]
        if sub_ms and all(is_observation(x) for x in sub_ms):
            signers = {(s.get("addr") or "").lower() for s in st["submissions"]}
            print("  observations: %d T3 capture(s) from %d distinct signer(s); no congruence "
                  "computed (captures are expected to differ)"
                  % (len({x["id"] for x in sub_ms}), len(signers)))
            print("    accepting a capture means it followed the protocol, not that it is true")
        elif len(real) > 1:
            if an.get("structured"):
                print("  congruence : DIVERGENT — %d distinct verdict vectors" % len(real))
                for k, g in real:
                    print("    %s  %d signer(s)  %s"
                          % (k[len("verdict:"):], len(g["signers"]), ", ".join(sorted(g["ids"]))))
                print_criterion_table(an)
                print("    reviewers split on the criteria marked SPLIT; the prose says why")
            else:
                print("  congruence : DIVERGENT — %d distinct results" % len(real))
                for k, g in real:
                    print("    %s  %d signer(s)  %s"
                          % (k[:16], len(g["signers"]), ", ".join(sorted(g["ids"]))))
                if an["tier"] in MACHINE_TIERS:
                    print("    divergence on a machine tier locates where the pipeline is "
                          "not deterministic")
                else:
                    print("    divergence on a judged tier is differing reviewer judgement, "
                          "not nondeterminism")
            print("    see docs/DESIGN-notes-divergence-reports.md to publish the "
                  "comparison")
        elif real:
            k, g = real[0]
            fams = {f: c for f, c in g["families"].items()}
            nrefs = len(g.get("refs", ()))
            if an.get("structured"):
                line = ("  congruence : %d independent judgement(s) agree on verdicts %s"
                        % (len(g["derivers"]), k[len("verdict:"):]))
            else:
                line = "  congruence : %d independent derivation(s) agree" % len(g["derivers"])
            if nrefs:
                line += " (+%d concurring reference%s, uncounted)" % (
                    nrefs, "" if nrefs == 1 else "s")
            if fams:
                att = [f for f, c in fams.items() if c["attested"]]
                adv = [f for f, c in fams.items() if not c["attested"]]
                if att: line += "; families %s" % ", ".join(sorted(att))
                if adv: line += "; advisory-only %s" % ", ".join(sorted(adv))
            print(line)
            if an.get("structured"): print_criterion_table(an)
        if an["dq"]:
            top = real[0][1] if real else {"signers": set(), "families": {}}
            # Must match settle_analysis's own predicate (derived_attested, not the
            # looser attested count) or status and settle disagree on the same
            # displayed quantity — a copied submission under a different family
            # can make status report readiness settle correctly refuses.
            attf = sum(1 for f, c in top["families"].items() if c.get("derived_attested", 0) > 0)
            print("  quorum     : need k=%d independent derivations across %d attested "
                  "famil%s — have %d / %d"
                  % (an["quorum_k"], an["need_families"],
                     "y" if an["need_families"] == 1 else "ies",
                     len(top.get("derivers", ())), attf))
    if st["settled"]:
        act, ev = st["settled"]
        print("  settled    : %s by %s at %s" % (act, ev.get("addr"), ev.get("ts")))
        if ev.get("reason"): print("    reason: %s" % ev["reason"])
    return EX_OK if st["state"] == "accepted" else EX_NOT_MACHINE_VERIFIABLE


MAX_CHAIN_DEPTH = 10


def chain_depth(value):
    depth = int(value)
    if depth < 0: raise argparse.ArgumentTypeError("depth must be non-negative")
    return depth


def _chain_edges(m, all_rels=False):
    """Evidence edges out of a manifest: provenance inputs + workflow + citation links."""
    out = []
    prov = m.get("provenance") or {}
    for i in prov.get("inputs", []): out.append((i["id"], "input"))
    if prov.get("workflow"): out.append((prov["workflow"]["id"], "workflow"))
    for l in m.get("links", []):
        if all_rels or l.get("rel") in EVIDENCE_RELS:
            out.append((l["id"], l.get("rel", "related")))
    seen, uniq = set(), []
    for aid, rel in out:
        # Reachability metadata is never evidence, even if another manifest uses an
        # evidence-looking relation or provenance input to point at it. graph --rel
        # all may still display the structural edge.
        if not all_rels:
            target = load_manifest(aid, missing_ok=True)
            if aid.startswith("pa-") or (target and target.get("type") == "peer-announce"):
                continue
        if aid in seen: continue
        seen.add(aid); uniq.append((aid, rel))
    return uniq


def _chain_walk(root_id, depth_cap):
    visited, rows, truncated = set(), [], []
    stack = [(root_id, "self", 0)]
    while stack:
        aid, rel, depth = stack.pop(0)
        if aid in visited:
            rows.append((depth, aid, rel, None, "(already shown)"))
            continue
        visited.add(aid)
        m = load_manifest(aid, missing_ok=True)
        if m is None:
            rows.append((depth, aid, rel, None, "MISSING from registry"))
            continue
        rows.append((depth, aid, rel, m, ""))
        if depth >= depth_cap:
            if _chain_edges(m): truncated.append(aid)
            continue
        for child, crel in _chain_edges(m):
            stack.append((child, crel, depth + 1))
    return visited, rows, truncated


def _chain_grade(root, rows):
    grade, worst_node = None, root["id"]
    counts = {}
    for _depth, aid, _rel, m, note in rows:
        if note == "(already shown)": continue
        if is_method(m):
            continue  # methods are pinned by hash, not tiered
        t = tier_of(m) if m else "unverified"
        counts[t] = counts.get(t, 0) + 1
        if grade is None or TIER_RANK[t] > TIER_RANK[grade]:
            grade, worst_node = t, aid
    return grade, worst_node, counts


def _chain_availability(rows):
    """Dataset nodes in the walked chain that an outsider could not obtain.

    Reported ALONGSIDE the grade, never folded into it. The grade answers "how well was
    this checked"; this answers "by whom could it be checked". Conflating them would
    repeat the methods-carry-no-tier category error in the other direction.
    """
    restricted, undeclared = [], []
    for _depth, aid, _rel, m, note in rows:
        if note == "(already shown)" or m is None: continue
        if m.get("type") != "dataset": continue
        obt = availability_of(m)
        if obt == "restricted":
            restricted.append(aid)
        elif obt is None:
            undeclared.append(aid)
    return sorted(set(restricted)), sorted(set(undeclared))


def _status_exit(grade):
    if grade is None or grade in ("T0", "T1"): return EX_OK
    if grade in ("T2", "T3"): return EX_NOT_MACHINE_VERIFIABLE
    return EX_UNVERIFIED


def cmd_status(a):
    root = load_manifest(a.id)
    if root["type"] == "task":
        sys.exit(task_status(root))
    visited, rows, truncated = _chain_walk(a.id, a.depth)
    grade, worst_node, counts = _chain_grade(root, rows)

    restricted, undeclared = _chain_availability(rows)

    if a.brief:
        badge = "method" if is_method(root) else tier_of(root)
        avail = ""
        if restricted:
            avail = " unobtainable=%d" % len(restricted)
        elif undeclared:
            avail = " undeclared-availability=%d" % len(undeclared)
        print("%s [%s] chain=%s nodes=%d weakest=%s%s"
              % (root["id"], badge, grade or "n/a", len(visited), worst_node, avail))
        warn_anchor_drift()
        sys.exit(_status_exit(grade))

    _root_tier = tier_of(root)
    if not is_method(root) and _root_tier == "T3":
        _root_badge = "T3 %s" % t3_attestation_note(root)
    else:
        _root_badge = ("method — pinned by content hash" if is_method(root)
                       else tier_label(_root_tier))
    print("%s  %s  [%s]" % (root["id"], root.get("title", ""), _root_badge))
    print("evidence chain (provenance + %s links, depth cap %d):"
          % ("/".join(sorted(EVIDENCE_RELS)), a.depth))
    for depth, aid, rel, m, note in rows:
        indent = "  " * (depth + 1)
        if m is None:
            print("%s%-14s %-10s %s" % (indent, aid, rel, note or "MISSING"))
            continue
        meth = is_method(m)
        t = tier_of(m)
        if meth:
            tcol, tname = tier_display(m), "method"
        elif t == "T3":
            # The tier name alone ("attested") implies a signature exists; say
            # whether one actually does (issue #23), display-only.
            tcol, tname = t, t3_attestation_note(m)
        else:
            tcol, tname = t, TIER_NAME[t]
        if tcol == tname: tname = ""  # don't print "unverified unverified"
        crit = (m.get("verification") or {}).get("criteria")
        extra = note or ("— " + crit if crit and not meth and t in ("T1", "T2", "T3") else "")
        # Annotation only: an unpinned-userland baseline is not a weaker claim, so it
        # must never move the chain grade (see method-tier reasoning). Applies to any
        # native-executed artifact, whether it predates P3 (no exec record) or was
        # simply run with --exec native afterwards.
        if not meth and t in ("T0", "T1") and recorded_exec(m).get("mode") == "native":
            extra = (extra + "  " if extra else "") + "(pre-sandbox baseline)"
        print("%s%-14s %-10s %-4s %-11s %s %s"
              % (indent, aid, rel, tcol, tname, m.get("title", ""), extra))
    if truncated:
        print("  … depth cap reached at: %s" % ", ".join(truncated))
    print("nodes: %d  (%s)" % (len(visited),
                               ", ".join("%s×%d" % (t, counts[t]) for t in TIERS if t in counts)
                               or "no tiered evidence nodes"))
    if grade is None:
        print("chain grade: n/a  (method artifact — pinned by content hash, not tiered)")
        sys.exit(_status_exit(grade))
    if grade == "T3":
        # The weakest link sets the grade; if it's T3, say whether THAT node is
        # attested rather than leaving the reader to assume "T3" alone means signed.
        weakest_m = load_manifest(worst_node, missing_ok=True)
        grade_label = ("T3 %s" % t3_attestation_note(weakest_m)) if weakest_m is not None \
            else tier_label(grade)
    else:
        grade_label = tier_label(grade)
    print("chain grade: %s%s" % (grade_label,
                                 "" if worst_node == root["id"] else "  (weakest: %s)" % worst_node))
    # Availability is reported next to the grade and never inside it (see
    # _chain_availability). A strong grade over data only we hold is still a true grade;
    # it is just not the universally-checkable claim a reader would otherwise assume.
    if restricted:
        print("availability: %d chain input(s) are NOT independently obtainable: %s"
              % (len(restricted), ", ".join(restricted)))
        print("              no other party can re-run this chain end to end.")
    if undeclared:
        print("availability: %d dataset(s) in this chain declare no obtainability: %s"
              % (len(undeclared), ", ".join(undeclared)))
    print_ingest_unchecked(a.id, indent="")
    warn_anchor_drift()
    sys.exit(_status_exit(grade))


def _graph_badge(m):
    if m is None: return "[MISSING]"
    return "[method]" if is_method(m) else "[%s]" % tier_of(m)


def _graph_title(m):
    title = (m or {}).get("title", "")
    return title if len(title) <= 60 else title[:59] + "…"


def cmd_graph(a):
    """Render a depth-first provenance/citation tree. Graph inspection never judges."""
    root = load_manifest(a.id, missing_ok=True)
    if root is None:
        print("missing: %s is MISSING from registry" % a.id, file=sys.stderr)
        sys.exit(EX_FAIL)

    visited = set()

    def render(aid, rel, depth, prefix, last):
        branch = "" if depth == 0 else ("└─ " if last else "├─ ")
        edge = ""
        if depth:
            edge = " (%s)" % rel
            if rel not in EVIDENCE_RELS and rel not in ("input", "workflow"):
                edge = " (non-evidence: %s)" % rel
        m = load_manifest(aid, missing_ok=True)
        typ = m.get("type", "?") if m else "?"
        note = ""
        if aid in visited:
            note = " (seen above)"
        elif m is None:
            note = " MISSING from registry"
        print("%s%s%s %s %s %s%s%s"
              % (prefix, branch, aid, typ, _graph_badge(m), _graph_title(m),
                 edge, note))
        if aid in visited or m is None:
            return
        visited.add(aid)
        children = _chain_edges(m, all_rels=(a.rel == "all"))
        child_prefix = prefix + ("" if depth == 0 else ("   " if last else "│  "))
        if depth >= a.depth:
            if children: print("%s└─ … depth cap reached" % child_prefix)
            return
        for i, (child, crel) in enumerate(children):
            render(child, crel, depth + 1, child_prefix, i == len(children) - 1)

    render(a.id, "self", 0, "", True)
    return EX_OK


# ---------------- collections ----------------
# Membership is deliberately NOT an evidence relation: `part-of` never appears in
# EVIDENCE_RELS, so belonging to a collection cannot move a chain grade. Curation is
# an editorial claim about relevance, not a claim about correctness — conflating them
# would let a maintainer upgrade or poison the grade of work they merely listed.
PART_OF_REL = "part-of"


def collection_spec(m):
    with open(blob_read_path(m["content"]["sha256"])) as f: return json.load(f)


# Manifest hint that a collection's spec carries an `ingest` policy. It exists so that a
# peer holding only the MANIFEST can tell whether fetching the blob is necessary before
# publishing into the collection. Without it, refusing on "policy might exist" would have
# to refuse for every manifest-only collection, making a blob fetch a hard prerequisite of
# publishing anywhere — the dependency lazy replication exists to avoid.
#
# It is a hint, never the authority. Manifest fields are outside SIGNED_FIELDS and
# `validate_incoming` does not reject unknown manifest keys, so a peer could strip it.
# THE BLOB ALWAYS WINS: a policy in the spec is enforced whether or not the flag is set,
# and a flag with no policy in the spec enforces nothing. The flag only decides whether we
# insist on having the blob. `hub check` closes the stripping route for anything that goes
# through a hub by checking the flag against the blob, where both are held.
INGEST_POLICY_FLAG = "ingest_policy"


def spec_has_ingest_policy(spec):
    ing = (spec or {}).get("ingest") or {}
    return bool(isinstance(ing, dict) and (ing.get("forbidden_keys") or []))


def ingest_policy_for(cid):
    """Resolve a `part-of` target's forbidden-key policy.

    Returns (state, keys, note) where state is:
      "none"      nothing to enforce — no policy, or we cannot know one exists
      "enforce"   `keys` is the policy, read from the blob
      "unchecked" the manifest flags a policy but the spec is not held here

    A collection whose manifest we do not hold at all resolves to "none": with no
    manifest there is no flag, and refusing would make publishing depend on having
    replicated every collection someone might claim membership in. That is a known hole of
    the same shape as the strippable flag, and the same thing closes it — once the blob is
    held, the blob decides.
    """
    m = load_manifest(cid, missing_ok=True)
    if m is None or m.get("type") != "collection":
        return "none", [], ""
    flagged = bool(m.get(INGEST_POLICY_FLAG))
    blob = blob_read_path((m.get("content") or {}).get("sha256") or "")
    if not os.path.exists(blob):
        return ("unchecked", [], "") if flagged else ("none", [], "")
    try:
        with open(blob) as f:
            spec = json.load(f)
    except (OSError, ValueError):
        # The bytes are here but unreadable as a spec. If the manifest promised a policy
        # we must not quietly enforce nothing.
        return ("unchecked", [], "spec is held but not readable as JSON") if flagged \
            else ("none", [], "")
    keys = ((spec.get("ingest") or {}).get("forbidden_keys") or []) \
        if isinstance(spec.get("ingest"), dict) else []
    if keys and not flagged:
        return "enforce", keys, ("manifest carries no %s but the spec declares a policy; "
                                "the spec wins" % INGEST_POLICY_FLAG)
    if not keys and flagged:
        return "none", [], ("manifest carries %s but the spec declares no policy; nothing "
                            "to enforce" % INGEST_POLICY_FLAG)
    return ("enforce" if keys else "none"), keys, ""


def run_ingest_policy_gate(a):
    """Apply `part-of` collections' forbidden-key policies. Returns the skipped ids.

    Fails CLOSED, unlike the schema check this sits next to, and deliberately so: a
    missed schema check is caught downstream by whoever the malformed data breaks, while a
    leak cannot be undone once the bytes replicate. `hub check` is a backstop rather than a
    substitute — it runs on a PR, and `COLLABORATING.md` documents hub leads pushing
    straight to `main`, which never sees one.
    """
    targets = []
    for spec in (a.link or []):
        rel, _, dst = spec.partition(":")
        if rel == PART_OF_REL and dst and dst not in targets:
            targets.append(dst)
    if not targets:
        return []
    allow = bool(getattr(a, "allow_unchecked_ingest", False))
    skipped, blocking = [], []
    for cid in targets:
        state, keys, note = ingest_policy_for(cid)
        if note:
            print("warning: %s: %s" % (cid, note), file=sys.stderr)
        if state == "none":
            continue
        if state == "unchecked":
            if not allow:
                sys.exit("error: %s declares an ingest policy (%s) but its spec is not held "
                         "here, so\n"
                         "       the policy cannot be applied to %s.\n"
                         "         commons fetch %s        # get the policy, then retry\n"
                         "         --allow-unchecked-ingest  # publish without applying it\n"
                         "       Refusing rather than warning: once a blob replicates, "
                         "retraction is\n"
                         "       best-effort recall and not erasure."
                         % (cid, INGEST_POLICY_FLAG, os.path.basename(a.file), cid))
            skipped.append(cid)
            print("warning: %s: ingest policy NOT applied (--allow-unchecked-ingest); "
                  "recorded in the ledger" % cid, file=sys.stderr)
            continue
        findings = forbidden_key_findings(a.file, keys)
        for sev, label, lineno, excerpt in findings:
            print("%-5s %s line %s: %s [%s]"
                  % (sev.upper(), cid, lineno or "?", label, excerpt), file=sys.stderr)
        blocking += [(cid, f) for f in findings if f[0] == "block"]
    if blocking:
        # No --allow flag for this one on purpose. An unchecked policy is a gap in
        # coverage, which an operator may knowingly accept; a HIT is the policy doing its
        # job, and the fix is to publish different bytes.
        sys.exit("error: refusing to publish — %d forbidden field name(s) from the ingest "
                 "policy of %s.\n"
                 "       These identifiers are the collection's declared leak risk, not a "
                 "credential-shaped\n"
                 "       false positive, so there is no override: publish the anonymised "
                 "export instead."
                 % (len(blocking), ", ".join(sorted({cid for cid, _ in blocking}))))
    return skipped


def forbidden_key_findings(path, keys):
    """Bridge to the lint module, which owns every content-scanning rule."""
    sys.path.insert(0, LIB)
    try:
        import publish_lint
    except ImportError:
        print("warning: secret lint unavailable (lib/publish_lint.py missing); ingest "
              "policy NOT applied", file=sys.stderr)
        return []
    finally:
        sys.path.pop(0)
    return publish_lint.forbidden_key_findings(path, keys)


def ingest_unchecked_for(aid):
    """Collections whose ingest policy was skipped when this artifact was published."""
    out = []
    for e, _p, _i, _l in ledger_lines():
        if e.get("id") != aid or e.get("action") not in ("publish", "republish"):
            continue
        for cid in str(e.get("ingest_unchecked") or "").split(","):
            if cid and cid not in out:
                out.append(cid)
    return out


# Threshold for `duplicate_scope_collections()`'s near-identical-scope advisory.
# Chosen against a real accidental pair (two collections carrying byte-identical
# scope text, ratio 1.0) with headroom for minor copyedits between the two; an
# example policy for a display-only heuristic, not a protocol constant.
DUPLICATE_SCOPE_RATIO = 0.85


def duplicate_scope_collections(cid, spec):
    """Other locally-held collections with near-identical scope, not supersede-linked.

    Front-door disambiguation (2026-08-28, Option B §3 of the 2026-08-22
    namespace-admission note): a second collection can claim the same subject by
    accident (as happened here during a 2026-08-05 key rotation) or by an
    adversarial mirror, and nothing on the browse surface said so. Supersede-linked
    pairs are excluded here because that relationship already has its own,
    stronger marker (`superseders_map`) — this advisory is for the case where
    nobody has declared a relationship between the two at all.
    """
    scope = (spec.get("scope") or "").strip()
    if not scope:
        return []
    superseders = superseders_map()
    out = []
    for other in iter_manifests():
        if other.get("type") != "collection" or other["id"] == cid:
            continue
        # Either direction of a supersedes link already has its own marker.
        if cid in superseders.get(other["id"], []) or other["id"] in superseders.get(cid, []):
            continue
        try:
            other_spec = collection_spec(other)
        except (OSError, ValueError, KeyError):
            continue
        other_scope = (other_spec.get("scope") or "").strip()
        if not other_scope:
            continue
        ratio = difflib.SequenceMatcher(None, scope, other_scope).ratio()
        if ratio >= DUPLICATE_SCOPE_RATIO:
            out.append(other["id"])
    return sorted(out)


def iter_manifests():
    for fn in sorted(os.listdir(ART)):
        if not fn.endswith(".json"): continue
        with open(os.path.join(ART, fn)) as f:
            yield json.load(f)


def self_declared_members(cid):
    """Artifacts claiming membership by linking `part-of:<cid>` at themselves.

    Anyone may claim to belong to any collection — there are no membership
    permissions by design. The claim is free; the endorsement is what carries weight.
    """
    out = []
    for m in iter_manifests():
        for l in m.get("links", []):
            if l.get("rel") == PART_OF_REL and l.get("id") == cid:
                out.append(m)
                break
    return out


def collection_open_tasks(cid):
    """(open, claimed, other) task states among tasks routed to this collection."""
    openq, claimed, other = [], [], []
    for m in iter_manifests():
        if m.get("type") != "task": continue
        try: spec = task_spec(m)
        except (OSError, ValueError): continue
        if cid not in (spec.get("collections") or []): continue
        st = task_state(m)
        (openq if st["state"] == "open" else
         claimed if st["state"] == "claimed" else other).append((m, st))
    return openq, claimed, other


def _member_line(m, extra=""):
    t = "method" if is_method(m) else tier_of(m)
    # Same markers as `_fmt_row`'s list/search rows: a collection's front door is where
    # a newcomer decides whether to trust a member enough to build on it, and that
    # decision needs the same obtainability and freshness signals the browse surfaces
    # give. Freshness matters most here — this is the view where a year-old measurement
    # and this morning's otherwise render identically.
    avail = availability_display(m)
    title = (m.get("title") or "")[:44]
    age = age_display(m)
    if age:
        title = "[%s] %s" % (age, title)
    if avail:
        title = "[%s] %s" % (avail, title)
    return "%-14s %-13s %-9s %s%s" % (m["id"], m.get("type", "?"), t, title, extra)


def cmd_collection(a):
    if a.coll_cmd == "add-member":
        return cmd_collection_add_member(a)
    if getattr(a, "member", None) or getattr(a, "role", None):
        sys.exit("error: `collection show` takes only a collection id")
    return cmd_collection_show(a)


def _spec_member_ids(spec):
    return [x["id"] for x in (spec.get("members") or [])
            if isinstance(x, dict) and x.get("id")]


def _maintainer_signed_successors(cid, spec):
    """Successors of `cid` whose publish was signed by one of ITS OWN maintainers.

    The maintainers that matter at each hop are those of the collection being superseded,
    not those of the one we started from — the same comparison `supersede_decision` makes.
    """
    maint = {(x.get("addr") or "").lower() for x in ((spec or {}).get("maintainers") or [])
             if isinstance(x, dict) and x.get("addr")}
    if not maint:
        return []
    return [c for c, signer in superseding_collections(cid)
            if signer and signer.lower() in maint]


def _maintainer_supersede_chain(cid, spec, limit=32):
    """(immediate successors, tip, hop count) following a LINEAR maintainer-signed chain.

    A one-hop lookup made the suggested command wrong whenever a collection had been
    revised twice: the operator was pointed at a version that is itself retired, got
    refused again, and had to walk the chain by hand. The dropped-member list was computed
    against the same near successor, so it understated the loss as well. Walking to the tip
    fixes both.

    Stops at the first fork (more than one successor) and at the first hop whose spec is not
    held, since without the spec there is no way to say whether the next supersede was
    maintainer-signed. Both cases return the last version we could actually verify, which
    keeps the suggestion honest rather than confident.
    """
    first = _maintainer_signed_successors(cid, spec)
    if len(first) != 1:
        return first, None, 0
    tip, hops, seen = first[0], 1, {cid, first[0]}
    for _ in range(limit):
        m = load_manifest(tip, missing_ok=True)
        if m is None or not os.path.exists(blob_read_path((m.get("content") or {}).get("sha256") or "")):
            break
        try:
            nxt = _maintainer_signed_successors(tip, collection_spec(m))
        except (OSError, ValueError):
            break
        if len(nxt) != 1 or nxt[0] in seen:
            break          # a fork, a dead end, or a cycle: stop at the last verified hop
        tip, hops = nxt[0], hops + 1
        seen.add(tip)
    return first, tip, hops


def _refuse_superseded_base(a, spec):
    """Refuse to build an update on a retired version of the collection.

    This is the one failure a hand-edit cannot catch and the main reason the command
    earns its place. A collection is content-addressed, so "the collection" is whichever
    version nothing supersedes. Adding a member to a retired one republishes a spec that
    predates every endorsement made since, and because the result is a well-formed,
    correctly-signed collection that passes `hub check`, the dropped members simply stop
    being endorsed with nothing anywhere reporting it.

    Only MAINTAINER-SIGNED supersedes count, which is the `maintainer-signed` policy
    subscribers already apply (`supersede_decision`). Counting every supersede claim would
    hand any peer a veto over curation: publish a collection linking
    `supersedes:cl-theirs` and the real maintainer can no longer add a member to their own
    collection without `--force`. A fork nobody follows must not retire anything.

    `superseding_collections()` sees only locally-held manifests, so this catches the
    realistic case (a maintainer working from a stale checkout of their own hub) and cannot
    catch a successor that exists only on a peer. It is a guard, not a guarantee.
    """
    supers, tip, hops = _maintainer_supersede_chain(a.id, spec)
    if not supers:
        return
    lines = ["%s has been superseded, so this would republish a stale spec." % a.id]
    if len(supers) > 1:
        # A fork: picking one successor for the operator would be choosing a winner in an
        # editorial dispute, which is not this command's business.
        lines.append("  %d successors exist, so there is no single current version:" % len(supers))
        lines += ["    %s" % s for s in supers]
        lines.append("  Resolve the fork first, then add to whichever version wins.")
    else:
        lines.append("  Use the current version instead%s:"
                     % (" (%d supersedes later)" % hops if hops > 1 else ""))
        lines.append("    commons collection add-member %s %s%s"
                     % (tip, a.member, " --role %s" % a.role if a.role else ""))
    # Name the concrete harm where it can be computed: which endorsements would vanish.
    # Measured against the TIP, not the near successor — against one hop of a longer chain
    # this understated the loss, which is the wrong direction for a warning to be wrong in.
    here = set(_spec_member_ids(spec))
    for s in (supers if len(supers) > 1 else [tip]):
        succ = load_manifest(s, missing_ok=True)
        if not succ or not os.path.exists(blob_read_path(succ["content"]["sha256"])):
            continue
        lost = [x for x in _spec_member_ids(collection_spec(succ)) if x not in here]
        if lost:
            lines.append("  Endorsed in %s but absent here, so they would be dropped:" % s)
            lines += ["    %s" % x for x in lost]
    if not a.allow_retired_base:
        # The hint is appended only here, so the warning path below must NOT slice it off:
        # doing that dropped the last line of the dropped-member list, which is the one
        # thing the guard exists to name, on the only path where a member is really lost.
        lines.append("  --allow-retired-base republishes from this version anyway "
                     "(a deliberate fork).")
        sys.exit("\n".join(["error: " + lines[0]] + lines[1:]))
    print("\n".join(["warning: " + lines[0]] + lines[1:]), file=sys.stderr)


def cmd_collection_add_member(a):
    """Endorse an artifact: republish the collection with it added, superseding the old one.

    Issue #5 follow-up. Endorsement used to be a hand-edit of collection JSON on the
    maintainer's critical path (COLLABORATING.md §5), one typo away from a mangled
    spec. This does exactly what the documented hand-edit did (new content, same lint as
    `publish collection`, `--link supersedes:<old>`), and nothing more: collections
    are content-addressed, so "update" is always a new artifact that supersedes the old.
    """
    old = load_manifest(a.id)
    if old["type"] != "collection":
        sys.exit("error: %s is a %s, not a collection" % (a.id, old["type"]))
    member = a.member
    if not member:
        sys.exit("error: usage: commons collection add-member <cl-id> <artifact-id> [--role ROLE]")
    if not re.fullmatch(r"(%s)-[0-9a-f]{8}" % "|".join(sorted(TYPES.values())), member):
        sys.exit("error: %r is not a well-formed artifact id" % member)
    if member == a.id:
        sys.exit("error: a collection cannot be a member of itself")
    require_signing("collection updates")
    blob = blob_read_path(old["content"]["sha256"])
    if not os.path.exists(blob):
        sys.exit("error: %s is held manifest-only; fetch its content first "
                 "(`commons fetch %s`) so the update starts from the real spec" % (a.id, a.id))
    spec = collection_spec(old)
    _refuse_superseded_base(a, spec)
    # Only a listed maintainer's supersede is followed by subscribers
    # (supersede_decision): an outsider's "update" would be a fork nobody follows, so
    # say so up front rather than publishing it silently.
    me = my_addr().lower()
    maint = {(x.get("addr") or "").lower() for x in (spec.get("maintainers") or [])
             if isinstance(x, dict)}
    if me not in maint and not a.force:
        sys.exit("error: you (%s) are not a listed maintainer of %s. Subscribers only follow\n"
                 "       a supersede signed by a maintainer, so this would publish a fork, not an\n"
                 "       update. Use --force to publish it anyway." % (me, a.id))
    raw_members = spec.get("members") or []
    # Belt and braces: `lint_collection_spec` refuses a non-dict member entry, and
    # --force does not bypass it, so a spec this malformed cannot be produced by
    # `publish collection` — only by one that arrived some other way. Worth a loud
    # refusal rather than a filter, because dropping the entries we cannot parse would
    # be a silent deletion dressed up as normalisation, and worth a refusal rather than
    # an AttributeError two lines later.
    if any(not isinstance(x, dict) for x in raw_members):
        sys.exit("error: %s has malformed members[] entries (not JSON objects). Fix the "
                 "spec by hand and republish; add-member will not rewrite them." % a.id)
    members = list(raw_members)
    existing = [x for x in members if x.get("id") == member]
    role = a.role
    # A role is free text that only `method` and `instance` are read for, so a typo is
    # not an error — it is a silently different role, and `collection show` will file the
    # member under a bucket the maintainer did not mean. Warn on a role seen nowhere else
    # in the spec; never refuse, since a genuinely new role has to be addable.
    known_roles = {x.get("role") for x in members if x.get("role")}
    if role and role not in known_roles and role not in (ROLE_METHOD, ROLE_INSTANCE):
        print("warning: role %r appears nowhere else in %s (roles in use: %s). Publishing "
              "it as a new role — check the spelling." % (
                  role, a.id, ", ".join(sorted(known_roles)) or "none"),
              file=sys.stderr)
    if existing:
        cur = existing[0].get("role")
        if role is None or role == cur:
            sys.exit("error: %s is already a member of %s%s; nothing to publish"
                     % (member, a.id, " (role %s)" % cur if cur else ""))
        existing[0]["role"] = role   # role change: same member, new role
        change = "role %s -> %s" % (cur or "(none)", role)
    else:
        entry = {"id": member}
        if role: entry["role"] = role
        members.append(entry)
        change = "added" + (" as %s" % role if role else "")
    spec["members"] = members
    # Warn (never refuse) when the member isn't held: lazy replication makes
    # endorsing a not-yet-fetched artifact legal, same as lint_collection_spec.
    if load_manifest(member, missing_ok=True) is None:
        print("warning: %s is not held locally; endorsing it anyway (lazy replication)"
              % member, file=sys.stderr)
    # Issue #5's member-schema conformance check belongs here: after `members` is settled
    # and before the bytes are pinned, so a non-conforming artifact is refused the
    # MEMBERSHIP rather than quarantined as an artifact (the member-schema design puts
    # the endorsement gate on this command). Three things that check will need from this spot:
    #   - the result is tri-state, and **unchecked never counts as ok** — a schema or member
    #     blob held manifest-only must warn, not pass;
    #   - `publish collection` needs the same gate, so it belongs in a shared function
    #     rather than inline here;
    #   - its override wants to be its own `--allow-…` hatch, not `--force` and not
    #     `--allow-retired-base`, for the reason given where those are defined.
    ensure_dirs()
    fd, path = tempfile.mkstemp(prefix="collection-", suffix=".json", dir=ROOT)
    try:
        with os.fdopen(fd, "w") as f:
            # No sort_keys: the blob necessarily changes (a new member is new content and
            # so a new id), but nothing except `members` should. Python preserves object
            # order on load, so dumping unsorted keeps the maintainer's own key order and
            # keeps the diff between two versions of a spec readable. Assigning back to
            # the existing `members` key also leaves it in its original position.
            json.dump(spec, f, indent=2)
            f.write("\n")
        links = ["supersedes:" + a.id]
        # Carry forward non-supersedes links (e.g. cites) so the update loses nothing.
        for l in old.get("links") or []:
            if isinstance(l, dict) and l.get("rel") and l.get("id") and l["rel"] != "supersedes":
                links.append("%s:%s" % (l["rel"], l["id"]))
        # A role flip-back (r1 -> r2 -> r1) reproduces an earlier version's exact bytes, so
        # `publish` would report "already published … manifest unchanged" and exit 0 while
        # the live head stayed on r2 — a success message over a state the operator did not
        # get. Collections are content-addressed, so the resulting id is knowable here.
        newid = "%s-%s" % (TYPES["collection"], sha256_file(path)[:8])
        if newid != a.id and load_manifest(newid, missing_ok=True) is not None:
            sys.exit("error: that change reproduces %s, which already exists here — most "
                     "likely a role\n"
                     "       change back to what an earlier version already said. "
                     "Publishing would be a\n"
                     "       no-op reported as success, leaving %s as the live version. "
                     "Add to %s\n"
                     "       instead, or supersede it deliberately with `publish "
                     "collection`." % (newid, a.id, a.id))
        print("%s: %s %s" % (a.id, member, change), file=sys.stderr)
        cmd_publish(argparse.Namespace(
            type="collection", file=path, title=old.get("title") or "Collection",
            description=old.get("description") or "", tag=list(old.get("tags") or []),
            input=[], workflow=None, link=links, tier=None, criteria=None, param=[],
            # Carried forward for the same reason as title/description/tags: an endorsement
            # must not silently strip a disclosure the maintainers had made.
            license=old.get("license"), allow_secrets=False, force=False, agent=a.agent))
    finally:
        try:
            os.unlink(path)
        except FileNotFoundError:
            pass


def cmd_collection_show(a):
    """Render a collection's two membership views, which are allowed to disagree.

    Curated-in is an editorial list signed by whoever published the collection.
    Self-declared is artifacts pointing `part-of` at it. Neither view is authoritative
    over the other: showing only the curated list would hide contributions the
    maintainers have not looked at yet, and showing only self-declarations would let
    anyone appear endorsed by asserting it.
    """
    m = load_manifest(a.id)
    if m["type"] != "collection":
        sys.exit("error: %s is a %s, not a collection" % (a.id, m["type"]))
    spec = collection_spec(m)
    maints = spec.get("maintainers") or []
    maint_addrs = {(x.get("addr") or "").lower() for x in maints if isinstance(x, dict)}

    print("%s  %s" % (m["id"], m.get("title", "")))
    print("scope: %s" % (spec.get("scope") or "(none)"))

    # Front-door disambiguation (2026-08-28):
    # advisory only, never an exit code, mirroring the anchor-drift precedent.
    superseders = superseders_map().get(m["id"], [])
    if superseders:
        print("⚠ SUPERSEDED by %s — this collection is retired; use the newer one"
              % ", ".join(superseders))
    dup = duplicate_scope_collections(m["id"], spec)
    if dup:
        print("⚠ duplicate-scope: %s share near-identical scope text and are not "
              "linked by supersedes — this may be a second front door for the same "
              "topic" % ", ".join(dup))

    # Who actually published this editorial list, and are they a maintainer? The
    # manifest can name anyone as a maintainer; only the signed publish event says
    # who asserted it.
    fp = first_publisher(m["id"])
    if fp:
        peers = load_peers()
        who = find_peer(fp[0], peers) or {}
        mark = "maintainer" if fp[0] in maint_addrs else "NOT a listed maintainer"
        print("curated by: %s (agent=%s) — %s"
              % (fp[0], who.get("agent") or "unknown", mark))
        if fp[0] not in maint_addrs:
            print("  ⚠ the signed publisher of this list is not among its own")
            print("    maintainers — the endorsement below is weaker than it looks")
    else:
        print("curated by: (no verified signed publish event — endorsements "
              "unattributable)")
    # The header below used to say "ENDORSED — signed editorial list"
    # unconditionally, directly contradicting the "curated by" line above on an
    # unsigned collection (issue #23). Same signal this function already computed;
    # display-only, no change to membership or any exit code.
    curated_header = ("curated-in (ENDORSED — signed editorial list)" if fp
                      else "curated-in (UNSIGNED — editorial list, not attributable)")
    print("maintainers: %s" % (", ".join(
        "%s%s" % (x.get("agent") or "?", " <%s>" % x["addr"] if x.get("addr") else "")
        for x in maints if isinstance(x, dict)) or "(none)"))

    members = [x for x in (spec.get("members") or []) if isinstance(x, dict) and x.get("id")]
    declared = self_declared_members(m["id"])
    declared_ids = {x["id"] for x in declared}
    curated_ids = {x["id"] for x in members}

    # Analysis templates (stage 2): when the maintainers endorse a
    # method, split the list so a newcomer sees "here is how this category is
    # analyzed; here are the analyses that followed it" instead of N undifferentiated
    # rows. Pure read-side: role strings and `applies` edges already exist; nothing
    # here changes state or grades. Collections with no `role: method` member render
    # exactly as before.
    method_entries = [x for x in members if (x.get("role") or "") == ROLE_METHOD]
    method_ids = [x["id"] for x in method_entries]
    applied_by = applied_by_index() if method_entries else {}
    superseders_all = superseders_map() if method_entries else {}

    def _applies_note(mm):
        """' applies sk-…' + markers for an instance row (method view only)."""
        tgts = applies_targets(mm)
        if not tgts:
            return "  (no applies link)" if method_entries else ""
        parts = []
        for t in tgts:
            mark = ""
            if t not in method_ids:
                mark = " (different method)"
                # Open question 2 of the note: an instance that applied a version the
                # collection has since superseded is CORRECT about what it did; say
                # only that the version is old.
                if any(s in method_ids for s in superseders_all.get(t, [])):
                    mark = " (superseded)"
            parts.append("%s%s" % (t, mark))
        return "  applies %s" % ", ".join(parts)

    def _render_entry(entry):
        mm = load_manifest(entry["id"], missing_ok=True)
        role = entry.get("role") or "member"
        if mm is None:
            print("  %-14s %-13s %-9s MISSING from this registry  [role %s]"
                  % (entry["id"], "?", "?", role))
            return
        extra = "  [role %s]" % role
        if role == ROLE_METHOD:
            n = len(applied_by.get(entry["id"], []))
            extra += "  applied by %d" % n
            if mm.get("type") == "skill" and not is_method_skill(mm):
                extra += "  ⚠ not tagged %s" % METHOD_TAG
            cats = method_categories(mm)
            if cats: extra += "  category:%s" % ",".join(cats)
            if method_rubric(mm): extra += "  rubric:%d" % len(method_rubric(mm))
        elif role == ROLE_INSTANCE or method_entries:
            extra += _applies_note(mm)
        if entry["id"] in declared_ids: extra += "  (also self-declared — mutual)"
        print("  " + _member_line(mm, extra))

    _curated_tag = "ENDORSED" if fp else "UNSIGNED"
    print("")
    print("%s: %d" % (curated_header, len(members)))
    if not members: print("  (none)")
    if method_entries:
        instances = [x for x in members if (x.get("role") or "") == ROLE_INSTANCE]
        other = [x for x in members if x not in method_entries and x not in instances]
        print("  method (%s): %d" % (_curated_tag, len(method_entries)))
        for entry in method_entries: _render_entry(entry)
        print("  instances (%s): %d" % (_curated_tag, len(instances)))
        if not instances: print("    (none yet — see `wanted:` below)")
        for entry in instances: _render_entry(entry)
        if other:
            print("  other curated-in: %d" % len(other))
            for entry in other: _render_entry(entry)
        # Instances that applied the endorsed method but were never curated in are
        # the maintainer's review queue; surface them here rather than only as
        # undifferentiated self-declared rows.
        pending = sorted({i for mid in method_ids for i in applied_by.get(mid, [])}
                         - curated_ids)
        if pending:
            print("  applied the method, not yet endorsed: %d" % len(pending))
            for iid in pending:
                mm = load_manifest(iid, missing_ok=True)
                if mm is not None:
                    print("  " + _member_line(mm, "  (applies, unendorsed)"))
    else:
        for entry in members: _render_entry(entry)

    unendorsed = [x for x in declared if x["id"] not in curated_ids]
    print("")
    print("self-declared (CLAIMED — not endorsed by the maintainers): %d"
          % len(unendorsed))
    if not unendorsed: print("  (none)")
    for mm in unendorsed:
        print("  " + _member_line(mm, "  (claimed)" + (_applies_note(mm) if method_entries else "")))
    if unendorsed:
        print("  A claim of membership is free and unmoderated by design; ingest trust")
        print("  already governs whose artifacts you hold at all. To endorse, republish")
        print("  the collection with these ids in `members` (supersedes the old list).")

    openq, claimedq, otherq = collection_open_tasks(m["id"])
    print("")
    print("open tasks: %d  (%d claimed, %d settled/expired)"
          % (len(openq), len(claimedq), len(otherq)))
    for tm, st in openq[:10]:
        ts = st["spec"]
        print(("  %-14s pri %s  %-4s %s" + task_availability_marker(ts))
              % (tm["id"], ts.get("priority", "?"),
                 (ts.get("verification") or {}).get("tier", "?"),
                 (ts.get("objective") or "")[:52]))
    if openq:
        print("  claim one: commons queue --collection %s   then  commons claim <tk-…>"
              % m["id"])
    if spec.get("task_criteria"):
        print("")
        print("wanted: %s" % spec["task_criteria"])
    if spec.get("open_questions"):
        print("")
        print("open questions:")
        for q in spec["open_questions"]: print("  - %s" % q)


# ---------------- federation ----------------
def git(*args, cwd=None, check=True, capture=True):
    r = subprocess.run(["git"] + list(args), cwd=cwd or ROOT,
                       capture_output=capture, text=True, timeout=600)
    if check and r.returncode != 0:
        sys.exit("error: git %s failed: %s" % (" ".join(args),
                                              (r.stderr or r.stdout).strip()))
    return r


def quarantine(reason, detail):
    os.makedirs(REG, exist_ok=True)
    with open(QUARANTINE, "a") as f:
        f.write(json.dumps({"ts": now(), "reason": reason, "detail": detail},
                           sort_keys=True) + "\n")


def incoming_publishers(ledger_root):
    """artifact id -> {addrs that signed a publish entry for it} from incoming logs.

    Only signatures that actually verify count; a forged addr field proves nothing.
    """
    out = {}
    if not os.path.isdir(ledger_root): return out
    for fn in sorted(os.listdir(ledger_root)):
        if not fn.endswith(".jsonl"): continue
        for line in open(os.path.join(ledger_root, fn)).read().splitlines():
            if not line.strip(): continue
            try: e = json.loads(line)
            except ValueError: continue
            if e.get("action") not in ("publish", "republish"): continue
            addr, sig, aid = e.get("addr"), e.get("sig"), e.get("id")
            if not (addr and sig and aid): continue
            ok, _ = verify_entry(e, sig, addr)
            if ok: out.setdefault(aid, set()).add(addr)
    return out


def validate_incoming(m, blob_dir, peers, require_sig, min_trust_ok,
                      publisher_addrs=None):
    """Gate one incoming manifest. Returns list of rejection reasons ([] = accept).

    Deliberately paranoid: everything here is attacker-controlled input.
    """
    publisher_addrs = publisher_addrs or {}
    bad = []
    aid = m.get("id")
    if not aid or not isinstance(aid, str):
        return ["manifest has no usable id"]

    # schema major
    s = m.get("schema")
    if s and str(s).split(".")[0] != SCHEMA_MAJOR:
        bad.append("unsupported schema %r" % s)

    # structural sanity
    if m.get("type") not in TYPES:
        bad.append("unknown artifact type %r" % m.get("type"))
    content = m.get("content") or {}
    digest = content.get("sha256")
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest or ""):
        bad.append("missing or malformed content.sha256")
        return bad

    # id must actually derive from the content hash: ids are load-bearing, so a
    # mismatch means the sender is lying about what an id refers to.
    prefix = TYPES.get(m.get("type"), "")
    if prefix and aid != "%s-%s" % (prefix, digest[:8]):
        bad.append("id %s does not derive from content hash %s" % (aid, digest[:8]))

    # blob must be present and match (when the sender shipped it)
    incoming_blob = blob_read_path_at(blob_dir, digest)
    if os.path.exists(incoming_blob):
        if sha256_file(incoming_blob) != digest:
            bad.append("blob content does not match its hash")

    # id collision with DIFFERENT local content: impossible without a hash break or
    # malice, so this is a hard reject rather than a merge decision.
    local = load_manifest(aid, missing_ok=True)
    if local is not None and local["content"]["sha256"] != digest:
        bad.append("id collision: local %s has different content (%s vs %s)"
                   % (aid, local["content"]["sha256"][:12], digest[:12]))

    # --- identity + trust ---
    att = (m.get("verification") or {}).get("attested_by") or {}
    signer = att.get("addr")
    if require_sig and not signer:
        bad.append("unsigned artifact and COMMONS_REQUIRE_SIG=1")
    if signer:
        peer = find_peer(signer, peers)
        if peer is None:
            bad.append("attester %s not in peer registry" % signer)
        elif not min_trust_ok(peer, m):
            bad.append("peer %s trust=%s insufficient for type %s"
                       % (signer, peer.get("trust"), m.get("type")))

    # Executable artifacts are gated on the PUBLISHER's trust, not the attester's.
    # Methods carry no tier and usually no attestation, so keying this off the
    # attestation would let any unsigned workflow sail past a datasets-only peer —
    # the cheapest possible bypass of the entire policy. Attribution comes from the
    # signed ledger entry that published it.
    if m.get("type") in METHOD_TYPES:
        publishers = publisher_addrs.get(aid, set())
        if not publishers:
            bad.append("executable %s has no signed publish entry — cannot attribute "
                       "incoming code to a peer" % m.get("type"))
        else:
            trusted = [p for p in publishers
                       if (find_peer(p, peers) or {}).get("trust") == "full"]
            if not trusted:
                who = ", ".join(sorted(publishers))
                bad.append("executable %s published by %s — trust=full required for "
                           "code (type %s)" % (m.get("type"), who, m.get("type")))
    return bad


def trust_allows(peer, m):
    """datasets-only peers may not ship executable methods."""
    trust = (peer or {}).get("trust", "none")
    if trust == "none": return False
    if trust == "full": return True
    return m.get("type") not in METHOD_TYPES  # datasets-only


# Subscription is local pinning intent, never registry content. It deliberately does
# not scope pull: manifests still pass through the full ingest gate, and later sync
# stages use this file only to decide which already-accepted blobs to materialize.
SUBSCRIPTION_BLOBS = ("manifests-only", "members", "all")
SUBSCRIPTION_FOLLOW = ("none", "maintainer-signed", "any")


def load_subscriptions():
    if not os.path.exists(SUBSCRIPTIONS):
        return {"schema": SCHEMA, "subscriptions": []}
    try:
        with open(SUBSCRIPTIONS) as f:
            data = json.load(f)
    except (OSError, ValueError) as e:
        sys.exit("error: cannot read subscriptions.json: %s" % e)
    if not isinstance(data, dict) or data.get("schema") != SCHEMA:
        sys.exit("error: subscriptions.json must declare schema %r" % SCHEMA)
    rows = data.get("subscriptions")
    if not isinstance(rows, list):
        sys.exit("error: subscriptions.json subscriptions must be a list")
    return data


def save_subscriptions(data):
    os.makedirs(REG, exist_ok=True)
    tmp = SUBSCRIPTIONS + ".tmp.%d" % os.getpid()
    try:
        with open(tmp, "w") as f:
            json.dump(data, f, indent=2, sort_keys=True)
            f.write(chr(10))
            f.flush()
            os.fsync(f.fileno())
        os.replace(tmp, SUBSCRIPTIONS)
    finally:
        if os.path.exists(tmp):
            os.unlink(tmp)


def collection_subscription_spec(cid, remote):
    """Read a collection policy blob locally or from its fetched remote ref."""
    cm = load_manifest(cid, missing_ok=True)
    if cm is None or cm.get("type") != "collection":
        return None, "pending: collection not replicated"
    try:
        path = blob_read_path(cm["content"]["sha256"])
        if os.path.exists(path):
            with open(path) as f:
                return json.load(f), None
        raw = remote_blob_text(cm, remote)
        if raw is None:
            return None, "pending: collection metadata blob unavailable"
        return json.loads(raw), None
    except (OSError, ValueError, KeyError) as e:
        return None, "pending: collection metadata unreadable (%s)" % e


def superseding_collections(cid):
    """Accepted collection manifests that explicitly supersede cid."""
    out = []
    for m in iter_manifests():
        if m.get("type") != "collection":
            continue
        if any(link.get("rel") == "supersedes" and link.get("id") == cid
               for link in (m.get("links") or []) if isinstance(link, dict)):
            fp = first_publisher(m["id"])
            out.append((m["id"], fp[0] if fp else None))
    return sorted(out)


def supersede_decision(row):
    """Inspect the next hop without changing local subscription state."""
    cid = row.get("collection", "")
    cm = load_manifest(cid, missing_ok=True)
    if cm is None or cm.get("type") != "collection":
        return None, "pending: collection not replicated"
    candidates = superseding_collections(cid)
    if not candidates:
        return None, "current"
    policy = row.get("follow_supersedes", "maintainer-signed")
    candidate, signer = candidates[0]
    if len(candidates) > 1:
        return {"collection": candidate, "signer": signer,
                "candidates": candidates, "follow": False,
                "reason": "multiple superseding collections require review"},                "supersedes available (pending review)"
    if signer is None:
        return {"collection": candidate, "signer": None,
                "follow": False, "reason": "supersede has no verified signed publish entry"},                "supersedes available (pending review)"
    if policy == "none":
        return {"collection": candidate, "signer": signer,
                "follow": False, "reason": "follow_supersedes=none"},                "supersedes available (pending review)"
    if policy == "any":
        return {"collection": candidate, "signer": signer, "follow": True},                "supersedes available"
    spec, error = collection_subscription_spec(cid, row.get("remote", "origin"))
    if error:
        return {"collection": candidate, "signer": signer,
                "follow": False, "reason": error},                "supersedes available (pending review)"
    maintainers = {
        (x.get("addr") or "").lower()
        for x in (spec.get("maintainers") or [])
        if isinstance(x, dict) and x.get("addr")
    }
    if signer.lower() not in maintainers:
        return {"collection": candidate, "signer": signer, "follow": False,
                "reason": "signer is not a listed maintainer"},                "supersedes available (pending review)"
    return {"collection": candidate, "signer": signer, "follow": True},            "supersedes available"


def subscription_status(row):
    _decision, status = supersede_decision(row)
    if status != "current":
        return status
    # Preserve the legacy ready state for a manifest-only placeholder whose
    # collection metadata cannot yet be inspected; complete collections can make
    # the stronger, staleness-aware current claim.
    cm = load_manifest(row.get("collection", ""), missing_ok=True)
    digest = ((cm or {}).get("content") or {}).get("sha256", "")
    if not os.path.exists(blob_read_path(digest)) and not os.path.exists(
            os.path.join(ROOT, ".git")):
        return "ready"
    _spec, error = collection_subscription_spec(
        row.get("collection", ""), row.get("remote", "origin"))
    return "ready" if error else "current"


def apply_subscription_supersedes(row):
    """Follow an authorized linear chain, or persist the first reviewable hop."""
    hops = []
    seen = set()
    while row.get("collection") not in seen:
        seen.add(row.get("collection"))
        decision, status = supersede_decision(row)
        if not decision:
            row.pop("pending_supersedes", None)
            return status, hops
        if not decision.get("follow"):
            pending = []
            candidates = decision.get("candidates") or [
                (decision["collection"], decision.get("signer"))]
            for candidate, signer in candidates:
                pending.append({
                    "collection": candidate,
                    "superseded_from": row.get("collection"),
                    "supersede_signer": signer,
                    "reason": decision.get("reason"),
                })
            row["pending_supersedes"] = pending
            return status, hops
        old = row["collection"]
        hop = {
            "collection": decision["collection"],
            "superseded_from": old,
            "supersede_signer": decision["signer"],
        }
        row["collection"] = decision["collection"]
        row["superseded_from"] = old
        row["supersede_signer"] = decision["signer"]
        row.setdefault("supersede_history", []).append(hop)
        row.pop("pending_supersedes", None)
        hops.append(hop)
    return "supersedes available (pending review)", hops


def validate_subscription_collection(aid):
    if not re.fullmatch(r"cl-[0-9a-f]{8}", aid or ""):
        sys.exit("error: malformed collection id %r (expected cl- followed by 8 lowercase hex digits)"
                 % aid)


def validate_remote_name(remote):
    # A remote here is a git remote *name*, not a URL. Stage 2 may discover remotes;
    # Stage 1 records syntactically valid intent even before that remote is configured.
    if (not remote or not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._/-]*", remote)
            or ".." in remote or "//" in remote or "@{" in remote
            or remote.endswith(("/", ".", ".lock"))):
        sys.exit("error: malformed remote name %r" % remote)


def cmd_subscribe(a):
    validate_subscription_collection(a.collection)
    remote = a.remote
    if remote is None:
        remote = _resolve_subscribe_remote(a.collection)
    validate_remote_name(remote)
    data = load_subscriptions()
    current = next((r for r in data["subscriptions"]
                    if r.get("collection") == a.collection), None)
    row = {
        "collection": a.collection,
        "remote": remote,
        "blobs": a.blobs,
        "executables": bool(a.executables),
        "include_self_declared": bool(a.include_self_declared),
        "follow_supersedes": a.follow_supersedes,
        "added": current.get("added", now()) if current else now(),
    }
    if current is None:
        data["subscriptions"].append(row)
        action = "subscribed"
    else:
        current.clear()
        current.update(row)
        action = "updated subscription"
    save_subscriptions(data)
    print("%s %s via %s — %s" %
          (action, a.collection, remote, subscription_status(row)))


def cmd_unsubscribe(a):
    validate_subscription_collection(a.collection)
    data = load_subscriptions()
    kept = [r for r in data["subscriptions"]
            if r.get("collection") != a.collection]
    if len(kept) == len(data["subscriptions"]):
        sys.exit("error: %s is not subscribed" % a.collection)
    data["subscriptions"] = kept
    save_subscriptions(data)
    print("unsubscribed %s" % a.collection)


def cmd_subscriptions(a):
    rows = load_subscriptions()["subscriptions"]
    if not rows:
        print("no subscriptions")
        return
    print("%-11s %-16s %-14s %-11s %-13s %-19s %s" %
          ("collection", "remote", "blobs", "executables", "self-declared",
           "follow_supersedes", "status"))
    for row in sorted(rows, key=lambda r: r.get("collection", "")):
        print("%-11s %-16s %-14s %-11s %-13s %-19s %s" %
              (row.get("collection", "?"), row.get("remote", "?"),
               row.get("blobs", "manifests-only"),
               str(bool(row.get("executables", False))).lower(),
               str(bool(row.get("include_self_declared", False))).lower(),
               row.get("follow_supersedes", "maintainer-signed"),
               subscription_status(row)))


# Local-only state: never replicated, because it is this host's *policy and view*,
# not shared content. Shipping peers.json would export our trust decisions (and
# silently overwrite a peer's own); quarantine.log is a local incident record.
LOCAL_ONLY = [
    "registry/peers.json",
    "registry/quarantine.log",
    "registry/index.sqlite",
    # Execution policy is trust policy: it names the images allowed to run code here
    # and the caps they run under. Replicating it would let a peer add its own image
    # to your allowlist, make it your default, and lift your memory/cpu/pids limits —
    # verified reproducible before this was added (2026-08-02).
    "registry/exec-policy.json",
    # Subscription state is this host's fetch intent. A peer must neither learn it
    # from us nor choose it for us (same local-only class as execution policy).
    "registry/subscriptions.json",
]


def ensure_local_only_ignored():
    """Keep local-only paths out of git, so pull can never clobber local policy.

    Commits the change itself: leaving .gitignore dirty would make the very next
    merge refuse ("local changes would be overwritten"), turning a safety measure
    into a self-inflicted outage.
    """
    gi = os.path.join(ROOT, ".gitignore")
    existing = ""
    if os.path.exists(gi):
        with open(gi) as f: existing = f.read()
    missing = [p for p in LOCAL_ONLY if p not in existing]
    untrack = [p for p in LOCAL_ONLY
               if git("ls-files", "--error-unmatch", p, check=False).returncode == 0]
    if not missing and not untrack: return
    if missing:
        with open(gi, "a") as f:
            if existing and not existing.endswith("\n"): f.write("\n")
            f.write("# local-only: this host's trust policy and view, never replicated\n")
            for p in missing: f.write(p + "\n")
    for p in untrack:
        git("rm", "-q", "--cached", p, check=False)
    git("add", ".gitignore", check=False)
    if git("diff", "--cached", "--quiet", check=False).returncode != 0:
        git("commit", "-q", "-m",
            "commons: keep local-only state (trust policy, view) out of replication",
            check=False)


def cmd_push(a):
    """Sanity gate, then git push. Refuses to export a registry that fails its own checks."""
    if not os.path.isdir(os.path.join(ROOT, ".git")):
        sys.exit("error: %s is not a git repository" % ROOT)
    ensure_local_only_ignored()

    print("gate: fsck")
    bad = 0
    for fn in sorted(os.listdir(ART)):
        if not fn.endswith(".json"): continue
        with open(os.path.join(ART, fn)) as f: m = json.load(f)
        d = m["content"]["sha256"]
        p = blob_read_path(d)
        if not os.path.exists(p):
            print("  MISSING BLOB: %s" % m["id"]); bad += 1
        elif sha256_file(p) != d:
            print("  HASH MISMATCH: %s" % m["id"]); bad += 1
    if bad: sys.exit("error: refusing to push — %d blob problem(s); run fsck" % bad)

    print("gate: local-only state")
    leaked = [p for p in LOCAL_ONLY
              if git("ls-files", "--error-unmatch", p, check=False).returncode == 0]
    if leaked:
        sys.exit("error: refusing to push — local-only state is tracked in git: %s\n"
                 "       peers.json is THIS host's trust policy; replicating it would\n"
                 "       export your trust decisions and overwrite the receiver's.\n"
                 "       Fix: git rm --cached %s && git commit"
                 % (", ".join(leaked), " ".join(leaked)))

    print("gate: dataset licensing")
    # Shared with `fsck --availability` so the preview and the gate cannot disagree.
    _survey = dataset_disclosure_survey()
    unlicensed = _survey["unlicensed"]
    undeclared = _survey["buckets"]["undeclared"]
    sourceless = _survey["sourceless"]
    if unlicensed and not a.allow_unlicensed:
        sys.exit("error: refusing to push — %d dataset(s) lack a license: %s\n"
                 "       Publishing data onward without stated terms is the one\n"
                 "       mistake that cannot be walked back. Re-publish with\n"
                 "       --license, or pass --allow-unlicensed if these are\n"
                 "       genuinely yours to share unconditionally.\n"
                 "       Not sure which licence? See docs/LICENSING-artifacts.md\n"
                 "       (defaults: CC0-1.0 for datasets)."
                 % (len(unlicensed), ", ".join(unlicensed)))

    # Disclosure gate, NOT a content ban. Proprietary and even wholly unobtainable data
    # are welcome; what is refused is shipping data onward while staying silent about
    # whether anyone else could ever check it. A reader who cannot tell "expensive to
    # replicate" from "impossible to replicate" is being told a silent wrong answer.
    print("gate: dataset obtainability disclosure")
    if (undeclared or sourceless) and not a.allow_undisclosed:
        parts = []
        if undeclared:
            parts.append("       %d dataset(s) do not declare --obtainability: %s"
                         % (len(undeclared), ", ".join(undeclared)))
        if sourceless:
            parts.append("       %d licensed-obtainable dataset(s) carry no --source: %s"
                         % (len(sourceless), ", ".join(sourceless)))
        sys.exit("error: refusing to push — undisclosed dataset availability.\n"
                 + "\n".join(parts) + "\n"
                 "       Re-publish with --obtainability open|licensed-obtainable|"
                 "restricted\n"
                 "       (--source names how a peer acquires a licensed one), or pass\n"
                 "       --allow-undisclosed. Proprietary and restricted data are\n"
                 "       welcome here; silence about which one it is is not.")

    if os.environ.get("COMMONS_REQUIRE_SIG") == "1":
        print("gate: signatures (COMMONS_REQUIRE_SIG=1)")
        unsigned = 0
        for path in ledger_files():
            for line in open(path).read().splitlines():
                if not line.strip(): continue
                try: e = json.loads(line)
                except ValueError: continue
                if not e.get("sig"): unsigned += 1
        if unsigned:
            sys.exit("error: refusing to push — %d unsigned ledger entr(ies) and "
                     "COMMONS_REQUIRE_SIG=1" % unsigned)

    remote = a.remote or "origin"
    r = git("remote", "get-url", remote, check=False)
    if r.returncode != 0:
        sys.exit("error: no git remote named %r (add one, or pass a remote)" % remote)
    print("gate: passed — pushing to %s (%s)" % (remote, r.stdout.strip()))
    if a.dry_run:
        print("(dry run — not pushing)")
        return
    branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    out = git("push", remote, branch, check=False)
    sys.stdout.write(out.stdout); sys.stderr.write(out.stderr)
    if out.returncode != 0: sys.exit("error: git push failed")
    print("pushed %s -> %s" % (branch, remote))



# ---- hubs: data-only registry repos (tool/data split, 2026-09-25) ----
HUB_GITIGNORE = """# derived: rebuildable via `commons reindex`
registry/index.sqlite
site/browse/

# local-only: this host's trust policy and view — never replicated
registry/peers.json
registry/quarantine.log
registry/exec-policy.json
registry/subscriptions.json

__pycache__/
*.ots.bak
"""

HUB_README = """# {name}

A **Research Commons hub**: a data-only git repository (manifests in `registry/`,
content-addressed blobs in `store/`). It contains **no code**. The `commons` tool lives in
a separate repository — [{tool_repo}](https://github.com/{tool_repo}) — and you
update it there, never through this hub.

## Read it

```bash
git clone https://github.com/{tool_repo}.git ~/research-commons   # the tool, once
export PATH="$HOME/research-commons/bin:$PATH"
git clone <this hub> && cd <this hub>                             # the data
commons list --type collection        # topics hosted here
commons collection show <cl-id>       # endorsed + claimed members, open work
commons verify <id>                   # re-derive it yourself
```

`commons` finds this hub automatically from any directory inside it (the `.commons-hub`
marker file); `commons hub where` says which data root is in use.

## Contribute

1. Mint a signing key and tell the maintainers your address (`commons peer whoami`).
2. Fork this hub (or push a branch if you have write access), publish from inside your
   clone, commit `registry/` + `store/`, and open a pull request.
3. CI runs `commons hub check`: the PR may only touch `registry/` and `store/`, every
   blob must match its hash, every signature must verify.
4. A maintainer ingests it through the gate — `commons pull <your-remote> --branch
   <branch>` — which additionally checks signer trust. Endorsement = the maintainer
   republishing the collection with your artifact as a member; until then it shows as
   CLAIMED via your `--link part-of:cl-…`.

Full guide: `docs/COLLABORATING.md` in the tool repository.

## Maintainers

| handle | signing address |
|---|---|
| _(add yourself)_ | `0x…` |
"""

HUB_CI = """name: hub-check
# Gate every change to this hub: data-only paths, no deletions, append-only ledgers,
# per-signer log ownership, valid signatures, blob hashes. Signer TRUST is deliberately
# not decided here: that stays with each maintainer's local peers.json at `commons pull`.
#
# pull_request_target (not pull_request) so a PR cannot edit this file to neuter its own
# check: the workflow ALWAYS comes from the base branch. That is safe here because PR
# content is only ever READ as data by the tool (checked out from the tool repo, never
# from the PR); nothing from the PR is executed, and credentials are not persisted.
# The authoritative gate remains `commons pull` on a maintainer's machine.
on:
  pull_request_target:
  push:
    branches: [main]
permissions:
  contents: read
jobs:
  check:
    runs-on: ubuntu-latest
    steps:
      - name: checkout hub (PR head as DATA only)
        uses: actions/checkout@v4
        with:
          path: hub
          fetch-depth: 0
          persist-credentials: false
          ref: ${{{{ github.event.pull_request.head.sha || github.sha }}}}
      - name: checkout tool
        uses: actions/checkout@v4
        with:
          repository: {tool_repo}
          ref: {tool_ref}
          path: tool
          persist-credentials: false
      - uses: actions/setup-node@v4
        with:
          node-version: '20'
      - run: cd tool && npm ci --ignore-scripts --no-audit --no-fund
      - name: commons hub check
        working-directory: hub
        env:
          BASE: ${{{{ github.event.pull_request.base.sha || github.event.before }}}}
        run: |
          if [ -z "$BASE" ] || [ "$BASE" = "0000000000000000000000000000000000000000" ] \\
             || ! git cat-file -e "$BASE^{{commit}}" 2>/dev/null; then
            ../tool/bin/commons hub check
          else
            ../tool/bin/commons hub check --base "$BASE"
          fi
"""


def _default_tool_repo():
    r = subprocess.run(["git", "remote", "get-url", "origin"], cwd=CODE_ROOT,
                       capture_output=True, text=True)
    url = (r.stdout or "").strip()
    m = re.search(r"github\.com[:/]+([^/]+/[^/]+?)(?:\.git)?/?$", url)
    return m.group(1) if m else "OWNER/research-commons"


def cmd_hub(a):
    if a.hub_cmd == "where":
        print(ROOT)
        print({"env": "source: COMMONS_ROOT",
               "hub": "source: %s marker found above the current directory" % HUB_MARKER,
               "code": "source: tool checkout (no hub found; legacy single-repo layout)"}
              [ROOT_SOURCE], file=sys.stderr)
        return
    if a.hub_cmd == "init":
        d = os.path.abspath(a.dir)
        if os.path.exists(d) and os.listdir(d):
            sys.exit("error: %s exists and is not empty" % d)
        name = a.name or os.path.basename(d)
        tool_repo = a.tool_repo or _default_tool_repo()
        for sub_ in ("registry/artifacts", "registry/ledger", "registry/anchors",
                     "store/sha256", ".github/workflows"):
            os.makedirs(os.path.join(d, sub_), exist_ok=True)
        for keep in ("registry/artifacts", "registry/ledger", "registry/anchors",
                     "store/sha256"):
            open(os.path.join(d, keep, ".gitkeep"), "w").close()
        with open(os.path.join(d, HUB_MARKER), "w") as f:
            json.dump({"schema": SCHEMA, "kind": "commons-hub", "name": name,
                       "tool": tool_repo}, f, indent=2, sort_keys=True)
            f.write("\n")
        with open(os.path.join(d, ".gitignore"), "w") as f: f.write(HUB_GITIGNORE)
        with open(os.path.join(d, "README.md"), "w") as f:
            f.write(HUB_README.format(name=name, tool_repo=tool_repo))
        with open(os.path.join(d, ".github", "workflows", "hub-check.yml"), "w") as f:
            f.write(HUB_CI.format(tool_repo=tool_repo, tool_ref=a.tool_ref))
        shutil.copyfile(os.path.join(CODE_ROOT, "registry", "exec-policy.example.json"),
                        os.path.join(d, "registry", "exec-policy.example.json"))
        if not os.path.isdir(os.path.join(d, ".git")):
            subprocess.run(["git", "init", "-q", "-b", "main", d], check=True)
        print("hub created: %s" % d)
        print("next: cd %s && commons peer whoami && commons peer add <your-addr> "
              "--agent-id <you> --trust full" % d)
        print("      publish, then: git add -A && git commit -m 'hub: …' && commons push")
        return
    if a.hub_cmd == "check":
        return hub_check(a)


def _git_blob_at(ref, digest):
    """A store blob's raw BYTES at `ref`, trying both store layouts. None if absent.

    Deliberately not `git()`: that runs with text=True, which decodes stdout as UTF-8 and
    raises UnicodeDecodeError on the first non-text blob. Datasets are routinely Parquet,
    SQLite or tar, so reading them through the text helper turned any binary member of a
    policy-bearing collection into a traceback that took the whole of `hub check` with it —
    a contributor publishing an ordinary binary dataset would have broken the hub's CI.
    """
    if not digest:
        return None
    for rel in ("store/sha256/%s/%s" % (digest[:2], digest), "store/sha256/%s" % digest):
        r = subprocess.run(["git", "show", "%s:%s" % (ref, rel)], cwd=ROOT,
                           capture_output=True, timeout=600)
        if r.returncode == 0:
            return r.stdout
    return None


def _git_json_at(ref, rel):
    r = git("show", "%s:%s" % (ref, rel), check=False)
    if r.returncode != 0:
        return None
    try:
        return json.loads(r.stdout)
    except ValueError:
        return None


def hub_check_ingest_policies(base):
    """Apply part-of collections' forbidden-key policies to artifacts added since `base`.

    The backstop to the contributor's publish-time gate, for the case where they never ran
    it (a peer's tool with the flag stripped, an older build, or a hand-assembled
    manifest). Reads each policy from **base** where the collection already existed, so a
    PR cannot relax a policy and add a violating artifact in one commit.

    Worth being precise about what base-reading buys here, because collections are
    content-addressed: an id pins its own spec, so the policy for `cl-abcd1234` cannot be
    edited without becoming a different collection. Base-reading therefore defends against
    store tampering rather than against an in-PR policy edit. What neither defends against
    is a contributor claiming `part-of` a brand-new collection with a laxer policy — that
    is a self-declared claim, and it only means anything once a maintainer endorses it.
    """
    problems = []
    added = git("diff", "--name-only", "--no-renames", "--diff-filter=A",
                "%s...HEAD" % base, "--", "registry/artifacts/").stdout.split()
    if not added:
        return problems
    print("check: ingest policies of part-of collections (read from %s)" % base[:12])
    for rel in added:
        m = _git_json_at("HEAD", rel)
        if not isinstance(m, dict):
            continue
        targets = [l.get("id") for l in (m.get("links") or [])
                   if isinstance(l, dict) and l.get("rel") == PART_OF_REL and l.get("id")]
        if not targets:
            continue
        digest = (m.get("content") or {}).get("sha256") or ""
        body = _git_blob_at("HEAD", digest)
        for cid in targets:
            crel = "registry/artifacts/%s.json" % cid
            cm = _git_json_at(base, crel) or _git_json_at("HEAD", crel)
            if not isinstance(cm, dict) or cm.get("type") != "collection":
                continue
            src = base if _git_json_at(base, crel) else "HEAD"
            spec = None
            raw = _git_blob_at(src, (cm.get("content") or {}).get("sha256") or "")
            if raw is not None:
                try:
                    spec = json.loads(raw)
                except ValueError:
                    spec = None
            if spec is None:
                if cm.get(INGEST_POLICY_FLAG):
                    problems.append("%s claims part-of %s, whose ingest policy is not in "
                                    "this hub (cannot check)" % (m.get("id"), cid))
                continue
            keys = ((spec.get("ingest") or {}).get("forbidden_keys") or []) \
                if isinstance(spec.get("ingest"), dict) else []
            if not keys:
                continue
            if body is None:
                problems.append("%s claims part-of %s (ingest policy) but its blob is not "
                                "in this hub (cannot check)" % (m.get("id"), cid))
                continue
            findings = _forbidden_key_findings_on_bytes(
                body, (m.get("content") or {}).get("filename") or m.get("id"), keys)
            for sev, label, lineno, _excerpt in findings:
                if sev == "block":
                    problems.append("%s violates the ingest policy of %s: %s (line %s)"
                                    % (m.get("id"), cid, label, lineno or "?"))
                else:
                    print("  note: %s vs %s: %s" % (m.get("id"), cid, label))
    return problems


def _forbidden_key_findings_on_bytes(raw, filename, keys):
    """Scan in-memory BYTES, so `hub check` never needs the blob on disk.

    Bytes rather than str all the way through: the scanner's own binary detection (a NUL in
    the first 8 KiB) is what classifies a Parquet or SQLite dataset as not-covered, and
    decoding here would destroy the evidence it looks for. The filename is kept so the
    archive-suffix check still sees `.tar` / `.zip`.
    """
    tmp = tempfile.mkdtemp(prefix="commons-ingest-check-")
    try:
        path = os.path.join(tmp, os.path.basename(filename) or "blob")
        with open(path, "wb") as f:
            f.write(raw)
        return forbidden_key_findings(path, keys)
    finally:
        shutil.rmtree(tmp, ignore_errors=True)


def hub_check(a):
    """CI/lead gate for a hub. Exit 1 on any problem; prints every problem found."""
    problems = []
    if not os.path.isfile(os.path.join(ROOT, HUB_MARKER)):
        print("note: %s has no %s marker (legacy layout) — path check still applies"
              % (ROOT, HUB_MARKER), file=sys.stderr)
    changed_ledgers = None
    if a.base:
        if git("rev-parse", "--verify", a.base + "^{commit}", check=False).returncode != 0:
            sys.exit("error: base %r is not a commit here (fetch-depth too shallow?)" % a.base)
        outside = incoming_non_data_paths("HEAD", base=a.base)
        # Direction: we are checking HEAD's changes relative to base.
        print("check: paths changed since %s" % a.base[:12])
        allowed_top = set(DATA_PATH_FILES)
        for p in outside:
            problems.append("non-data path changed: %s" % p)
        diff = git("diff", "--name-only", "--no-renames", "%s...HEAD" % a.base).stdout.split()
        top_changed = [p for p in diff if p in allowed_top]
        if top_changed:
            print("  note: hub metadata changed (maintainer review): %s" % ", ".join(top_changed))
        changed_ledgers = [p for p in diff if p.startswith("registry/ledger/")
                           and p.endswith(".jsonl")]
        deleted = git("diff", "--name-only", "--no-renames", "--diff-filter=D",
                      "%s...HEAD" % a.base).stdout.split()
        for p in deleted:
            if p.startswith(("registry/artifacts/", "registry/ledger/", "store/")):
                problems.append("registry content deleted: %s (append-only)" % p)
        # Ledgers are append-only: the base version must be a prefix of HEAD's.
        for p in changed_ledgers:
            old = git("show", "%s:%s" % (a.base, p), check=False)
            if old.returncode == 0:
                with open(os.path.join(ROOT, p)) as f: new = f.read()
                if not new.startswith(old.stdout):
                    problems.append("ledger rewritten, not appended: %s" % p)

    print("check: blobs")
    for fn in sorted(os.listdir(ART)) if os.path.isdir(ART) else []:
        if not fn.endswith(".json"): continue
        try:
            with open(os.path.join(ART, fn)) as f: m = json.load(f)
        except ValueError:
            problems.append("unparseable manifest %s" % fn); continue
        d = (m.get("content") or {}).get("sha256", "")
        prefix = TYPES.get(m.get("type"), "")
        if fn[:-5] != m.get("id") or (prefix and m.get("id") != "%s-%s" % (prefix, d[:8])):
            problems.append("%s: id does not derive from its content hash / filename" % fn)
        p = blob_read_path(d)
        if os.path.exists(p) and sha256_file(p) != d:
            problems.append("%s: blob does not match its hash" % m.get("id"))

    print("check: ingest policy flag matches the spec")
    # The manifest flag is a hint a peer could strip (it is outside SIGNED_FIELDS), and
    # stripping it would make a contributor's publish-time gate fail open for that peer.
    # A hub holds both the manifest and the blob, so this is the one place the two can be
    # compared — which closes the stripping route for anything arriving through a hub.
    for fn in sorted(os.listdir(ART)) if os.path.isdir(ART) else []:
        if not fn.endswith(".json"):
            continue
        try:
            with open(os.path.join(ART, fn)) as f: m = json.load(f)
        except ValueError:
            continue                      # already reported by the blob check
        if m.get("type") != "collection":
            continue
        blob = blob_read_path((m.get("content") or {}).get("sha256") or "")
        if not os.path.exists(blob):
            continue                      # lazy replication: nothing to compare against
        try:
            with open(blob) as f: spec = json.load(f)
        except (OSError, ValueError):
            problems.append("%s: collection spec is not readable as JSON" % m.get("id"))
            continue
        declared, flagged = spec_has_ingest_policy(spec), bool(m.get(INGEST_POLICY_FLAG))
        if declared and not flagged:
            # The dangerous direction: peers holding only the manifest would see no
            # policy and publish into the collection without applying it.
            problems.append("%s: spec declares an ingest policy but the manifest has no %s "
                            "(peers would not know to fetch it)" % (m.get("id"),
                                                                   INGEST_POLICY_FLAG))
        elif flagged and not declared:
            # Benign — the spec is authoritative and enforces nothing — but it makes peers
            # fetch a blob for no reason, so say it without failing the gate.
            print("  note: %s has %s but its spec declares no policy (nothing enforced)"
                  % (m.get("id"), INGEST_POLICY_FLAG))
    if a.base:
        problems += hub_check_ingest_policies(a.base)

    print("check: local-only state not tracked")
    for p in LOCAL_ONLY:
        if git("ls-files", "--error-unmatch", p, check=False).returncode == 0:
            problems.append("local-only file tracked: %s" % p)

    print("check: ledger signatures + ownership")
    entries = []
    for path in ledger_files():
        for line in open(path).read().splitlines():
            if line.strip():
                try: entries.append((path, json.loads(line)))
                except ValueError: problems.append("%s: unparseable line" % os.path.basename(path))
    prime_verify_cache([e for _, e in entries])
    scope = None if changed_ledgers is None else {os.path.join(ROOT, p) for p in changed_ledgers}
    for path, e in entries:
        if scope is not None and path not in scope: continue
        name = os.path.basename(path)
        if name in ("local-unsigned.jsonl", "ledger.jsonl"):
            if scope is not None:
                problems.append("unsigned entries added (%s): sign before contributing" % name)
            continue
        sig, addr = e.get("sig"), e.get("addr") or ""
        if not sig:
            problems.append("%s: unsigned entry %s" % (name, e.get("id"))); continue
        if name[:-6].lower() != addr.lower():
            problems.append("%s: entry signed by %s written into someone else's log"
                            % (name, addr)); continue
        ok, rec = verify_entry(e, sig, addr)
        if not ok:
            problems.append("%s: BAD SIGNATURE on %s %s" % (name, e.get("action"), e.get("id")))
    problems = sorted(set(problems))
    for p in problems: print("  PROBLEM: %s" % p)
    print("hub check: %s" % ("OK" if not problems else "%d problem(s)" % len(problems)))
    if problems: sys.exit(1)

# Manifest fields that are additive ANNOTATIONS: two peers may each add entries without
# contradicting each other, so a conflict in these is mergeable by union. Everything
# else (notably content.sha256, verification, provenance) is a claim about the artifact
# itself, where a genuine disagreement must still abort the merge.
ANNOTATION_FIELDS = ("links", "tags")


def merge_manifest_annotations(rel_path, ref):
    """Resolve a conflicted manifest by unioning additive annotations. True if resolved.

    Refuses (returns False) unless BOTH sides agree on everything that matters: same id,
    type, and content hash. If the two sides disagree about the content a manifest
    describes, that is a real conflict and must not be silently papered over.
    """
    if not rel_path.startswith("registry/artifacts/") or not rel_path.endswith(".json"):
        return False
    ours = git("show", ":2:" + rel_path, check=False)
    theirs = git("show", ":3:" + rel_path, check=False)
    if ours.returncode != 0 or theirs.returncode != 0:
        return False
    try:
        o = json.loads(ours.stdout)
        t = json.loads(theirs.stdout)
    except ValueError:
        return False
    if not isinstance(o, dict) or not isinstance(t, dict):
        return False
    for field in ("id", "type"):
        if o.get(field) != t.get(field): return False
    if (o.get("content") or {}).get("sha256") != (t.get("content") or {}).get("sha256"):
        return False
    # Everything outside the annotation fields must already agree.
    o_rest = {k: v for k, v in o.items() if k not in ANNOTATION_FIELDS}
    t_rest = {k: v for k, v in t.items() if k not in ANNOTATION_FIELDS}
    # `ingest` is a local arrival stamp; each host's own value is authoritative for it.
    o_rest.pop("ingest", None); t_rest.pop("ingest", None)
    if canonical(o_rest) != canonical(t_rest):
        return False

    merged = dict(o)
    for field in ANNOTATION_FIELDS:
        ov, tv = o.get(field), t.get(field)
        if ov is None and tv is None: continue
        ov = ov or []; tv = tv or []
        if not isinstance(ov, list) or not isinstance(tv, list): return False
        out, seen = [], set()
        for item in list(ov) + list(tv):
            k = canonical(item) if isinstance(item, (dict, list)) else repr(item)
            if k in seen: continue
            seen.add(k); out.append(item)
        merged[field] = out
    write_manifest(merged["id"], merged)
    return True


# Paths a data pull (or a hub PR) may change: the registry, the blob store, and a
# few inert top-level files. Everything else — code, scripts, CI workflows, git
# attributes — is refused unless explicitly allowed. `.github/` is deliberately NOT
# here: a merged workflow runs on the hub's CI with the hub's secrets.
DATA_PATH_PREFIXES = ("registry/", "store/")
DATA_PATH_FILES = (".gitignore", HUB_MARKER, "README.md", "CONTRIBUTING.md", "LICENSE")


def is_data_path(p):
    return p.startswith(DATA_PATH_PREFIXES) or p in DATA_PATH_FILES


def incoming_non_data_paths(ref, base="HEAD"):
    """Paths outside the data allowlist that merging `ref` into `base` would change."""
    if git("merge-base", base, ref, check=False).returncode == 0:
        out = git("diff", "--name-only", "--no-renames", "%s...%s" % (base, ref)).stdout
    else:
        # Unrelated histories (independently bootstrapped peer): a merge only ADDS or
        # MODIFIES here; our files missing from their tree are not deletions.
        out = git("diff", "--name-only", "--no-renames", "--diff-filter=AMTC",
                  base, ref).stdout
    return sorted(p for p in (l.strip() for l in out.splitlines()) if p and not is_data_path(p))


def cmd_pull(a):
    """Ingest gate. Fetch, validate every incoming artifact, THEN merge.

    Not a bare `git pull`: incoming manifests are untrusted until each one passes
    schema/hash/id/signature/trust checks. Rejects are quarantined and the fetch is
    left unmerged, so a bad artifact can never land in the registry.
    """
    if not os.path.isdir(os.path.join(ROOT, ".git")):
        sys.exit("error: %s is not a git repository" % ROOT)
    ensure_local_only_ignored()
    remote = a.remote or "origin"
    r = git("remote", "get-url", remote, check=False)
    if r.returncode != 0:
        sys.exit("error: no git remote named %r" % remote)

    print("fetching %s…" % remote)
    git("fetch", remote)
    branch = getattr(a, "branch", None) or git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    ref = "%s/%s" % (remote, branch)
    if git("rev-parse", "--verify", ref, check=False).returncode != 0:
        sys.exit("error: %s does not exist on the remote" % ref)

    # Inspect the incoming tree without touching the working registry.
    wt = tempfile.mkdtemp(prefix="commons-ingest-")
    worktree = os.path.join(wt, "tree")
    git("worktree", "add", "--detach", worktree, ref)
    try:
        inc_art = os.path.join(worktree, "registry", "artifacts")
        inc_store = os.path.join(worktree, "store", "sha256")
        if not os.path.isdir(inc_art):
            sys.exit("error: incoming tree has no registry/artifacts — not a commons repo")

        # A peer must not be able to hand us a trust policy, ever — that would let the
        # sender decide whom we trust, including themselves.
        smuggled = [p for p in LOCAL_ONLY
                    if p != "registry/index.sqlite"
                    and os.path.exists(os.path.join(worktree, p))]
        if smuggled:
            for p in smuggled:
                quarantine("smuggled-local-state", {"path": p, "remote": remote})
            if "registry/exec-policy.json" in smuggled:
                # Migration aid: this path only became local-only on 2026-08-02, so a
                # peer on older code tracks it innocently. Say so, or the refusal reads
                # as an accusation and the operator reaches for --force.
                print("note: registry/exec-policy.json became local-only on 2026-08-02 "
                      "(it decides what may\n"
                      "      execute here). A peer still tracking it is probably running "
                      "older code, not\n"
                      "      attacking you — have them upgrade and run `commons push` "
                      "once, which\n"
                      "      untracks it automatically.", file=sys.stderr)
            if "registry/subscriptions.json" in smuggled:
                # Migration aid, matching the execution-policy precedent.
                print("note: registry/subscriptions.json became local-only on 2026-08-03 "
                      "(it records this host's fetch intent). A peer still tracking it is "
                      "probably running older code, not attacking you — have them upgrade "
                      "and run `commons push` once, which untracks it automatically.",
                      file=sys.stderr)
            sys.exit("error: refusing to merge — the incoming tree carries local-only "
                     "state: %s\n"
                     "       A peer cannot be allowed to supply trust policy; that "
                     "would let the\n       sender decide whom you trust. Nothing was "
                     "ingested." % ", ".join(smuggled))

        # Code never rides in on a data pull (2026-09-25). The artifact gate below
        # only inspects registry/ + store/; `git merge` would otherwise bring in every
        # other path the peer touched — including bin/commons, which this very host
        # runs on its next command. Reproduced before this guard existed: a peer's
        # edited CLI merged cleanly alongside a valid dataset and executed on the
        # puller's next `commons list`.
        outside = incoming_non_data_paths(ref)
        if outside and not getattr(a, "allow_code", False):
            quarantine("non-data-paths", {"paths": outside[:50], "remote": remote,
                                          "ref": ref})
            sys.exit("error: refusing to merge — the incoming changes touch %d path(s) "
                     "outside registry/ and store/:\n%s\n"
                     "       A data pull must not change code or CI on this host. Update "
                     "the tool\n       separately (git pull in the tool checkout, after "
                     "review), or pass\n       --allow-code if you have reviewed these "
                     "changes. Nothing was ingested."
                     % (len(outside), "\n".join("         " + p for p in outside[:20])
                        + ("\n         …" if len(outside) > 20 else "")))
        if outside:
            print("warning: --allow-code: merging %d non-data path(s): %s"
                  % (len(outside), ", ".join(outside[:10])), file=sys.stderr)

        peers = load_peers()
        require_sig = os.environ.get("COMMONS_REQUIRE_SIG") == "1"
        publisher_addrs = incoming_publishers(
            os.path.join(worktree, "registry", "ledger"))
        accepted, rejected, unchanged = [], [], 0
        for fn in sorted(os.listdir(inc_art)):
            if not fn.endswith(".json"): continue
            try:
                with open(os.path.join(inc_art, fn)) as f: m = json.load(f)
            except ValueError:
                rejected.append((fn, ["unparseable manifest"])); continue
            aid = m.get("id") or fn[:-5]
            local = load_manifest(aid, missing_ok=True)
            if local is not None and local["content"]["sha256"] == (
                    m.get("content") or {}).get("sha256"):
                # Same manifest we already hold — but the incoming BLOB still has to be
                # sound, or a merge silently overwrites our good bytes with bad ones.
                # (Found by the tamper test: skipping this let a poisoned blob land
                # under an unchanged manifest.)
                d = local["content"]["sha256"]
                inc = blob_read_path_at(inc_store, d)
                if os.path.exists(inc) and sha256_file(inc) != d:
                    rejected.append((aid, ["incoming blob for an already-held artifact "
                                           "does not match its hash"]))
                else:
                    unchanged += 1
                continue
            reasons = validate_incoming(m, inc_store, peers, require_sig, trust_allows,
                                        publisher_addrs)
            (accepted if not reasons else rejected).append(
                (aid, reasons) if reasons else (aid, m))

        print("incoming: %d new/changed, %d already present, %d rejected"
              % (len(accepted), unchanged, len(rejected)))
        for aid, reasons in rejected:
            print("  REJECT %s" % aid)
            for why in reasons: print("    - %s" % why)
            quarantine("ingest-rejected", {"artifact": aid, "reasons": reasons,
                                           "remote": remote})
        if rejected and not a.force:
            sys.exit("error: refusing to merge — %d artifact(s) failed the ingest gate.\n"
                     "       Details appended to registry/quarantine.log; the fetch is\n"
                     "       left unmerged so the registry stays clean." % len(rejected))

        # "No new artifacts" is NOT the same as "nothing new". Lifecycle events (claim,
        # submit, accept, anchor) are ledger lines, not manifests, so a submission that
        # cites an EXISTING artifact adds zero new manifests while carrying the whole
        # point of the exchange. Returning early here stranded every such event at the
        # sender — the beneficiary never saw the submission it was supposed to settle.
        # Ask git whether the incoming ref actually has commits we lack.
        behind = git("rev-list", "--count", "HEAD.." + ref, check=False).stdout.strip()
        try:
            behind_n = int(behind or "0")
        except ValueError:
            behind_n = 1  # unparseable: assume there IS something, and let merge decide
        if not accepted and not rejected and behind_n == 0:
            print("nothing new to merge")
            return
        if not accepted and not rejected and behind_n:
            print("no new artifacts, but %d incoming commit(s) — merging for ledger "
                  "events (claims/submissions/settlements/anchors)" % behind_n)
        if a.dry_run:
            print("(dry run — validated only, not merging)")
            for aid, m in accepted: print("  would accept %s (%s)" % (aid, m["type"]))
            return

        # Only now touch the real registry.
        merge = git("merge", "--no-edit", ref, check=False)
        if merge.returncode != 0 and "unrelated histories" in (merge.stderr + merge.stdout):
            # A peer bootstrapped with `git init` rather than `git clone` has no common
            # ancestor. Every incoming artifact already passed the ingest gate above, so
            # the histories being unrelated is a bootstrap detail, not a trust question.
            print("note: unrelated histories (peer bootstrapped independently) — "
                  "joining them; artifacts were already validated")
            merge = git("merge", "--no-edit", "--allow-unrelated-histories", ref,
                        check=False)
        if merge.returncode != 0:
            # Distinguish a *content* conflict in the registry (serious) from a conflict
            # in incidental repo scaffolding like .gitignore, which two independently
            # bootstrapped peers will always disagree about and which carries no
            # artifact data. Registry conflicts abort; scaffolding we settle locally.
            conflicted = [l.strip() for l in git(
                "diff", "--name-only", "--diff-filter=U", check=False).stdout.splitlines()
                if l.strip()]
            registry_conflicts = [p for p in conflicted
                                  if p.startswith(("registry/", "store/"))]
            # Annotation-only manifest conflicts are MERGEABLE, and must be, or the
            # commons wedges permanently on ordinary honest behaviour.
            #
            # `submit` appends {"rel":"fulfills"} to the result manifest. When two peers
            # cite the SAME artifact for DIFFERENT tasks (exactly what content-addressed
            # dedup encourages), both append to the same file and git reports a content
            # conflict. Aborting is wrong: neither side is disputing anything. The
            # content hash — the only load-bearing part — is identical on both sides;
            # the links list is an additive annotation, so the union is the correct
            # resolution and cannot lose information.
            if registry_conflicts:
                resolved = []
                for p in list(registry_conflicts):
                    if merge_manifest_annotations(p, ref):
                        git("add", "--", p, check=False)
                        resolved.append(p)
                if resolved:
                    print("note: merged additive annotations on %d manifest(s): %s"
                          % (len(resolved), ", ".join(os.path.basename(p) for p in resolved)))
                    print("      (two peers citing one artifact for different tasks is")
                    print("      normal under content-addressed dedup, not a dispute)")
                    registry_conflicts = [p for p in registry_conflicts if p not in resolved]
                    conflicted = [p for p in conflicted if p not in resolved]
            if conflicted and not registry_conflicts:
                for p in conflicted:
                    git("checkout", "--ours", "--", p, check=False)
                    git("add", "--", p, check=False)
                print("note: kept local copies of non-registry files: %s"
                      % ", ".join(conflicted))
            if not registry_conflicts:
                # Either nothing registry-level conflicted, or every registry conflict
                # was an additive annotation we just unioned. Finish the merge.
                still = [l.strip() for l in git(
                    "diff", "--name-only", "--diff-filter=U",
                    check=False).stdout.splitlines() if l.strip()]
                if not still:
                    merge = git("commit", "-q", "--no-edit", check=False)
            if merge.returncode != 0:
                sys.stdout.write(merge.stdout); sys.stderr.write(merge.stderr)
                if registry_conflicts:
                    print("conflicting registry paths: %s" % ", ".join(registry_conflicts),
                          file=sys.stderr)
                git("merge", "--abort", check=False)
                sys.exit("error: git merge failed (nothing was ingested; "
                         "the fetch is left unmerged)")
        else:
            sys.stdout.write(merge.stdout); sys.stderr.write(merge.stderr)

        # Stamp arrival time: bounds self-declared-time games without pretending to
        # establish real ordering.
        stamped = 0
        for aid, m in accepted:
            p = manifest_path(aid)
            if not os.path.exists(p): continue
            with open(p) as f: cur = json.load(f)
            cur.setdefault("ingest", {})["received_at"] = now()
            cur["ingest"]["from"] = remote
            write_manifest(aid, cur)
            stamped += 1
        cmd_reindex(a)
        print("ingested %d artifact(s) from %s (received_at stamped on %d)"
              % (len(accepted), remote, stamped))
        missing = [aid for aid, _ in accepted
                   if not os.path.exists(blob_read_path(
                       load_manifest(aid)["content"]["sha256"]))]
        if missing:
            print("note: %d artifact(s) arrived as manifest-only (lazy replication):"
                  % len(missing))
            for aid in missing[:10]: print("  %s — fetch with: commons fetch %s" % (aid, aid))
    finally:
        git("worktree", "remove", "--force", worktree, check=False)
        shutil.rmtree(wt, ignore_errors=True)


def remote_blob_text(m, remote):
    """Read one artifact blob from a fetched remote ref without materializing it."""
    digest = m["content"]["sha256"]
    branch = git("rev-parse", "--abbrev-ref", "HEAD").stdout.strip()
    ref = "%s/%s" % (remote, branch)
    rels = ("store/sha256/%s/%s" % (digest[:2], digest),
            "store/sha256/" + digest)
    for rel in rels:
        r = git("show", "%s:%s" % (ref, rel), check=False, capture=True)
        if r.returncode == 0:
            return r.stdout
    return None


def subscription_member_ids(row):
    """Return (ids, status) for a members policy after its full pull has passed."""
    cid, remote = row.get("collection"), row.get("remote")
    spec, error = collection_subscription_spec(cid, remote)
    if error:
        return [], error
    ids = [x["id"] for x in (spec.get("members") or [])
           if isinstance(x, dict) and x.get("id")]
    if row.get("include_self_declared"):
        ids.extend(m["id"] for m in self_declared_members(cid))
    return list(dict.fromkeys(ids)), "ready"


def subscription_collection_spec(row):
    """Return (collection spec, status), reading metadata without materializing it.

    Thin wrapper over j14's collection_subscription_spec (rc-j15 wrote a parallel
    version before j14's refactor was visible in its stage; the helper already
    returns the exact (spec, status) pair the fsck view needs).
    """
    return collection_subscription_spec(row.get("collection"), row.get("remote"))


def publisher_is_full(aid):
    """Executable materialization needs a verified signed publisher at trust: full."""
    fp = first_publisher(aid)
    if not fp:
        return False
    return (find_peer(fp[0], load_peers()) or {}).get("trust") == "full"


def cmd_sync(a):
    """Run the ordinary pull gate, then apply local subscription blob policy."""
    data = load_subscriptions()
    rows = data["subscriptions"]
    if a.subscription:
        validate_subscription_collection(a.subscription)
        rows = [r for r in rows if r.get("collection") == a.subscription]
        if not rows:
            sys.exit("error: no subscription for %s" % a.subscription)
    if not rows:
        print("no subscriptions")
        return

    failed = False
    for row in sorted(rows, key=lambda r: r.get("collection", "")):
        cid = row.get("collection", "?")
        remote = row.get("remote", "origin")
        policy = row.get("blobs", "manifests-only")
        print("sync %s via %s (blobs=%s)" % (cid, remote, policy))
        if policy not in SUBSCRIPTION_BLOBS:
            failed = True
            print("  pull: REFUSED — invalid subscription blob policy %r" % policy)
            print("  result: fetched=0 skipped=0 already-present=0")
            continue

        # Pull is intentionally invoked as-is and without a subscription filter.
        before = set()
        for m in iter_manifests():
            d = (m.get("content") or {}).get("sha256")
            if d and os.path.exists(blob_read_path(d)):
                before.add(d)
        try:
            cmd_pull(argparse.Namespace(remote=remote, dry_run=False, force=False))
        except SystemExit as e:
            failed = True
            detail = str(e) if e.code not in (None, 0) else "refused"
            print("  pull: REFUSED — %s" % detail)
            print("  result: fetched=0 skipped=0 already-present=0")
            continue
        print("  pull: ok (full ingest gate, unfiltered)")

        supersede_state, hops = apply_subscription_supersedes(row)
        for hop in hops:
            print("  supersedes: followed %s -> %s (signer %s)" %
                  (hop["superseded_from"], hop["collection"],
                   hop["supersede_signer"]))
        if not hops and supersede_state == "supersedes available (pending review)":
            pending = (row.get("pending_supersedes") or [{}])[0]
            print("  supersedes: pending review %s -> %s (signer %s; %s)" %
                  (pending.get("superseded_from", cid),
                   pending.get("collection", "?"),
                   pending.get("supersede_signer") or "unverified",
                   pending.get("reason", "review required")))
        save_subscriptions(data)

        if policy == "manifests-only":
            target_ids, state = [], subscription_status(row)
        elif policy == "members":
            target_ids, state = subscription_member_ids(row)
        else:
            target_ids = [m["id"] for m in iter_manifests()]
            state = "ready"

        # Git pull necessarily checks out tracked blobs. Selectivity is a local
        # post-ingest materialization policy: retain everything that predated sync,
        # but discard newly checked-out bytes before applying the fetch set.
        for m in iter_manifests():
            d = (m.get("content") or {}).get("sha256")
            if not d or d in before:
                continue
            for path in (blob_path(d), os.path.join(STORE, d)):
                if os.path.exists(path):
                    os.chmod(path, 0o644)
                    os.unlink(path)

        fetched = skipped = already = 0
        executable_skips = []
        for aid in target_ids:
            m = load_manifest(aid, missing_ok=True)
            if m is None:
                skipped += 1
                print("  SKIPPED %s — member manifest unavailable" % aid)
                continue
            d = m["content"]["sha256"]
            if m.get("type") in METHOD_TYPES:
                full_publisher = publisher_is_full(aid)
                if not (row.get("executables") and full_publisher):
                    skipped += 1
                    executable_skips.append(aid)
                    reasons = []
                    if not row.get("executables"):
                        reasons.append("executables not enabled")
                    if not full_publisher:
                        reasons.append("publisher trust is not full")
                    print("  SKIPPED executable %s — %s"
                          % (aid, "; ".join(reasons)))
                    continue
            if os.path.exists(blob_read_path(d)):
                already += 1
                print("  ALREADY %s" % aid)
                continue
            try:
                served_by = cmd_fetch(argparse.Namespace(
                    id=aid, remote=None, preferred_remote=remote, quiet=True))
                fetched += 1
                if served_by == remote:
                    print("  FETCHED %s" % aid)
                else:
                    print("  FETCHED %s (via %s)" % (aid, served_by))
            except SystemExit as e:
                skipped += 1
                print("  SKIPPED %s — %s" % (aid, str(e)))
        if state != "ready":
            print("  status: %s" % state)
        elif supersede_state != "current" or hops:
            print("  status: %s" % supersede_state)
        else:
            print("  status: current")
        if executable_skips:
            print("  executable skips: %s" % ", ".join(executable_skips))
        print("  result: fetched=%d skipped=%d already-present=%d"
              % (fetched, skipped, already))
    if failed:
        sys.exit(EX_FAIL)


def _curated_collections_for(aid):
    """Return locally-readable collections that editorially include aid."""
    collections = set()
    for manifest in iter_manifests():
        if manifest.get("type") != "collection":
            continue
        digest = (manifest.get("content") or {}).get("sha256")
        path = blob_read_path(digest) if digest else None
        if not path or not os.path.exists(path):
            continue
        try:
            with open(path) as f:
                spec = json.load(f)
        except (OSError, ValueError):
            continue
        if any(isinstance(member, dict) and member.get("id") == aid
               for member in (spec.get("members") or [])):
            collections.add(manifest.get("id"))
    return collections


def _announce_status(row, peers=None, current=None):
    """Shared registration, revocation, and expiry interpretation for announces."""
    peers = peers if peers is not None else load_peers()
    current = time.time() if current is None else current
    peer = find_peer(row["signer"], peers)
    revoked = bool(peer and (peer.get("revoked_at") or peer.get("active") is False))
    expires_at = row["spec"].get("expires")
    expires_ts = parse_ts(expires_at)
    if expires_ts is None or expires_ts <= current:
        expiry_state = "EXPIRED"
    elif expires_ts - current < 14 * 24 * 60 * 60:
        expiry_state = "expires-soon"
    else:
        expiry_state = "live"
    return peer, revoked, expires_at, expiry_state


def _fetch_candidate_remotes(aid):
    """Configured remotes in peer trust order, with announce hints within a band."""
    configured = _configured_git_remotes()
    all_names = sorted({name for names in configured.values() for name in names})
    peers = load_peers()
    curated = _curated_collections_for(aid)
    ranked = {}
    rows, _missing_ids = _announce_resolution()
    for row in rows:
        peer, revoked, _expires_at, expiry_state = _announce_status(row, peers)
        trust = (peer or {}).get("trust")
        if (peer is None or revoked or expiry_state == "EXPIRED"
                or trust not in ("full", "datasets-only")):
            continue
        band = 0 if trust == "full" else 1
        claimed = any(hosted.get("collection") in curated
                      for hosted in (row["spec"].get("hosts") or [])
                      if isinstance(hosted, dict))
        for announced in row["spec"].get("remotes") or []:
            if not isinstance(announced, dict):
                continue
            for name in configured.get(announced.get("url"), []):
                previous = ranked.get(name)
                if previous is None or band < previous[0]:
                    ranked[name] = (band, claimed)
                elif band == previous[0]:
                    ranked[name] = (band, previous[1] or claimed)
    announced = sorted(ranked, key=lambda name: (
        ranked[name][0], not ranked[name][1], name))
    return announced + [name for name in all_names if name not in ranked]


def _fetch_blob_from_remote(m, remote):
    """Attempt one remote; return (failure class, detail), or (None, None)."""
    fetched = git("fetch", remote, check=False)
    if fetched.returncode != 0:
        detail = " ".join((fetched.stderr or fetched.stdout).split())
        return "absent", "git fetch failed" + ((": " + detail) if detail else "")
    text = remote_blob_text(m, remote)
    if text is None:
        return "absent", "blob path not present"

    digest = m["content"]["sha256"]
    ensure_dirs()
    dst = blob_path(digest)
    os.makedirs(os.path.dirname(dst), exist_ok=True)
    tmp = dst + ".tmp.%d" % os.getpid()
    with open(tmp, "w") as f:
        f.write(text)
    got = sha256_file(tmp)
    if got != digest:
        os.unlink(tmp)
        return "hash-mismatch", "got %s, expected %s" % (got[:12], digest[:12])
    os.replace(tmp, dst)
    os.chmod(dst, 0o444)
    return None, None


def cmd_fetch(a):
    """Materialize a lazy blob, using trust-ordered fallback when remote is omitted."""
    m = load_manifest(a.id)
    digest = m["content"]["sha256"]
    if os.path.exists(blob_read_path(digest)):
        print("%s already local (%s)" % (a.id, digest[:12]))
        return None

    # An explicit CLI remote remains a single attempt with the established hard errors.
    if a.remote:
        remote = a.remote
        if git("remote", "get-url", remote, check=False).returncode != 0:
            sys.exit("error: no git remote named %r" % remote)
        failure, detail = _fetch_blob_from_remote(m, remote)
        if failure == "absent":
            sys.exit("error: %s does not carry the blob for %s either (%s)"
                     % (remote, a.id, digest[:12]))
        if failure == "hash-mismatch":
            sys.exit("error: fetched bytes hash to %s, expected %s — refusing"
                     % (detail.split()[1].rstrip(","), digest[:12]))
        print("fetched %s (%s, %d bytes)" %
              (a.id, digest[:12], os.path.getsize(blob_path(digest))))
        return remote

    candidates = _fetch_candidate_remotes(a.id)
    preferred = getattr(a, "preferred_remote", None)
    if preferred and preferred not in candidates:
        if git("remote", "get-url", preferred, check=False).returncode == 0:
            candidates.insert(0, preferred)
    elif preferred:
        candidates.remove(preferred)
        candidates.insert(0, preferred)
    if not candidates:
        sys.exit("error: no configured git remotes to fetch %s" % a.id)

    failures = []
    for remote in candidates:
        failure, detail = _fetch_blob_from_remote(m, remote)
        if failure is None:
            if not getattr(a, "quiet", False):
                print("fetched %s via %s (%s, %d bytes)" %
                      (a.id, remote, digest[:12], os.path.getsize(blob_path(digest))))
            return remote
        failures.append((remote, failure))
        print("fetch %s via %s: %s (%s)" % (a.id, remote, failure, detail))
    tried = "; ".join("%s: %s" % item for item in failures)
    sys.exit("error: no remote served valid bytes for %s; tried %s" % (a.id, tried))


def cmd_anchor(a):
    """Time-anchor the ledger heads: Merkle root -> OpenTimestamps.

    Anchoring only ever establishes an UPPER bound ("this existed by then"); it
    cannot prove something didn't exist earlier. Without the OTS client we still
    record the root, which remains useful as a local tamper checkpoint — but we say
    plainly that it is unanchored rather than implying proof we don't have.
    """
    heads = {}
    for path in ledger_files():
        h = ledger_head(path)
        if h: heads[os.path.basename(path)] = h
    if not heads:
        sys.exit("error: no ledger entries to anchor")

    leaves = [hashlib.sha256((k + ":" + v).encode()).hexdigest()
              for k, v in sorted(heads.items())]
    layer = list(leaves)
    while len(layer) > 1:
        nxt = []
        for i in range(0, len(layer), 2):
            pair = layer[i] + (layer[i + 1] if i + 1 < len(layer) else layer[i])
            nxt.append(hashlib.sha256(pair.encode()).hexdigest())
        layer = nxt
    root = layer[0]

    os.makedirs(ANCHOR_DIR, exist_ok=True)
    stamp = time.strftime("%Y%m%dT%H%M%SZ", time.gmtime())
    rec = {"schema": SCHEMA, "created": now(), "root": root, "heads": heads,
           "leaves": leaves}
    ots = find_ots()
    rootfile = os.path.join(ANCHOR_DIR, "anchor-%s.root" % stamp)
    with open(rootfile, "w") as f: f.write(root + "\n")
    if ots and not a.local_only:
        r = subprocess.run([ots, "stamp", rootfile], capture_output=True, text=True,
                           timeout=300)
        if r.returncode == 0 and os.path.exists(rootfile + ".ots"):
            rec["ots_proof"] = os.path.basename(rootfile + ".ots")
            rec["anchored"] = "pending"  # OTS proofs upgrade asynchronously
            print("anchored via OpenTimestamps (proof pending Bitcoin confirmation)")
        else:
            rec["anchored"] = "failed"
            rec["error"] = (r.stderr or r.stdout).strip()[:200]
            print("warning: ots stamp failed; recorded an unanchored checkpoint",
                  file=sys.stderr)
    else:
        rec["anchored"] = "none"
        rec["note"] = ("no OpenTimestamps client on this host; this is a LOCAL "
                       "tamper checkpoint only, not third-party-verifiable time")
        print("recorded a local checkpoint — no OTS client, so this is NOT")
        print("third-party-verifiable time. Install `ots` to anchor for real.")
    with open(os.path.join(ANCHOR_DIR, "anchor-%s.json" % stamp), "w") as f:
        json.dump(rec, f, indent=2, sort_keys=True)
    ledger_append({"agent": a.agent, "action": "anchor", "id": "anchor-" + stamp,
                   "sha256": root})
    print("root %s over %d log head(s)" % (root[:16], len(heads)))


def find_ots():
    """Locate the OpenTimestamps client.

    pipx installs land in ~/.local/bin, which a bare crontab PATH does not include —
    a common gotcha, so look there explicitly rather than only trusting PATH.
    """
    found = shutil.which("ots") or shutil.which("opentimestamps-client")
    if found: return found
    for cand in (os.path.expanduser("~/.local/bin/ots"),
                 os.path.expanduser("~/.local/bin/opentimestamps-client")):
        if os.path.isfile(cand) and os.access(cand, os.X_OK): return cand
    return None


def ots_blocks(ots, proof):
    """Bitcoin block heights a proof commits to, via `ots info` (needs no node)."""
    try:
        r = subprocess.run([ots, "info", proof], capture_output=True, text=True,
                           timeout=120)
    except (OSError, subprocess.SubprocessError):
        return []
    return sorted({int(m) for m in re.findall(
        r"BitcoinBlockHeaderAttestation\((\d+)\)", r.stdout + r.stderr)})


def cmd_anchor_upgrade(a):
    """Upgrade pending OTS proofs once Bitcoin has confirmed them.

    OTS proofs are issued immediately but only become independently verifiable after
    the calendar aggregates into a block. Until then `anchored: pending` is the honest
    state — this promotes it to `confirmed` when the upgrade succeeds.
    """
    ots = find_ots()
    if not ots:
        sys.exit("error: no OpenTimestamps client found (pipx install opentimestamps-client)")
    if not os.path.isdir(ANCHOR_DIR):
        print("(no anchors recorded)"); return
    pending = []
    for fn in sorted(os.listdir(ANCHOR_DIR)):
        if not fn.endswith(".json"): continue
        p = os.path.join(ANCHOR_DIR, fn)
        with open(p) as f: rec = json.load(f)
        if rec.get("anchored") == "pending" and rec.get("ots_proof"):
            pending.append((p, rec))
    if not pending:
        print("no pending proofs"); return
    upgraded = 0
    for p, rec in pending:
        proof = os.path.join(ANCHOR_DIR, rec["ots_proof"])
        if not os.path.exists(proof):
            print("%s: proof file missing (%s)" % (os.path.basename(p), rec["ots_proof"]))
            continue
        subprocess.run([ots, "upgrade", proof], capture_output=True, text=True,
                       timeout=300)
        # Read the proof's own contents rather than trusting `ots verify`: verify needs
        # a local Bitcoin node (we run none) AND exits 0 even when it cannot connect, so
        # it reports neither confirmation nor failure usefully. `ots info` needs nothing
        # and states plainly whether a BitcoinBlockHeaderAttestation is present.
        blocks = ots_blocks(ots, proof)
        if blocks:
            rec["anchored"] = "confirmed"
            rec["confirmed_at"] = now()
            rec["bitcoin_blocks"] = blocks
            # Honest naming: the proof commits the root into these blocks. Checking that
            # those blocks are real still requires a node or a block explorer, so this
            # is "anchored", not "independently verified on our side".
            rec["verified_locally"] = False
            with open(p, "w") as f: json.dump(rec, f, indent=2, sort_keys=True)
            upgraded += 1
            print("%s: CONFIRMED in bitcoin block(s) %s"
                  % (os.path.basename(p), ", ".join(str(b) for b in blocks)))
        else:
            print("%s: still pending (calendar has not aggregated it into a block yet)"
                  % os.path.basename(p))
    print("anchor upgrade: %d confirmed, %d still pending"
          % (upgraded, len(pending) - upgraded))


def cmd_anchor_verify(a):
    """Re-derive each recorded root and, when possible, check its OTS proof."""
    if not os.path.isdir(ANCHOR_DIR):
        print("(no anchors recorded)"); return
    ots = find_ots()
    files = sorted(fn for fn in os.listdir(ANCHOR_DIR) if fn.endswith(".json"))
    if not files:
        print("(no anchors recorded)"); return
    bad = 0
    for fn in files:
        with open(os.path.join(ANCHOR_DIR, fn)) as f: rec = json.load(f)
        leaves = [hashlib.sha256((k + ":" + v).encode()).hexdigest()
                  for k, v in sorted((rec.get("heads") or {}).items())]
        layer = list(leaves)
        while len(layer) > 1:
            nxt = []
            for i in range(0, len(layer), 2):
                pair = layer[i] + (layer[i + 1] if i + 1 < len(layer) else layer[i])
                nxt.append(hashlib.sha256(pair.encode()).hexdigest())
            layer = nxt
        recomputed = layer[0] if layer else None
        state = "OK" if recomputed == rec.get("root") else "ROOT MISMATCH"
        if state != "OK": bad += 1
        line = "%s  %s  root=%s  anchored=%s" % (fn, state, str(rec.get("root"))[:16],
                                                rec.get("anchored"))
        if rec.get("ots_proof") and ots:
            proof = os.path.join(ANCHOR_DIR, rec["ots_proof"])
            if os.path.exists(proof):
                blocks = ots_blocks(ots, proof)
                line += "  ots=%s" % ("btc:" + ",".join(str(b) for b in blocks)
                                      if blocks else "pending")
        print(line)
    if bad: sys.exit("anchor verify: %d root mismatch(es)" % bad)
    print("anchor verify: %d anchor(s) consistent" % len(files))


def cmd_reindex(a):
    print("reindexed %d artifacts" % rebuild_index())


# ---------------- static site (v0.4 read-only browser) ----------------
# Renders a plain static HTML tree from the LOCAL registry as it stands right now.
# No write path, no daemon, no new provenance/trust logic: every judgment (tier,
# chain grade, verified-agent mismatch, superseded-by, availability) is produced by
# calling the exact same functions the CLI itself uses, so the site can never claim
# something the CLI would grade differently.

