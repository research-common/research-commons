def _html_escape(s):
    return (str(s if s is not None else "")
            .replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")
            .replace('"', "&quot;"))


def _site_page(title, body, crumbs=""):
    return ("<!DOCTYPE html><html lang=\"en\"><head><meta charset=\"UTF-8\">"
            "<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
            "<title>%s — Research Commons (local)</title>%s</head><body><div class=\"wrap\">"
            "<header class=\"top\"><h1>%s</h1>"
            "<div class=\"sub\">local registry snapshot — read-only, generated, not fetched "
            "live</div></header>%s%s"
            "<footer>generated by <code>commons render-site</code> from this host's local "
            "registry only. Reflects whatever has been pulled/trusted here; another peer's "
            "copy of this site may legitimately differ.</footer></div></body></html>"
            % (_html_escape(title), _SITE_STYLE, _html_escape(title), crumbs, body))


def _site_id_link(aid, rel_prefix="../artifacts/"):
    """Cross-link to an artifact's page, or an explicit MISSING label if it isn't
    locally held — mirrors cmd_graph's own handling of dangling references rather
    than silently dropping them."""
    if load_manifest(aid, missing_ok=True) is None:
        return "<span class=\"id missing\">%s (MISSING)</span>" % _html_escape(aid)
    return "<a class=\"id\" href=\"%s%s.html\">%s</a>" % (rel_prefix, aid, aid)


def _site_tier_badge(m):
    if is_method(m):
        return "<span class=\"badge method\">method</span>"
    t = tier_of(m)
    return "<span class=\"badge %s\">%s</span>" % (t, t)


def _site_availability_badge(m):
    disp = availability_display(m)
    if not disp:
        return ""
    return " <span class=\"note\">[%s]</span>" % _html_escape(disp)


def _site_render_status_table(root):
    """The same evidence-chain rollup `commons status` prints, as an HTML table.

    Calls the identical chain-walk/chain-grade functions cmd_status uses — never a
    reimplementation — so the page can't disagree with what `commons status <id>`
    would print on the command line.
    """
    if root["type"] == "task":
        return "<p class=\"note\">tasks are not evidence-tiered; see the task page.</p>"
    visited, rows, truncated = _chain_walk(root["id"], MAX_CHAIN_DEPTH)
    grade, worst_node, counts = _chain_grade(root, rows)
    restricted, undeclared = _chain_availability(rows)
    out = ["<table><tr><th>depth</th><th>id</th><th>rel</th><th>tier</th>"
           "<th>title</th><th>note</th></tr>"]
    for depth, aid, rel, m, note in rows:
        indent = "&nbsp;&nbsp;" * depth
        if m is None:
            out.append("<tr><td>%d</td><td>%s%s</td><td>%s</td><td colspan=\"2\">"
                       "<span class=\"missing\">MISSING</span></td><td>%s</td></tr>"
                       % (depth, indent, _html_escape(aid), _html_escape(rel),
                          _html_escape(note or "")))
            continue
        badge = _site_tier_badge(m)
        extra = note or ""
        if not is_method(m) and tier_of(m) in ("T0", "T1") and \
                recorded_exec(m).get("mode") == "native":
            extra = (extra + " " if extra else "") + "(pre-sandbox baseline)"
        out.append("<tr><td>%d</td><td>%s%s</td><td>%s</td><td>%s</td>"
                   "<td>%s</td><td class=\"note\">%s</td></tr>"
                   % (depth, indent, _site_id_link(aid), _html_escape(rel), badge,
                      _html_escape(m.get("title", "")), _html_escape(extra)))
    out.append("</table>")
    if truncated:
        out.append("<p class=\"note\">depth cap reached at: %s</p>"
                   % _html_escape(", ".join(truncated)))
    if grade is None:
        out.append("<p><strong>chain grade:</strong> n/a — method artifact, pinned by "
                   "content hash, not tiered.</p>")
    else:
        weakest = "" if worst_node == root["id"] else (
            " (weakest: %s)" % _site_id_link(worst_node))
        out.append("<p><strong>chain grade:</strong> %s%s</p>" % (grade, weakest))
    if restricted:
        out.append("<p class=\"warn\">availability: %d chain input(s) NOT independently "
                   "obtainable: %s — no other party can re-run this chain end to end.</p>"
                   % (len(restricted), ", ".join(_html_escape(x) for x in restricted)))
    if undeclared:
        out.append("<p class=\"note\">availability: %d dataset(s) declare no "
                   "obtainability: %s</p>"
                   % (len(undeclared), ", ".join(_html_escape(x) for x in undeclared)))
    return "\n".join(out)


def _site_artifact_page(m, smap):
    rows = []
    rows.append(("type", _html_escape(m.get("type", "?"))))
    rows.append(("agent (self-asserted)", _html_escape(m.get("agent", "?"))))
    verified_agent = verified_agent_of(m)
    if verified_agent and verified_agent != m.get("agent"):
        rows.append(("verified publisher", "<span class=\"warn\">%s — disagrees with the "
                    "self-asserted agent field above</span>" % _html_escape(verified_agent)))
    elif verified_agent:
        rows.append(("verified publisher", _html_escape(verified_agent)))
    rows.append(("created", _html_escape(m.get("created", ""))))
    rows.append(("tier", _site_tier_badge(m) + _site_availability_badge(m)))
    crit = (m.get("verification") or {}).get("criteria")
    if crit:
        rows.append(("criteria", _html_escape(crit)))
    supers = smap.get(m["id"])
    if supers:
        rows.append(("superseded by", "<span class=\"warn\">%s — this artifact is retired"
                    "</span>" % ", ".join(_site_id_link(x) for x in supers)))

    body = ["<div class=\"id\">%s</div><h2 style=\"border:none;margin-top:6px;\">%s</h2>"
           % (_html_escape(m["id"]), _html_escape(m.get("title", "(untitled)")))]
    if m.get("description"):
        body.append("<p>%s</p>" % _html_escape(m["description"]))
    body.append("<table>")
    for k, v in rows:
        body.append("<tr><th>%s</th><td>%s</td></tr>" % (_html_escape(k), v))
    body.append("</table>")

    prov = m.get("provenance") or {}
    if prov.get("inputs") or prov.get("workflow"):
        body.append("<h2>provenance</h2><ul class=\"plain\">")
        for i in prov.get("inputs", []):
            body.append("<li>input: %s</li>" % _site_id_link(i["id"]))
        if prov.get("workflow"):
            body.append("<li>workflow: %s</li>" % _site_id_link(prov["workflow"]["id"]))
        body.append("</ul>")

    links = m.get("links") or []
    if links:
        body.append("<h2>outbound links</h2><ul class=\"plain\">")
        for l in links:
            rel = l.get("rel", "related")
            evid = " (evidence)" if rel in EVIDENCE_RELS else \
                   (" (not evidence — membership claim)" if rel == PART_OF_REL else "")
            body.append("<li>%s &rarr; %s%s</li>" % (_html_escape(rel),
                       _site_id_link(l["id"]), evid))
        body.append("</ul>")

    con = read_index_conn()
    inbound = con.execute("SELECT src, rel FROM links WHERE dst=?", (m["id"],)).fetchall()
    con.close()
    if inbound:
        body.append("<h2>inbound links (cited/derived-from by)</h2><ul class=\"plain\">")
        for src, rel in inbound:
            body.append("<li>%s &larr; %s</li>" % (_html_escape(rel), _site_id_link(src)))
        body.append("</ul>")

    body.append("<h2>evidence chain</h2>")
    body.append(_site_render_status_table(m))

    return _site_page(m["id"], "\n".join(body),
                     crumbs="<nav class=\"crumbs\"><a href=\"../index.html\">home</a> / "
                            "<a href=\"index.html\">artifacts</a> / %s</nav>"
                            % _html_escape(m["id"]))


def _site_collection_page(m):
    spec = collection_spec(m)
    maints = spec.get("maintainers") or []
    body = ["<div class=\"id\">%s</div><h2 style=\"border:none;margin-top:6px;\">%s</h2>"
           % (_html_escape(m["id"]), _html_escape(m.get("title", "")))]
    body.append("<p>%s</p>" % _html_escape(spec.get("scope") or "(no scope declared)"))

    superseders = superseders_map().get(m["id"], [])
    if superseders:
        body.append("<p class=\"warn\">SUPERSEDED by %s — this collection is retired.</p>"
                   % ", ".join(_site_id_link(x, "../artifacts/") for x in superseders))

    body.append("<p><strong>maintainers:</strong> %s</p>" % (", ".join(
        _html_escape("%s%s" % (x.get("agent") or "?",
                                (" <%s>" % x["addr"]) if x.get("addr") else ""))
        for x in maints if isinstance(x, dict)) or "(none)"))

    members = [x for x in (spec.get("members") or []) if isinstance(x, dict) and x.get("id")]
    declared = self_declared_members(m["id"])
    declared_ids = {x["id"] for x in declared}
    curated_ids = {x["id"] for x in members}

    # Mirrors cmd_collection_show's "curated by" check (issue #23): the fixed
    # "ENDORSED — signed" header used to print even when there is no verified
    # signed publish event for this collection, contradicting the collection's own
    # attribution. Display-only; membership and task state are unaffected.
    fp = first_publisher(m["id"])
    curated_tag = "ENDORSED — signed editorial list" if fp \
        else "UNSIGNED — editorial list, not attributable"
    body.append("<h2>curated-in (%s): %d</h2>" % (curated_tag, len(members)))
    if not members:
        body.append("<p class=\"note\">(none)</p>")
    else:
        # Same method-first ordering as `collection show` (2026-09-21): the endorsed
        # method (if any) renders first with its applied-by count, then instances.
        ab = applied_by_index()
        order = {ROLE_METHOD: 0, ROLE_INSTANCE: 1}
        body.append("<ul class=\"plain\">")
        for entry in sorted(members, key=lambda e: order.get(e.get("role") or "", 2)):
            mm = load_manifest(entry["id"], missing_ok=True)
            role = entry.get("role") or "member"
            mutual = " (also self-declared — mutual)" if entry["id"] in declared_ids else ""
            title = _html_escape(mm.get("title", "")) if mm else ""
            extra = ""
            if role == ROLE_METHOD:
                extra = " — applied by %d" % len(ab.get(entry["id"], []))
            elif mm and applies_targets(mm):
                extra = " — applies %s" % ", ".join(
                    _site_id_link(t, "../artifacts/") for t in applies_targets(mm))
            body.append("<li>%s [role %s] %s%s%s</li>"
                       % (_site_id_link(entry["id"], "../artifacts/"),
                          _html_escape(role), title, extra, mutual))
        body.append("</ul>")

    unendorsed = [x for x in declared if x["id"] not in curated_ids]
    body.append("<h2>self-declared (CLAIMED — not endorsed by maintainers): %d</h2>"
               % len(unendorsed))
    if not unendorsed:
        body.append("<p class=\"note\">(none)</p>")
    else:
        body.append("<p class=\"note\">A membership claim is free and unmoderated by "
                   "design; belonging to a collection is never evidence.</p>")
        body.append("<ul class=\"plain\">")
        for mm in unendorsed:
            body.append("<li>%s %s</li>" % (_site_id_link(mm["id"], "../artifacts/"),
                       _html_escape(mm.get("title", ""))))
        body.append("</ul>")

    openq, claimedq, otherq = collection_open_tasks(m["id"])
    body.append("<h2>open tasks: %d (%d claimed, %d settled/expired)</h2>"
               % (len(openq), len(claimedq), len(otherq)))
    if openq:
        body.append("<table><tr><th>id</th><th>priority</th><th>tier</th>"
                   "<th>objective</th></tr>")
        for tm, st in openq:
            ts = st["spec"]
            body.append("<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td></tr>"
                       % (_site_id_link(tm["id"], "../tasks/"), _html_escape(ts.get("priority", "?")),
                          _html_escape((ts.get("verification") or {}).get("tier", "?")),
                          _html_escape((ts.get("objective") or "")[:80])))
        body.append("</table>")

    if spec.get("task_criteria"):
        body.append("<h2>wanted</h2><p>%s</p>" % _html_escape(spec["task_criteria"]))
    if spec.get("open_questions"):
        body.append("<h2>open questions</h2><ul class=\"plain\">")
        for q in spec["open_questions"]:
            body.append("<li>%s</li>" % _html_escape(q))
        body.append("</ul>")

    return _site_page(m.get("title") or m["id"], "\n".join(body),
                     crumbs="<nav class=\"crumbs\"><a href=\"../index.html\">home</a> / %s"
                            "</nav>" % _html_escape(m["id"]))


def cmd_render_site(a):
    ensure_read_index()
    out_root = os.path.abspath(a.out or os.path.join(ROOT, "site", "browse"))
    art_dir = os.path.join(out_root, "artifacts")
    coll_dir = os.path.join(out_root, "collections")
    task_dir = os.path.join(out_root, "tasks")
    for d in (out_root, art_dir, coll_dir, task_dir):
        os.makedirs(d, exist_ok=True)

    manifests = list(iter_manifests())
    smap = superseders_map()

    # Per-artifact pages.
    for m in manifests:
        with open(os.path.join(art_dir, m["id"] + ".html"), "w") as f:
            f.write(_site_artifact_page(m, smap))

    # Collection pages.
    collections = [m for m in manifests if m["type"] == "collection"]
    for m in collections:
        with open(os.path.join(coll_dir, m["id"] + ".html"), "w") as f:
            f.write(_site_collection_page(m))

    # Artifact index page.
    rows_sorted = sorted(manifests, key=lambda m: (m.get("created", ""), m["id"]))
    if a.limit_search:
        rows_sorted = rows_sorted[: a.limit_search]
    art_body = ["<table><tr><th>id</th><th>type</th><th>agent</th><th>tier</th>"
               "<th>title</th></tr>"]
    for m in rows_sorted:
        flag = ""
        va = verified_agent_of(m)
        if va and va != m.get("agent"):
            flag = " <span class=\"warn\" title=\"self-asserted agent disagrees with " \
                   "the verified signed publisher\">&#9888;</span>"
        sup = smap.get(m["id"])
        supflag = " <span class=\"note\">(superseded)</span>" if sup else ""
        art_body.append("<tr><td>%s</td><td>%s</td><td>%s%s</td><td>%s</td>"
                       "<td>%s%s</td></tr>"
                       % (_site_id_link(m["id"], ""), _html_escape(m["type"]),
                          _html_escape(m.get("agent", "?")), flag, _site_tier_badge(m),
                          _html_escape(m.get("title", "")), supflag))
    art_body.append("</table>")
    with open(os.path.join(art_dir, "index.html"), "w") as f:
        f.write(_site_page("All artifacts", "\n".join(art_body),
                          crumbs="<nav class=\"crumbs\"><a href=\"../index.html\">home"
                                 "</a> / artifacts</nav>"))

    # Task index page.
    task_body = ["<table><tr><th>id</th><th>state</th><th>priority</th><th>tier</th>"
                "<th>beneficiary</th><th>objective</th></tr>"]
    for m in manifests:
        if m["type"] != "task":
            continue
        try:
            spec = task_spec(m)
            st = task_state(m)
        except (OSError, ValueError):
            continue
        ben = (spec.get("beneficiary") or {}).get("agent") or "?"
        task_body.append("<tr><td>%s</td><td>%s</td><td>%s</td><td>%s</td><td>%s</td>"
                        "<td>%s</td></tr>"
                        % (_site_id_link(m["id"], "../artifacts/"), _html_escape(st["state"]),
                           _html_escape(spec.get("priority", "?")),
                           _html_escape((spec.get("verification") or {}).get("tier", "?")),
                           _html_escape(ben), _html_escape((spec.get("objective") or "")[:80])))
    task_body.append("</table>")
    with open(os.path.join(task_dir, "index.html"), "w") as f:
        f.write(_site_page("Tasks", "\n".join(task_body),
                          crumbs="<nav class=\"crumbs\"><a href=\"../index.html\">home</a> "
                                 "/ tasks</nav>"))

    # Home page: overview + collection list.
    by_type, by_tier = {}, {}
    for m in manifests:
        by_type[m["type"]] = by_type.get(m["type"], 0) + 1
        badge = "method" if is_method(m) else tier_of(m)
        by_tier[badge] = by_tier.get(badge, 0) + 1
    home = ["<h2>this registry, right now</h2>",
           "<p class=\"note\">%d artifacts total. This reflects only what has been "
           "published or pulled to THIS host — another participant's registry is its "
           "own independent view by design (no global consensus).</p>" % len(manifests)]
    home.append("<table><tr><th>type</th><th>count</th></tr>")
    for t, c in sorted(by_type.items()):
        home.append("<tr><td><a href=\"artifacts/index.html\">%s</a></td><td>%d</td></tr>"
                   % (_html_escape(t), c))
    home.append("</table>")
    home.append("<h2>verification tiers present</h2><table><tr><th>tier</th><th>count</th>"
               "</tr>")
    for t, c in sorted(by_tier.items()):
        home.append("<tr><td>%s</td><td>%d</td></tr>" % (_html_escape(t), c))
    home.append("</table>")
    home.append("<h2>collections (%d)</h2>" % len(collections))
    if not collections:
        home.append("<p class=\"note\">(none locally)</p>")
    else:
        home.append("<ul class=\"plain\">")
        for m in sorted(collections, key=lambda m: m.get("title", "")):
            home.append("<li><a href=\"collections/%s.html\">%s</a> — %s</li>"
                       % (m["id"], _html_escape(m.get("title", m["id"])),
                          _html_escape(m["id"])))
        home.append("</ul>")
    home.append("<h2>browse</h2><ul class=\"plain\">"
               "<li><a href=\"artifacts/index.html\">all artifacts</a></li>"
               "<li><a href=\"tasks/index.html\">open task queue</a></li></ul>")
    with open(os.path.join(out_root, "index.html"), "w") as f:
        f.write(_site_page("Research Commons — local registry", "\n".join(home)))

    print("rendered %d artifact page(s), %d collection page(s) -> %s"
         % (len(manifests), len(collections), out_root))
    print("open %s/index.html in a browser" % out_root)


def cmd_migrate_store(a):
    ensure_dirs()
    moved = 0
    for name in sorted(os.listdir(STORE)):
        if not re.fullmatch(r"[0-9a-f]{64}", name): continue
        src = legacy_blob_path(name)
        if not os.path.isfile(src): continue
        dst = blob_path(name)
        print("%s -> %s" % (src, dst))
        if a.dry_run:
            moved += 1
            continue
        os.makedirs(os.path.dirname(dst), exist_ok=True)
        if os.path.exists(dst) and sha256_file(src) != sha256_file(dst):
            sys.exit("error: refusing to overwrite differing sharded blob %s" % name)
        os.replace(src, dst)
        os.chmod(dst, 0o444)
        moved += 1
    print("%s %d blob(s)" % ("would migrate" if a.dry_run else "migrated", moved))


def iter_store_blobs():
    """Yield (digest, layout, path) for blobs in either supported layout."""
    if not os.path.isdir(STORE): return
    for name in sorted(os.listdir(STORE)):
        flat = os.path.join(STORE, name)
        if re.fullmatch(r"[0-9a-f]{64}", name) and os.path.isfile(flat):
            yield name, "flat", flat
        if not re.fullmatch(r"[0-9a-f]{2}", name) or not os.path.isdir(flat):
            continue
        for digest in sorted(os.listdir(flat)):
            path = os.path.join(flat, digest)
            if (re.fullmatch(r"[0-9a-f]{64}", digest)
                    and digest.startswith(name) and os.path.isfile(path)):
                yield digest, "sharded", path


def subscription_completeness_targets(row):
    """Artifact ids whose blobs this subscription policy intends to retain."""
    policy = row.get("blobs", "manifests-only")
    if policy == "manifests-only":
        return [], subscription_status(row)
    if policy == "members":
        return subscription_member_ids(row)
    if policy == "all":
        return [m["id"] for m in iter_manifests()], "ready"
    return [], "invalid blob policy %r" % policy


def pending_subscription_supersedes(row):
    """Untrusted supersedes candidates awaiting review under the default gate.

    Member-level check (distinct from j14's collection-level supersede_decision):
    any manifest superseding a curated-in MEMBER of the subscribed collection,
    published by a key that is not a listed maintainer, is surfaced for review
    rather than silently followed.
    """
    if row.get("follow_supersedes", "maintainer-signed") != "maintainer-signed":
        return []
    spec, _status = subscription_collection_spec(row)
    if spec is None:
        return []
    member_ids = {x.get("id") for x in (spec.get("members") or [])
                  if isinstance(x, dict) and x.get("id")}
    maintainers = {(x.get("addr") or "").lower()
                   for x in (spec.get("maintainers") or [])
                   if isinstance(x, dict) and x.get("addr")}
    pending = []
    for m in iter_manifests():
        old_ids = sorted({link.get("id") for link in (m.get("links") or [])
                          if isinstance(link, dict)
                          and link.get("rel") == "supersedes"
                          and link.get("id") in member_ids})
        if not old_ids:
            continue
        fp = first_publisher(m["id"])
        publisher = fp[0].lower() if fp else None
        if publisher not in maintainers:
            reason = ("publisher %s is not a collection maintainer" % publisher
                      if publisher else "publisher is not verifiably attributable")
            pending.extend((m["id"], old_id, reason) for old_id in old_ids)
    return pending


def report_subscription_completeness():
    """Report local subscription intent versus blob presence; never mutate state."""
    print("--- subscription completeness ---")
    rows = load_subscriptions()["subscriptions"]
    if not rows:
        print("no subscriptions")
        return
    for row in sorted(rows, key=lambda r: r.get("collection", "")):
        cid = row.get("collection", "?")
        policy = row.get("blobs", "manifests-only")
        try:
            targets, status = subscription_completeness_targets(row)
        except SystemExit as e:
            targets = []
            status = "pending: collection metadata unavailable (%s)" % e
        print("subscription %s (blobs=%s)" % (cid, policy))
        pinned = queued = skipped = 0
        for aid in targets:
            m = load_manifest(aid, missing_ok=True)
            if m is None:
                queued += 1
                print("  queued %s — member manifest unavailable" % aid)
                continue
            digest = (m.get("content") or {}).get("sha256")
            if digest and os.path.exists(blob_read_path(digest)):
                pinned += 1
                print("  pinned %s" % aid)
                continue
            if m.get("type") in METHOD_TYPES:
                reasons = []
                if not row.get("executables"):
                    reasons.append("executables not enabled")
                if not publisher_is_full(aid):
                    reasons.append("publisher trust is not full")
                if reasons:
                    skipped += 1
                    print("  skipped %s — executable withheld by policy: %s"
                          % (aid, "; ".join(reasons)))
                    continue
            queued += 1
            print("  queued %s" % aid)
        try:
            pending = pending_subscription_supersedes(row)
        except SystemExit:
            pending = []
        for new_id, old_id, reason in pending:
            print("  pending-review %s supersedes %s — %s"
                  % (new_id, old_id, reason))
        if status != "ready":
            print("  status: %s" % status)
        print("  counts: pinned=%d queued=%d skipped=%d pending-review=%d"
              % (pinned, queued, skipped, len(pending)))


def cmd_fsck(a):
    ensure_dirs()
    bad = absent = orphans = 0
    referenced = set()
    for fn in sorted(os.listdir(ART)):
        if not fn.endswith(".json"): continue
        with open(os.path.join(ART, fn)) as f: m = json.load(f)
        d = m["content"]["sha256"]
        referenced.add(d)
        sharded, flat = blob_path(d), legacy_blob_path(d)
        present = [p for p in (sharded, flat) if os.path.exists(p)]
        if not present:
            # A manifest we ingested lazily is *incomplete*, not *corrupt* — conflating
            # the two would make lazy replication look like data loss.
            if m.get("ingest"):
                print("NOT REPLICATED: %s (%s) — fetch with: commons fetch %s"
                      % (m["id"], d[:12], m["id"]))
                absent += 1
            else:
                print("MISSING BLOB: %s (%s)" % (m["id"], d[:12])); bad += 1
            continue
        if len(present) == 2:
            if sha256_file(sharded) == sha256_file(flat):
                print("DUPLICATE-LAYOUT: %s (%s)" % (m["id"], d[:12]))
            else:
                print("DUPLICATE-LAYOUT CORRUPTION: %s (%s)" % (m["id"], d[:12]))
                bad += 1
        for path in present:
            if sha256_file(path) != d:
                layout = "sharded" if path == sharded else "flat"
                print("HASH MISMATCH: %s (%s, %s)" % (m["id"], d[:12], layout))
                bad += 1
    if a.orphans:
        for d, layout, path in iter_store_blobs():
            if d in referenced: continue
            print("ORPHAN: %s (%s, %s)" % (d, layout, path))
            orphans += 1
    unattributed = unsigned_only = 0
    if getattr(a, "attribution", False):
        # blob integrity says nothing about WHO published; an artifact with no
        # publish/republish event in any ledger is invisible-to-provenance (the
        # 2026-09-21 publish-before-sign residue). Repair: re-run `publish` on the same
        # file (the dedup path now backfills) or `publish --force` (emits republish).
        have = attributed_ids()
        for m in iter_manifests():
            if m["id"] in have: continue
            print("UNATTRIBUTED: %s (%s) — no publish/republish ledger event%s"
                  % (m["id"], m.get("type"),
                     "; ingested from %s" % m["ingest"].get("from") if m.get("ingest") else ""))
            unattributed += 1
        bad += unattributed
        # Attributed only by unsigned events: the artifact has a publish event, so it
        # is not UNATTRIBUTED, but no VERIFIED signed publisher exists. Authorship-based
        # features (`first_publisher`: "curated by", trust-gated materialization, the
        # origin grade) treat it as unattributed. Advisory, not a problem: unsigned
        # entries are tolerated locally. Repair: `publish --force` with a key.
        for m in iter_manifests():
            if m["id"] not in have or first_publisher(m["id"]): continue
            print("UNSIGNED-ONLY: %s (%s) — no verified signed publish event; authorship "
                  "is unprovable" % (m["id"], m.get("type")))
            unsigned_only += 1
    if a.availability:
        report_availability_exposure()
    report_subscription_completeness()
    print("fsck: %s%s" % ("OK" if bad == 0 else "%d problem(s)" % bad,
                          "; %d not replicated (manifest-only)" % absent if absent else ""))
    if a.orphans: print("orphans: %d" % orphans)
    if getattr(a, "attribution", False):
        print("unattributed: %d" % unattributed)
        print("unsigned-only (advisory): %d" % unsigned_only)
    if a.ledger:
        print("--- ledger signature audit ---")
        class _A: pass
        sub = _A(); sub.n = 0; sub.verify = True; sub.strict = a.strict; sub.agent = a.agent
        try:
            cmd_log(sub)
        except SystemExit as e:
            if e.code: bad += 1
    if bad or (orphans and a.strict_orphans): sys.exit(1)


def prime_verify_cache(entries):
    """Verify many signatures in one Node process, filling _VERIFY_CACHE.

    One subprocess per signature is what made ledger folding quadratic-feeling; a
    single batch call is the difference between ~1.4s and ~0.1s on a small registry,
    and the gap only widens as the ledger grows.
    """
    pending, payloads = [], []
    for e in entries:
        sig = e.get("sig")
        if not sig: continue
        msg = canonical(signing_payload(e))
        addr = (e.get("addr") or "")
        ck = (msg, sig, addr.lower())
        if ck in _VERIFY_CACHE: continue
        pending.append(ck)
        payloads.append(json.dumps({"message": msg, "signature": sig, "address": addr}))
    if not pending: return
    if not os.path.exists(VERIFY_BATCH_JS):
        return  # fall back to per-entry verification
    try:
        r = subprocess.run(["node", VERIFY_BATCH_JS], input="\n".join(payloads),
                           capture_output=True, text=True, timeout=300)
    except (OSError, subprocess.SubprocessError):
        return
    lines = [l for l in (r.stdout or "").splitlines() if l.strip()]
    if len(lines) != len(pending): return
    for ck, line in zip(pending, lines):
        try:
            out = json.loads(line)
        except ValueError:
            continue
        _VERIFY_CACHE[ck] = (bool(out.get("valid")), out.get("recovered"))


_LEDGER_CACHE = {"key": None, "rows": None}


def read_ledger_entries():
    """All entries across all logs, newest last by timestamp."""
    paths = ledger_files()
    key = tuple((p, os.path.getmtime(p), os.path.getsize(p))
                for p in paths if os.path.exists(p))
    if _LEDGER_CACHE["key"] == key:
        return _LEDGER_CACHE["rows"]
    out = []
    for path in ledger_files():
        for line in open(path).read().splitlines():
            if not line.strip(): continue
            try:
                out.append((json.loads(line), path))
            except ValueError:
                pass
    out.sort(key=lambda t: t[0].get("ts", ""))
    _LEDGER_CACHE["key"] = key
    _LEDGER_CACHE["rows"] = out
    prime_verify_cache([e for e, _ in out])
    return out


def cmd_log(a):
    paths = ledger_files()
    if not paths: return
    if not a.verify:
        rows = read_ledger_entries()
        for e, _ in rows[-a.n:]:
            print(json.dumps(e, sort_keys=True))
        return

    peers = load_peers()
    bad = warned = total = 0
    # Batch-verify every signature up front (one Node process instead of one per line).
    all_entries = []
    for path in paths:
        for line in open(path).read().splitlines():
            if not line.strip(): continue
            try: all_entries.append(json.loads(line))
            except ValueError: pass
    prime_verify_cache(all_entries)
    # Each log is an independent single-writer chain, verified on its own terms.
    for path in paths:
        lines = [l for l in open(path).read().splitlines() if l.strip()]
        total += len(lines)
        who = os.path.basename(path)
        prev_hash = None
        for i, line in enumerate(lines, 1):
            try:
                e = json.loads(line)
            except ValueError:
                print("%s line %d: UNPARSEABLE" % (who, i)); bad += 1
                prev_hash = hashlib.sha256(line.encode()).hexdigest(); continue
            sig, addr = e.get("sig"), e.get("addr")
            label = "%s %s %s" % (e.get("ts", "?"), e.get("action", "?"), e.get("id", "?"))

            if "prev" in e and e["prev"] != prev_hash:
                print("%s line %d: CHAIN BREAK (%s) — prev=%s expected=%s"
                      % (who, i, label, str(e["prev"])[:12], str(prev_hash)[:12]))
                bad += 1
            prev_hash = hashlib.sha256(line.encode()).hexdigest()

            if not sig:
                if a.strict:
                    print("%s line %d: UNSIGNED (%s)" % (who, i, label)); bad += 1
                else:
                    warned += 1
                continue
            ok, recovered = verify_entry(e, sig, addr)
            if not ok:
                print("%s line %d: BAD SIGNATURE (%s) — claims %s, recovered %s"
                      % (who, i, label, addr, recovered)); bad += 1
                continue
            peer = find_peer(addr, peers)
            if peer is None:
                print("%s line %d: UNKNOWN SIGNER %s (%s)" % (who, i, addr, label)); bad += 1
                continue
            valid, why = key_valid_at(peer, e.get("ts"))
            if not valid:
                print("%s line %d: KEY NOT VALID (%s) — %s: %s" % (who, i, label, addr, why))
                bad += 1

    print("log --verify: %d entries across %d log(s), %s%s"
          % (total, len(paths),
             "OK" if bad == 0 else "%d problem(s)" % bad,
             "; %d unsigned (local, tolerated)" % warned if warned else ""))
    warn_anchor_drift()
    if bad: sys.exit(1)


REPUTATION_COUNTERS = ("published", "claims", "submissions", "derivations",
                       "references", "accepted", "rejected", "verify_pass",
                       "verify_fail", "attested")

# Shaped-view constants for `peer stats --shaped`. These are an EXAMPLE policy for
# a pure view over the same fold, not a core scoring formula the protocol depends
# on — a shipped ledger schema never references them, so a human is free to tune
# or replace the curve without touching how events are recorded. The curve gives
# each additional event in a category diminishing marginal value (~10/sqrt(rank)),
# so a flooding actor pays increasing cost per unit of reported score, then a hard
# per-category cap bounds any single peer's shaped score even under unbounded n.
REPUTATION_SHAPE_RATE = 10
REPUTATION_SHAPE_CAP = 50


def shaped_count(n, rate=REPUTATION_SHAPE_RATE, cap=REPUTATION_SHAPE_CAP):
    """Diminishing-returns value for n raw events in one category, capped.

    Each event i (1-indexed) contributes ceil(rate / sqrt(i)) — front-loaded so
    an occasional contributor is not penalized, but the marginal value of the
    Nth duplicate-flavored event shrinks as N grows. Never negative, never above
    cap, and n<=0 always shapes to 0.
    """
    if n <= 0:
        return 0
    total = 0
    for i in range(1, n + 1):
        total += math.ceil(rate / math.sqrt(i))
        if total >= cap:
            return cap
    return total


def shape_reputation_stats(stats, rate=REPUTATION_SHAPE_RATE, cap=REPUTATION_SHAPE_CAP):
    """Apply shaped_count() per category to every peer's folded counters.

    Pure transform over an already-folded stats mapping — never touches the
    ledger, the fold, or raw counts. Callers that want the unshaped view keep
    using the mapping returned by fold_reputation_events() directly.
    """
    return {addr: {k: shaped_count(v, rate, cap) for k, v in counters.items()}
            for addr, counters in stats.items()}


def fold_reputation_events(events, window_bound=None):
    """Fold already-verified ledger events into per-address reputation counters.

    A window includes its exact lower bound. Missing or malformed timestamps are only
    usable for all-time reputation; they cannot prove that an event is recent.
    """
    stats = {}

    def rec(addr):
        return stats.setdefault((addr or "").lower(),
                                {k: 0 for k in REPUTATION_COUNTERS})

    for e in events:
        if window_bound is not None:
            ts = parse_ts(e.get("ts"))
            if ts is None or ts < window_bound:
                continue
        addr = (e.get("addr") or "").lower()
        act = e.get("action")
        r = rec(addr)
        if act in ("publish", "republish"): r["published"] += 1
        elif act == "claim": r["claims"] += 1
        elif act == "submit": r["submissions"] += 1
        elif act == "verify-pass": r["verify_pass"] += 1
        elif act == "verify-fail": r["verify_fail"] += 1
        elif act == "attest": r["attested"] += 1

        # cmd_peer annotates verified task events after applying the existing
        # derivation and settlement rules. Keeping the actual fold here makes window
        # behavior independently testable without weakening signature verification.
        kind = e.get("_reputation_kind")
        if kind == "reference": r["references"] += 1
        elif kind in ("origin", "commit-reveal"): r["derivations"] += 1
        if act in ("accept", "reject"):
            counter = "accepted" if act == "accept" else "rejected"
            for credited_addr in e.get("_reputation_credit", ()):
                rec(credited_addr)[counter] += 1
    return stats


def emit_reputation_stats(stats, window=None, bound_text=None, json_output=False,
                          peers=None, shaped=False):
    """Render one folded stats mapping as JSON or the established human table.

    shaped=True renders shaped_reputation_stats(stats) instead of raw counts.
    This is purely a display transform: the caller decides which mapping to
    fold in the first place, so the JSON/human code paths below never know or
    care whether the numbers in front of them are raw or shaped.
    """
    display = shape_reputation_stats(stats) if shaped else stats
    if json_output:
        # Peers live under "peers", NOT merged into the top level: addresses are
        # attacker-chosen strings, and a peer keyed "window" would otherwise shadow
        # the metadata. Namespacing costs one indirection and removes the whole class.
        payload = {"window": window, "bound": bound_text, "peers": display}
        if shaped:
            payload["shaped"] = True
        print(json.dumps(payload, sort_keys=True))
        return
    if window:
        print("peer stats (window: last %s)" % window)
    if shaped:
        print("peer stats (shaped: diminishing returns per category, capped)")
    if not display:
        print("(no signed activity yet)")
        return
    peers = peers if peers is not None else load_peers()
    print("%-44s %-12s %5s %5s %5s %5s %5s %5s"
          % ("addr", "agent", "pub", "deriv", "ref", "acc", "rej", "vfy"))
    for addr, r in sorted(display.items(),
                          key=lambda kv: (-kv[1]["derivations"], -kv[1]["published"])):
        pr = find_peer(addr, peers) or {}
        print("%-44s %-12s %5d %5d %5d %5d %5d %5d"
              % (addr, (pr.get("agent") or "unknown")[:12], r["published"],
                 r["derivations"], r["references"], r["accepted"], r["rejected"],
                 r["verify_pass"]))
    print("")
    print("deriv = independent derivations (origin or pre-publication commit-reveal)")
    print("ref   = concurring references: legitimate citations of an existing result,")
    print("        which fulfill tasks but are never counted as replication")
    print("Counts are signed ledger events. Unsigned and invalidly-signed events are")
    print("excluded entirely — reputation that counted unverifiable claims would be")
    print("worth exactly what it cost to forge.")
    if shaped:
        print("Shaped = ceil(%d/sqrt(rank)) per category, capped at %d — an example"
              % (REPUTATION_SHAPE_RATE, REPUTATION_SHAPE_CAP))
        print("policy for diminishing returns on repeated activity, not a core formula.")
        print("Use `peer stats` (no --shaped) for raw all-time or windowed counts.")



def _announce_resolution():
    """Resolve one available, valid single-author announce tip per signer."""
    signed = {}
    for event, _path in read_ledger_entries():
        aid = event.get("id") or ""
        signer = event.get("addr") or ""
        if (event.get("action") not in ("publish", "republish")
                or not aid.startswith("pa-") or not signer or not event.get("sig")):
            continue
        valid, _recovered = verify_entry(event, event["sig"], signer)
        if not valid:
            continue
        manifest = load_manifest(aid, missing_ok=True)
        digest = ((manifest or {}).get("content") or {}).get("sha256")
        if (not manifest or manifest.get("type") != "peer-announce" or not digest
                or (event.get("sha256") and event.get("sha256") != digest)):
            continue
        key = (signer.lower(), aid)
        previous = signed.get(key)
        if previous is None or event.get("ts", "") >= previous.get("ts", ""):
            signed[key] = event

    available, missing = {}, {}
    for (signer, aid), event in signed.items():
        manifest = load_manifest(aid, missing_ok=True)
        digest = manifest["content"]["sha256"]
        path = blob_read_path_at(STORE, digest)
        if not os.path.exists(path):
            missing.setdefault(signer, []).append(aid)
            continue
        try:
            if sha256_file(path) != digest or aid != "pa-" + digest[:8]:
                continue
            with open(path) as f:
                spec = json.load(f)
        except (OSError, ValueError):
            continue
        if lint_announce_spec(spec, signer):
            continue
        available.setdefault(signer, []).append({
            "id": aid, "manifest": manifest, "spec": spec, "event": event,
        })

    resolved = []
    for signer, rows in available.items():
        ids = {row["id"] for row in rows}
        superseded = set()
        for row in rows:
            for link in row["manifest"].get("links") or []:
                target = link.get("id") if isinstance(link, dict) else None
                if isinstance(link, dict) and link.get("rel") == "supersedes" and target in ids:
                    superseded.add(target)
        tips = [row for row in rows if row["id"] not in superseded] or rows
        tips.sort(key=lambda row: (row["event"].get("ts", ""), row["id"]))
        selected = dict(tips[-1])
        selected["signer"] = signer
        selected["manifest_only"] = len(missing.get(signer, []))
        resolved.append(selected)
    resolved.sort(key=lambda row: row["signer"])
    missing_ids = sorted(aid for ids in missing.values() for aid in ids)
    return resolved, missing_ids


def _configured_git_remotes():
    """Return URL -> configured remote names, without requiring ROOT to be a repo."""
    result = git("remote", "-v", check=False)
    if result.returncode != 0:
        return {}
    by_url = {}
    for line in result.stdout.splitlines():
        fields = line.split()
        if len(fields) >= 2:
            by_url.setdefault(fields[1], set()).add(fields[0])
    return {url: sorted(names) for url, names in by_url.items()}


def _suggested_remote_name(signer, occupied):
    base = "peer-" + signer.lower().removeprefix("0x")[:8]
    name, suffix = base, 2
    while name in occupied:
        name = "%s-%d" % (base, suffix)
        suffix += 1
    occupied.add(name)
    return name


def _peer_suggestion_report(show_all=False):
    peers = load_peers()
    subscriptions = load_subscriptions()
    subscribed = {}
    for row in subscriptions.get("subscriptions", []):
        subscribed.setdefault(row.get("collection"), []).append(row.get("remote", "origin"))
    configured = _configured_git_remotes()
    occupied = {name for names in configured.values() for name in names}
    rows, missing_ids = _announce_resolution()
    reports = []
    current = time.time()
    for row in rows:
        signer, spec = row["signer"], row["spec"]
        peer, revoked, expires_at, expiry_state = _announce_status(
            row, peers, current)
        if revoked and not show_all:
            continue
        actionable = expiry_state != "EXPIRED" and not revoked
        agent = ((peer or {}).get("agent") or row["event"].get("agent") or "unknown")
        trust = (peer or {}).get("trust", "none")
        commands = []
        if actionable and not peer:
            commands.append("commons peer add %s --agent-id %s --trust datasets-only" %
                            (signer, shlex.quote(str(agent))))

        remote_rows = []
        usable_names = []
        for remote in spec.get("remotes") or []:
            url = remote.get("url")
            names = configured.get(url, [])
            suggested = None
            command = None
            if names:
                usable_names.extend(names)
            else:
                suggested = _suggested_remote_name(signer, occupied)
                usable_names.append(suggested)
                if actionable:
                    command = "git remote add %s %s" % (suggested, shlex.quote(url))
                    commands.append(command)
            remote_rows.append({
                "url": url,
                "transport": remote.get("transport"),
                "note": remote.get("note"),
                "configured": bool(names),
                "remote_names": names,
                "suggested_name": suggested,
                "command": command,
            })

        collection_rows = []
        chosen_remote = usable_names[0] if usable_names else None
        for hosted in spec.get("hosts") or []:
            cid = hosted.get("collection")
            existing = sorted(set(subscribed.get(cid, [])))
            command = None
            if actionable and not existing and chosen_remote:
                command = "commons subscribe %s %s" % (cid, chosen_remote)
                commands.append(command)
            collection_rows.append({
                "collection": cid,
                "blobs": hosted.get("blobs"),
                "subscribed": bool(existing),
                "subscription_remotes": existing,
                "command": command,
            })
        reports.append({
            "signer": signer,
            "announce": row["id"],
            "registered": peer is not None,
            "agent": agent,
            "trust": trust,
            "revoked": revoked,
            "manifest_only": row["manifest_only"],
            "expiry": {"at": expires_at, "state": expiry_state},
            "remotes": remote_rows,
            "collections": collection_rows,
            "commands": commands,
        })
    return {
        "schema": "rc.peer-suggest.v1",
        "manifest_only": len(missing_ids),
        "announcers": reports,
    }


def _print_subscribe_suggestions(report, collection):
    """Print the relevant subset of the established peer-suggest human view."""
    relevant = [item for item in report["announcers"]
                if any(hosted["collection"] == collection
                       for hosted in item["collections"])]
    if not relevant:
        print("(no peer announces with available blobs for %s)" % collection)
        return
    for item in relevant:
        if item["revoked"]:
            registration = "REVOKED agent=%s trust=%s" % (item["agent"], item["trust"])
        elif item["registered"]:
            registration = "registered agent=%s trust=%s" % (item["agent"], item["trust"])
        else:
            registration = "UNREGISTERED agent=%s trust=none" % item["agent"]
        print("%s — %s" % (item["signer"], registration))
        print("  announce: %s  expiry: %s (%s)" %
              (item["announce"], item["expiry"]["state"], item["expiry"]["at"]))
        print("  remotes:")
        for remote in item["remotes"]:
            state = ("configured as " + ",".join(remote["remote_names"])) \
                    if remote["configured"] else "not configured"
            print("    [%s] %s" % (state, remote["url"]))
        print("  collections:")
        for hosted in item["collections"]:
            if hosted["collection"] != collection:
                continue
            state = ("subscribed via " + ",".join(hosted["subscription_remotes"])) \
                    if hosted["subscribed"] else "not subscribed"
            print("    [%s] %s (blobs=%s)" %
                  (state, hosted["collection"], hosted["blobs"]))
        commands = []
        for command in item["commands"]:
            if (command.startswith("commons peer add ")
                    or command.startswith("git remote add ")
                    or command.startswith("commons subscribe %s " % collection)):
                commands.append(command)
        if commands:
            print("  suggested commands:")
            for command in commands:
                print("    " + command)
        elif item["expiry"]["state"] == "EXPIRED":
            print("  no actions suggested: announce is expired")
        elif item["revoked"]:
            print("  no actions suggested: signer is revoked")
        print("")


def _resolve_subscribe_remote(collection):
    """Name an already-configured remote from one trusted live announce, or refuse."""
    report = _peer_suggestion_report(show_all=True)
    candidates = []
    for item in report["announcers"]:
        if (not item["registered"] or item["revoked"]
                or item["trust"] not in ("full", "datasets-only")
                or item["expiry"]["state"] == "EXPIRED"
                or not any(hosted["collection"] == collection
                           for hosted in item["collections"])):
            continue
        # Collapse each URL.s local aliases before deciding whether configured URLs
        # lead to distinct remote names; those remain a human decision.
        by_url = {}
        for remote in item["remotes"]:
            if remote["configured"]:
                by_url.setdefault(remote["url"], set()).update(remote["remote_names"])
        configured_urls = [(url, sorted(names)) for url, names in sorted(by_url.items())]
        if configured_urls:
            candidates.append((item, configured_urls))

    if len(candidates) == 1:
        item, configured_urls = candidates[0]
        # Collapse aliases per URL first; only distinct resulting local remote names
        # are ambiguous. This also handles one remote with separate fetch/push URLs.
        choices = sorted({names[0] for _url, names in configured_urls})
        if len(choices) == 1:
            chosen = choices[0]
            print("resolved remote %r from announce %s by %s (trust %s)" %
                  (chosen, item["announce"], item["signer"], item["trust"]))
            alias_groups = [names for _url, names in configured_urls if len(names) > 1]
            if alias_groups:
                aliases = sorted({name for names in alias_groups for name in names})
                print("  URL is configured under multiple aliases (%s); chose %r "
                      "lexicographically" % (", ".join(aliases), chosen))
            return chosen

    _print_subscribe_suggestions(report, collection)
    if not candidates:
        sys.exit("error: no trusted live announce for %s names an already-configured remote"
                 % collection)
    sys.exit("error: announce resolution for %s is ambiguous; specify a remote" % collection)


def cmd_peer_suggest(a):
    report = _peer_suggestion_report(a.all)
    if a.json:
        print(json.dumps(report, indent=2, sort_keys=True))
        return
    if not report["announcers"]:
        print("(no peer announces with available blobs)")
    for item in report["announcers"]:
        if item["revoked"]:
            registration = "REVOKED agent=%s trust=%s" % (item["agent"], item["trust"])
        elif item["registered"]:
            registration = "registered agent=%s trust=%s" % (item["agent"], item["trust"])
        else:
            registration = "UNREGISTERED agent=%s trust=none" % item["agent"]
        print("%s — %s" % (item["signer"], registration))
        print("  announce: %s  expiry: %s (%s)" %
              (item["announce"], item["expiry"]["state"], item["expiry"]["at"]))
        if item["manifest_only"]:
            print("  manifest-only: %d newer/other announce blob(s) unavailable" %
                  item["manifest_only"])
        print("  remotes:")
        for remote in item["remotes"]:
            state = ("configured as " + ",".join(remote["remote_names"])) \
                    if remote["configured"] else "not configured"
            print("    [%s] %s" % (state, remote["url"]))
        print("  collections:")
        for hosted in item["collections"]:
            state = ("subscribed via " + ",".join(hosted["subscription_remotes"])) \
                    if hosted["subscribed"] else "not subscribed"
            print("    [%s] %s (blobs=%s)" %
                  (state, hosted["collection"], hosted["blobs"]))
        if item["commands"]:
            print("  suggested commands:")
            for command in item["commands"]:
                print("    " + command)
        elif item["expiry"]["state"] == "EXPIRED":
            print("  no actions suggested: announce is expired")
        elif item["revoked"]:
            print("  no actions suggested: signer is revoked")
        print("")
    if report["manifest_only"]:
        print("manifest-only announces (blob unavailable): %d" % report["manifest_only"])


def cmd_peer(a):
    if a.peer_cmd == "suggest":
        cmd_peer_suggest(a)
        return
    d = load_peers()
    if a.peer_cmd == "list":
        if not d.get("peers"): print("(no peers registered)"); return
        print("%-44s %-14s %-14s %s" % ("addr", "agent", "trust", "note"))
        for p in sorted(d["peers"], key=lambda x: (x.get("agent") or "", x.get("addr", ""))):
            flags = []
            if p.get("revoked_at"): flags.append("revoked " + p["revoked_at"][:10])
            if p.get("valid_from"): flags.append("from " + p["valid_from"][:10])
            if p.get("rotated_from"): flags.append("rotated")
            note = p.get("note") or p.get("notes") or ""
            if flags: note = (note + "  " if note else "") + "[" + ", ".join(flags) + "]"
            print("%-44s %-14s %-14s %s" % (p.get("addr", "?"), p.get("agent", "?"),
                                            p.get("trust", "none"), note))
        return

    if a.peer_cmd == "add":
        if not a.addr.startswith("0x") or len(a.addr) != 42:
            sys.exit("error: addr must be a 0x-prefixed 20-byte address")
        if a.trust not in TRUST_LEVELS:
            sys.exit("error: --trust must be one of: " + " ".join(TRUST_LEVELS))
        existing = find_peer(a.addr, d)
        if existing and not a.force:
            sys.exit("error: %s already registered (agent=%s trust=%s); use --force to update"
                     % (a.addr, existing.get("agent"), existing.get("trust")))
        entry = existing if existing else {"addr": a.addr}
        entry.update({"agent": a.agent_id or entry.get("agent") or "unknown",
                      "trust": a.trust,
                      "added": entry.get("added") or now()})
        if a.note: entry["note"] = a.note
        if a.valid_from: entry["valid_from"] = a.valid_from
        if a.rotated_from: entry["rotated_from"] = a.rotated_from
        if not existing: d.setdefault("peers", []).append(entry)
        save_peers(d)
        print("%s %s (agent=%s trust=%s)" % ("updated" if existing else "added",
                                             a.addr, entry["agent"], entry["trust"]))
        return

    if a.peer_cmd == "revoke":
        p = find_peer(a.addr, d)
        if not p: sys.exit("error: %s is not registered" % a.addr)
        p["revoked_at"] = a.at or now()
        save_peers(d)
        print("revoked %s at %s (history before this stays verifiable)"
              % (a.addr, p["revoked_at"]))
        return

    if a.peer_cmd == "rm":
        n = len(d.get("peers", []))
        d["peers"] = [p for p in d.get("peers", [])
                      if (p.get("addr") or "").lower() != a.addr.lower()]
        if len(d["peers"]) == n: sys.exit("error: %s is not registered" % a.addr)
        save_peers(d)
        print("removed %s" % a.addr)
        print("note: prefer `peer revoke` — removal makes that peer's past entries "
              "unverifiable rather than historically valid")
        return

    if a.peer_cmd == "stats":
        # Reputation counts SIGNED LEDGER EVENTS, never artifacts. Content-addressing
        # means one artifact can be referenced by many peers and many tasks; crediting
        # artifacts would pay copiers for other people's derivations.
        window = a.window.strip().lower() if a.window else None
        window_bound = int(time.time()) - parse_duration(window) if window else None
        verified, verified_by_id = [], {}
        for e, _ in read_ledger_entries():
            if not e.get("sig"): continue
            ok, _r = verify_entry(e, e["sig"], e.get("addr"))
            if not ok: continue
            # Announcements are routing metadata, not research contributions.
            # Their signed publish events remain auditable in the ledger but do not
            # create a peer-stats row or increment publication reputation.
            if e.get("action") in ("publish", "republish"):
                event_id = e.get("id") or ""
                manifest = load_manifest(event_id, missing_ok=True)
                if event_id.startswith("pa-") or (manifest and
                                                  manifest.get("type") == "peer-announce"):
                    continue
            copied = dict(e)
            verified.append(copied)
            verified_by_id[id(e)] = copied

        # Classify each submission by derivation evidence, and credit acceptance to the
        # submitters of the accepted result rather than to whoever settled it.
        for fn in sorted(os.listdir(ART)):
            if not fn.endswith(".json"): continue
            with open(os.path.join(ART, fn)) as f: m = json.load(f)
            if m.get("type") != "task": continue
            stt = task_state(m)
            an = settle_analysis(stt)
            for _key, g in an["ranked"]:
                for addr, (kind, _why) in (g.get("evidence") or {}).items():
                    # settle_analysis collapses duplicate submissions by signer/result,
                    # so annotate one matching verified submit event, as all-time stats
                    # did before the fold was extracted.
                    for sb in stt["submissions"]:
                        if (sb.get("addr") or "").lower() != addr: continue
                        ev = sb.get("event") or {}
                        target = verified_by_id.get(id(ev))
                        if target is None: continue
                        if sb.get("result") in g.get("ids", ()):
                            target["_reputation_kind"] = kind
                            break
            if stt["settled"]:
                act, ev = stt["settled"]
                accepted_result = ev.get("result")
                target = verified_by_id.get(id(ev))
                if target is not None:
                    target["_reputation_credit"] = [
                        sb.get("addr") for sb in stt["submissions"]
                        if accepted_result and sb.get("result") == accepted_result]

        stats = fold_reputation_events(verified, window_bound)
        if a.addr_filter:
            stats = {k: v for k, v in stats.items()
                     if k == a.addr_filter.lower()}
            if not stats: sys.exit("error: no signed activity for %s" % a.addr_filter)
        bound_text = (time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(window_bound))
                      if window_bound is not None else None)
        emit_reputation_stats(stats, window, bound_text, a.json,
                              shaped=getattr(a, "shaped", False))
        return

    if a.peer_cmd == "whoami":
        if not signing_key_path():
            print("COMMONS_SIGNING_KEY is not set — entries will be written unsigned")
            sys.exit(1)
        addr, sig = sign_entry({"action": "whoami", "agent": a.agent, "id": "-",
                               "sha256": "-", "ts": now()})
        print(addr)
        p = find_peer(addr)
        if p: print("registered as agent=%s trust=%s" % (p.get("agent"), p.get("trust")))
        else: print("not in the local peer registry (add with: commons peer add %s …)" % addr)
        return


def cmd_tiers(a):
    print("%-11s %-11s %s" % ("tier", "name", "guarantee"))
    for t in TIERS:
        print("%-11s %-11s %s" % (t, "" if TIER_NAME[t] == t else TIER_NAME[t], TIER_GUARANTEE[t]))
    print("\nverify exit codes: 0 PASS · 1 FAIL · %d NOT-MACHINE-VERIFIABLE (T2/T3) · "
          "%d UNVERIFIED · %d ENV-MISMATCH"
          % (EX_NOT_MACHINE_VERIFIABLE, EX_UNVERIFIED, EX_ENV_MISMATCH))
    print("\nT0/T1 claims are relative to an execution environment, recorded at creation in")
    print("provenance.run.exec. Verifying in a different one yields ENV-MISMATCH (exit %d),"
          % EX_ENV_MISMATCH)
    print("not FAIL: it is an unanswerable question, not a negative answer. `commons")
    print("rebaseline <id>` converges an artifact onto the pinned userland.")
    print("chain grade (`commons status`) = weakest tier among evidence nodes; "
          "%s artifacts are methods (pinned by hash) and carry no tier."
          % "/".join(sorted(METHOD_TYPES)))
    print("\ndataset availability (--obtainability) is reported beside the grade, never "
          "inside it:")
    for o in OBTAINABILITY:
        print("  %-20s %s" % (o, OBTAINABILITY_MEANING[o]))
    print("  %-20s %s" % ("(undeclared)", "publisher did not say; NOT assumed open"))
    print("Availability changes WHO CAN CHECK a result, not WHAT WAS CHECKED, so it "
          "never moves")
    print("a tier or an exit code — the same reason methods carry no tier.")


def _version_string():
    # Format is part of the public contract (tests + docs/RELEASING.md assert it verbatim):
    # "commons <VERSION> (schema <SCHEMA>)". Deliberately no git SHA in this string: a SHA
    # suffix would make it vary by checkout state, breaking exact-match tests and any script
    # that greps for this line. `git rev-parse --short HEAD` (cwd=CODE_ROOT) is still the way
    # to get the SHA separately for anyone who needs it; --version stays deterministic given
    # VERSION alone.
    return "commons %s (schema %s)" % (VERSION, SCHEMA)


def cmd_version(a):
    print(_version_string())


def main():
    p = argparse.ArgumentParser(prog="commons", description=__doc__,
                                formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--version", action="version", version=_version_string())
    p.add_argument("--agent", default=os.environ.get("COMMONS_AGENT", "unknown"),
                   help="contributing agent id (or env COMMONS_AGENT)")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("version", help="print the tool version and schema, then exit")
    s.set_defaults(fn=cmd_version)

    s = sub.add_parser("publish", help="publish a file as an artifact")
    s.add_argument("type"); s.add_argument("file"); s.add_argument("title")
    s.add_argument("-d", "--description"); s.add_argument("-t", "--tag", action="append")
    s.add_argument("--input", action="append", help="provenance input artifact id")
    s.add_argument("--workflow", help="provenance workflow artifact id")
    s.add_argument("--link", action="append",
                   help="rel:artifact-id. Evidence rels (walked by status): cites|supports|"
                        "refutes|derives|based-on. Non-evidence rels (never move a grade): "
                        "supersedes, part-of:cl-… (collection membership), applies:sk-… "
                        "(\"I followed this method\")")
    s.add_argument("--method", metavar="SK-ID",
                   help="tasks only: copy the method skill's rubric into "
                        "verification.criteria_list and record `method` on the spec")
    s.add_argument("--tier", choices=list(TIERS),
                   help="verification tier (default: T0 with --workflow, T3 for datasets, "
                        "none for workflow/skill methods, else unverified)")
    s.add_argument("--criteria", help="comparator sk-id (T1) or rubric/attestation text (T2/T3)")
    s.add_argument("--param", action="append", help="comparator parameter KEY=VALUE (e.g. EPSILON=1e-6)")
    s.add_argument("--judgement", action="append", metavar="ID=VERDICT",
                   help="T2 results: per-criterion verdict (pass|fail|NA) against the task's "
                        "enumerated rubric; repeatable. Settlement compares these vectors, "
                        "not the prose bytes.")
    s.add_argument("--license", metavar="ID",
                   help="SPDX id, one of %s, or LicenseRef-<name> "
                        "(datasets: required before push)" % "/".join(NON_OPEN_LICENSES))
    s.add_argument("--obtainability", choices=list(OBTAINABILITY),
                   help="datasets: can an independent peer acquire the same bytes? "
                        "(required before push; undeclared is not assumed open)")
    s.add_argument("--source", metavar="DESC",
                   help="how a peer acquires it — required with "
                        "--obtainability licensed-obtainable")
    s.add_argument("--allow-unchecked-ingest", action="store_true",
                   help="publish into a part-of collection whose ingest policy cannot be "
                        "read here (recorded in the ledger). Does NOT override a policy "
                        "hit — for that, publish different bytes")
    s.add_argument("--allow-secrets", action="store_true",
                   help="publish despite blocking secret-lint findings (deliberate false positives)")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_publish)

    s = sub.add_parser("announce", help="publish signed reachability and hosting hints")
    s.add_argument("--remote-url", action="append", metavar="U",
                   help="plausible git URL (repeatable; at least one required)")
    s.add_argument("--hosts", action="append", metavar="CL-ID[:POLICY]",
                   help="hosted collection and optional manifests-only|members|all policy")
    s.add_argument("--hosts-from-local", action="store_true",
                   help="also declare collections this signer published locally")
    s.add_argument("--expires-in", default="90d", metavar="DUR")
    s.add_argument("--note")
    s.set_defaults(fn=cmd_announce)

    for name, fn, hlp in (("get", cmd_get, "print manifest"), ("cat", cmd_cat, "print content blob"),
                          ("links", cmd_links, "show link graph edges")):
        s = sub.add_parser(name, help=hlp); s.add_argument("id"); s.set_defaults(fn=fn)

    s = sub.add_parser("export", help="copy content blob to a file")
    s.add_argument("id"); s.add_argument("-o", "--out"); s.set_defaults(fn=cmd_export)

    s = sub.add_parser("search", help="full-text search")
    s.add_argument("query", nargs="+"); s.add_argument("--type")
    s.add_argument("--by", dest="by", help="filter by contributing agent")
    s.add_argument("--tier", choices=list(TIERS))
    s.add_argument("--exact", action="store_true")
    s.add_argument("--tips-only", dest="tips_only", action="store_true",
                   help="hide rows a locally-held artifact supersedes (opt-in; default output unchanged)")
    s.set_defaults(fn=cmd_search)

    s = sub.add_parser("list", help="list artifacts")
    s.add_argument("--type"); s.add_argument("--by", dest="by", help="filter by contributing agent")
    s.add_argument("--tier", choices=list(TIERS))
    s.add_argument("--limit", type=int, help="maximum number of artifacts to return")
    s.add_argument("--after", help="resume after this artifact id")
    s.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    s.add_argument("--tips-only", dest="tips_only", action="store_true",
                   help="hide rows a locally-held artifact supersedes (opt-in; default output unchanged)")
    s.add_argument("--category", metavar="SLUG", nargs="?", const="",
                   help="list method skills (tag methodology) for a category slug; bare "
                        "--category lists every method")
    s.set_defaults(fn=cmd_list)

    s = sub.add_parser("rubric", help="print a method skill's pinned rubric as task-ready JSON")
    s.add_argument("id", help="sk-… method (or a tk-… that copied one)")
    s.set_defaults(fn=cmd_rubric)

    s = sub.add_parser("run", help="execute a workflow")
    s.add_argument("id"); s.add_argument("--publish", action="store_true")
    s.add_argument("--publish-type", default="dataset", choices=sorted(TYPES))
    s.add_argument("--title"); s.add_argument("-o", "--out")
    s.add_argument("--exec", dest="exec", choices=list(EXEC_MODES),
                   help="execution mode (default: env COMMONS_EXEC, else native)")
    s.set_defaults(fn=cmd_run)

    s = sub.add_parser("verify", help="verify an artifact according to its tier")
    s.add_argument("id")
    s.add_argument("--exec", dest="exec", choices=list(EXEC_MODES),
                   help="execution mode (default: env COMMONS_EXEC, else native)")
    s.set_defaults(fn=cmd_verify)

    s = sub.add_parser("rebaseline", help="re-run under the pinned sandbox userland and converge")
    s.add_argument("id")
    s.add_argument("--publish-superseding", action="store_true",
                   help="if bytes differ deterministically, publish the sandbox result as superseding")
    s.add_argument("--force", action="store_true", help="re-run even if already sandbox-baselined")
    s.set_defaults(fn=cmd_rebaseline)

    s = sub.add_parser("push", help="gate then git push (fsck, licensing, signatures)")
    s.add_argument("remote", nargs="?")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--allow-unlicensed", action="store_true",
                   help="push despite unlicensed datasets (state terms instead, if you can)")
    s.add_argument("--allow-undisclosed", action="store_true",
                   help="push despite datasets with undeclared obtainability "
                        "(declare it instead, if you can)")
    s.set_defaults(fn=cmd_push)

    s = sub.add_parser("pull", help="validate incoming artifacts, then merge (ingest gate)")
    s.add_argument("remote", nargs="?")
    s.add_argument("--dry-run", action="store_true", help="validate only, never merge")
    s.add_argument("--force", action="store_true",
                   help="merge even though some artifacts were rejected (they stay quarantined)")
    s.add_argument("--branch", help="remote branch to ingest (default: the current branch name)")
    s.add_argument("--allow-code", action="store_true",
                   help="also merge changes outside registry/ and store/ (review them first)")
    s.set_defaults(fn=cmd_pull)

    s = sub.add_parser("hub", help="create or check a data-only hub repo")
    hsub = s.add_subparsers(dest="hub_cmd", required=True)
    q = hsub.add_parser("init", help="create a new hub (data-only git repo) at DIR")
    q.add_argument("dir")
    q.add_argument("--name", help="hub display name (default: directory name)")
    q.add_argument("--tool-repo", default=None,
                   help="OWNER/REPO of the research-commons tool, for the hub README + CI "
                        "(default: derived from this checkout's origin remote)")
    q.add_argument("--tool-ref", default="main", help="tool git ref CI checks against")
    q = hsub.add_parser("check", help="CI/lead gate: data-only changes, blobs, signatures")
    q.add_argument("--base", help="git ref to diff against (e.g. origin/main); "
                                  "omit to skip the path check")
    q = hsub.add_parser("where", help="print the data root in use and how it was chosen")
    s.set_defaults(fn=cmd_hub)

    s = sub.add_parser("fetch", help="materialize a blob held only as a manifest")
    s.add_argument("id"); s.add_argument("remote", nargs="?")
    s.set_defaults(fn=cmd_fetch)

    s = sub.add_parser("subscribe", help="record local sync intent for a collection")
    s.add_argument("collection", metavar="cl-id")
    s.add_argument("remote", nargs="?",
                   help="git remote name (not a URL); omit to resolve from trusted announces")
    s.add_argument("--blobs", choices=SUBSCRIPTION_BLOBS, default="manifests-only")
    s.add_argument("--executables", action="store_true",
                   help="record intent to materialize trusted executable members")
    s.add_argument("--include-self-declared", action="store_true",
                   help="also fetch unendorsed part-of claimants under members policy")
    s.add_argument("--follow-supersedes", choices=SUBSCRIPTION_FOLLOW,
                   default="maintainer-signed")
    s.set_defaults(fn=cmd_subscribe)

    s = sub.add_parser("unsubscribe", help="remove local sync intent for a collection")
    s.add_argument("collection", metavar="cl-id")
    s.set_defaults(fn=cmd_unsubscribe)

    s = sub.add_parser("subscriptions", help="list local collection subscriptions and status")
    s.set_defaults(fn=cmd_subscriptions)

    s = sub.add_parser("sync", help="pull subscriptions and apply blob-fetch policy")
    s.add_argument("--subscription", metavar="cl-id",
                   help="sync only this subscribed collection")
    s.set_defaults(fn=cmd_sync)


    s = sub.add_parser("anchor", help="time-anchor ledger heads (Merkle root -> OpenTimestamps)")
    s.add_argument("--local-only", action="store_true",
                   help="record the checkpoint without attempting an OTS stamp")
    s.set_defaults(fn=cmd_anchor)

    s = sub.add_parser("anchor-verify", help="re-derive recorded roots and check OTS proofs")
    s.set_defaults(fn=cmd_anchor_verify)

    s = sub.add_parser("anchor-upgrade", help="promote pending OTS proofs once confirmed")
    s.set_defaults(fn=cmd_anchor_upgrade)

    s = sub.add_parser("claim", help="claim an open task (signed, TTL-bounded)")
    s.add_argument("id"); s.add_argument("--ttl", help="claim lifetime, e.g. 24h (default 24h)")
    s.set_defaults(fn=cmd_claim)

    s = sub.add_parser("heartbeat", help="record liveness evidence on an active claim (does NOT extend its TTL)")
    s.add_argument("id"); s.set_defaults(fn=cmd_heartbeat)

    s = sub.add_parser("release", help="give up a claim early, freeing the slot now")
    s.add_argument("id"); s.add_argument("--reason"); s.set_defaults(fn=cmd_release)

    s = sub.add_parser("run-task", help="execute a task's workflow (foreign tasks always sandboxed)")
    s.add_argument("id")
    s.add_argument("--publish-type", default="synthesis", choices=sorted(TYPES))
    s.add_argument("--title")
    s.add_argument("--exec", dest="exec", choices=list(EXEC_MODES),
                   help="only honoured for your OWN tasks; foreign specs are always sandboxed")
    s.set_defaults(fn=cmd_run_task)

    s = sub.add_parser("submit", help="submit a published result for a claimed task")
    s.add_argument("id"); s.add_argument("result")
    s.add_argument("--force", action="store_true", help="submit without an active claim / past expiry")
    s.add_argument("--salt", help="reveal the salt from a prior commit-derivation")
    s.set_defaults(fn=cmd_submit)

    s = sub.add_parser("commit-derivation",
                       help="pre-commit to a derived result (proves independence later)")
    s.add_argument("id")
    s.add_argument("--file", help="the result file you derived")
    s.add_argument("--result-hash", dest="result_hash", help="sha256 of the result content")
    s.add_argument("--salt", help="use a specific salt (default: random)")
    s.set_defaults(fn=cmd_commit_derivation)

    s = sub.add_parser("accept", help="accept a submission (beneficiary only)")
    s.add_argument("id"); s.add_argument("result", nargs="?")
    s.add_argument("--reason"); s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_accept)

    s = sub.add_parser("reject", help="reject a submission (beneficiary only; reason required)")
    s.add_argument("id"); s.add_argument("result", nargs="?")
    s.add_argument("--reason"); s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_reject)

    s = sub.add_parser("settle", help="auto-accept a T0/T1 result replicated by k distinct signers")
    s.add_argument("id")
    s.add_argument("--dry-run", action="store_true")
    s.add_argument("--force", action="store_true")
    s.set_defaults(fn=cmd_settle)

    s = sub.add_parser("queue", help="list tasks by priority, joined with lifecycle state")
    s.add_argument("--peer", help="filter by beneficiary agent id or address")
    s.add_argument("--collection", help="filter by collection id")
    s.add_argument("--open", action="store_true"); s.add_argument("--claimed", action="store_true")
    s.add_argument("--all", action="store_true", help="include settled and expired tasks")
    s.add_argument("--json", action="store_true",
                   help="machine-readable rows (for bridges; column parsing is a bug farm)")
    s.add_argument("--tips-only", dest="tips_only", action="store_true",
                   help="hide tasks a locally-held task supersedes (opt-in; default output "
                        "unchanged). Same read-only disambiguation as list/search.")
    s.set_defaults(fn=cmd_queue)

    s = sub.add_parser("collection",
                       help="show a collection (endorsed + self-declared members), or "
                            "add-member to endorse an artifact")
    s.add_argument("coll_cmd", choices=["show", "add-member"], metavar="show|add-member")
    s.add_argument("id", metavar="cl-id")
    s.add_argument("member", nargs="?", metavar="artifact-id",
                   help="add-member: the artifact to endorse")
    s.add_argument("--role", help="add-member: role label (e.g. primary-dataset, method, "
                                  "instance); on an existing member, changes its role")
    s.add_argument("--force", action="store_true",
                   help="add-member: publish even if you are not a listed maintainer (a fork)")
    # A named hatch, not a second meaning for --force. The two refusals have different
    # costs: publishing as a non-maintainer produces a fork nobody follows, which is
    # visible and recoverable, while building on a retired base silently drops
    # endorsements. `--allow-secrets` / `--allow-undisclosed` / `--allow-unlicensed` are
    # the precedent — each specific danger gets its own opt-in, so forcing past one never
    # forces past another. This matters now that the planned member-schema gate
    # also wants --force.
    s.add_argument("--allow-retired-base", action="store_true",
                   help="add-member: build on a superseded collection anyway (deliberate "
                        "fork; drops endorsements made in the successor)")
    s.set_defaults(fn=cmd_collection)

    s = sub.add_parser("attest", help="sign a T3 artifact as its attesting observer")
    s.add_argument("id")
    s.add_argument("--criteria", help="describe the capture (updates verification.criteria)")
    s.add_argument("--observed", help="RFC 3339 instant of the observation, Z or "
                                      "offset form; normalised to UTC (default: now)")
    s.add_argument("--force", action="store_true", help="replace an existing attestation")
    s.set_defaults(fn=cmd_attest)

    s = sub.add_parser("run-skill", help="execute a published skill (always sandboxed)")
    s.add_argument("id"); s.add_argument("args", nargs="*")
    s.add_argument("--file", action="append", help="host file to stage into the sandbox workdir")
    s.add_argument("--image", help="override image (must be on the exec-policy allowlist)")
    s.add_argument("--timeout", type=int, default=600)
    s.set_defaults(fn=cmd_run_skill)

    s = sub.add_parser("status", help="evidence-chain rollup + chain grade (weakest tier)")
    s.add_argument("id")
    s.add_argument("--brief", action="store_true", help="print a one-line chain summary")
    s.add_argument("--depth", type=chain_depth, default=MAX_CHAIN_DEPTH,
                   help="maximum edge depth to walk (default: %(default)s)")
    s.set_defaults(fn=cmd_status)

    s = sub.add_parser("graph", help="render a provenance/citation tree")
    s.add_argument("id")
    s.add_argument("--depth", type=chain_depth, default=MAX_CHAIN_DEPTH,
                   help="maximum edge depth to walk (default: %(default)s)")
    s.add_argument("--rel", choices=("evidence", "all"), default="evidence",
                   help="edge relations to include (default: %(default)s)")
    s.set_defaults(fn=cmd_graph)

    for name, fn, hlp in (("reindex", cmd_reindex, "rebuild search index from manifests"),
                          ("tiers", cmd_tiers, "explain the verification tiers")):
        s = sub.add_parser(name, help=hlp); s.set_defaults(fn=fn)

    s = sub.add_parser("render-site",
                       help="generate a static read-only HTML browser over THIS local "
                            "registry (no write path, regenerate on demand)")
    s.add_argument("--out", help="output directory (default: <root>/site/browse)")
    s.add_argument("--limit-search", type=int, dest="limit_search",
                   help="cap rows on the all-artifacts index page (debug/perf only)")
    s.set_defaults(fn=cmd_render_site)

    s = sub.add_parser("fsck", help="verify blob hashes vs manifests")
    s.add_argument("--ledger", action="store_true", help="also audit ledger signatures")
    s.add_argument("--strict", action="store_true", help="unsigned ledger entries are problems")
    s.add_argument("--orphans", action="store_true", help="report unreferenced blobs")
    s.add_argument("--attribution", action="store_true",
                   help="report artifacts with no publish/republish ledger event "
                        "(counted as problems)")
    s.add_argument("--strict-orphans", action="store_true",
                   help="exit 1 for orphan blobs (implies --orphans)")
    s.add_argument("--availability", action="store_true",
                   help="census datasets by obtainability + preview the push "
                        "disclosure gate (advisory; never changes the exit code)")
    s.set_defaults(fn=cmd_fsck)

    s = sub.add_parser("migrate-store", help="move legacy flat blobs into shards")
    s.add_argument("--dry-run", action="store_true", help="list moves without changing the store")
    s.set_defaults(fn=cmd_migrate_store)

    s = sub.add_parser("log", help="show recent ledger entries")
    s.add_argument("-n", type=int, default=20)
    s.add_argument("--verify", action="store_true",
                   help="audit every signature + hash chain against the peer registry")
    s.add_argument("--strict", action="store_true",
                   help="treat unsigned entries as problems (default: tolerated locally)")
    s.set_defaults(fn=cmd_log)

    s = sub.add_parser("peer", help="manage the peer registry (signer identities + trust)")
    psub = s.add_subparsers(dest="peer_cmd", required=True)
    q = psub.add_parser("list", help="list registered peers")
    q = psub.add_parser("suggest", help="surface peer announce hints; never act on them")
    q.add_argument("--json", action="store_true", help="emit stable machine-readable JSON")
    q.add_argument("--all", action="store_true", help="include revoked signers")
    q = psub.add_parser("add", help="register or update a signer")
    q.add_argument("addr"); q.add_argument("--agent-id", dest="agent_id")
    q.add_argument("--trust", default="datasets-only", choices=list(TRUST_LEVELS))
    q.add_argument("--note"); q.add_argument("--valid-from", dest="valid_from")
    q.add_argument("--rotated-from", dest="rotated_from",
                   help="previous address this key replaces (rotation chain)")
    q.add_argument("--force", action="store_true")
    q = psub.add_parser("revoke", help="mark a key revoked from a timestamp onward")
    q.add_argument("addr"); q.add_argument("--at", help="ISO timestamp (default: now)")
    q = psub.add_parser("rm", help="remove a peer entirely (prefer revoke)")
    q.add_argument("addr")
    q = psub.add_parser("stats", help="per-peer contribution counts from signed events")
    q.add_argument("addr_filter", nargs="?", metavar="ADDR", help="limit to one address")
    q.add_argument("--window", metavar="DURATION",
                   help="count only events at or after now-DURATION (for example 30d)")
    q.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    q.add_argument("--shaped", action="store_true",
                   help="diminishing-returns view per category (example policy, "
                        "not a core formula); default output is unchanged without this flag")
    q = psub.add_parser("whoami", help="show this host's signing address")
    s.set_defaults(fn=cmd_peer)

    a = p.parse_args()
    # Tool/data split: a tool checkout with no registry of its own is not a place to
    # read or write artifacts. Say where data should live instead of silently
    # creating registry/ inside the code repo.
    if a.cmd not in ("hub", "version") and ROOT_SOURCE == "code" and not os.path.isdir(ART):
        sys.exit("error: no hub here. This is the research-commons TOOL checkout (%s),\n"
                 "       which holds code only. Run commons from inside a hub clone, set\n"
                 "       COMMONS_ROOT=/path/to/hub, or create one: commons hub init <dir>\n"
                 "       (see docs/COLLABORATING.md)." % CODE_ROOT)
    if getattr(a, "strict_orphans", False): a.orphans = True
    a.fn(a)


if __name__ == "__main__":
    main()
