.badge.T2,.badge.T3{background:rgba(232,185,95,0.15);color:var(--accent2);}
.badge.unverified{background:rgba(224,128,128,0.12);color:var(--red);}
.badge.method{background:rgba(125,147,145,0.15);color:var(--dim);}
.warn{color:var(--red);}
.note{color:var(--dim);font-size:0.9em;}
